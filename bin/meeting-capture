#!/usr/bin/env swift

// meeting-capture — continuously extract live captions and meeting chat from
// macOS conferencing apps via the Accessibility (AX) API.
//
// Apps keep only a handful of live caption entries on screen at a time, so this
// polls the accessibility tree and finalizes each utterance as it scrolls away.
//
//   meeting-capture              follow the running daemon, or capture if none
//   meeting-capture --once       capture the current meeting only, Ctrl-C to stop
//
// Output (default ~/.local/share/meeting-capture), created on first captured
// line so meetings without captions leave no empty files behind:
//   YYYYMMDD_HHMMSS-<meeting-slug>.jsonl   structured events
//   YYYYMMDD_HHMMSS-<meeting-slug>.txt     readable transcript
//
// Requires Accessibility permission for whatever runs this (terminal, or the
// compiled binary when run from launchd).

import ApplicationServices
import AppKit
import CoreGraphics
import Foundation

// MARK: - Options

struct Options {
    var intervalMs: UInt32 = 250
    var idleIntervalMs: UInt32 = 2000
    var directory: String = {
        let base = ProcessInfo.processInfo.environment["XDG_DATA_HOME"]
            ?? NSHomeDirectory() + "/.local/share"
        return base + "/meeting-capture"
    }()
    var captureCaptions = true
    var captureChat = true
    var includeChatBacklog = false
    var autoCaptions = false
    /// Teams only: move the captions panel into its own window at the start of
    /// a meeting, so a covered meeting window cannot stop the transcript.
    var popOutCaptions = false
    /// Open the meeting chat, which records nothing while its panel is shut.
    /// In Teams the panel is also given a window of its own, so that a covered
    /// meeting window cannot freeze it.
    var popOutChat = false
    /// Teams only: record who was in the meeting, once, a minute after joining.
    var peopleSnapshot = false
    var once = false
    var follow = false
    var jsonToStdout = false
    var quiet = false
    var pid: pid_t?
    var app: String?
    /// A positional first argument selects a one-shot subcommand instead of
    /// the daemon's watch loop ("people-snapshot").
    var subcommand: String?
    var stateDirectory: String = {
        let base = ProcessInfo.processInfo.environment["XDG_STATE_HOME"]
            ?? NSHomeDirectory() + "/.local/state"
        return base + "/meeting-capture"
    }()
}

func usage() -> String {
    """
    usage: meeting-capture [options]

    With no options: record every meeting, one transcript each, forever. If
    another meeting-capture (e.g. the launchd agent) already holds the lock,
    follow its transcript instead of fighting it for the same meeting.

      --once               capture only the meeting happening now, then stop
      --follow             just watch whatever the daemon is recording, never
                           record (--watch does the same)
      --app <name>         only watch one app (\(supportedApps.map(\.id).joined(separator: ", ")))
      --auto-captions      turn live captions on when a meeting starts
      --popout-captions    Teams: put captions in their own window, which
                           keeps running even when every Teams window is
                           covered
      --popout-chat        open the meeting chat so it is recorded without
                           anyone opening the panel by hand; in Teams it also
                           gets a window of its own
      --people-snapshot    Teams: record who is in the meeting, once, about a
                           minute in (waits for a lull; never interrupts)
      --interval <ms>      poll interval while in a meeting (default 250)
      --idle-interval <ms> poll interval while waiting for one (default 2000)
      --dir <path>         output directory (default $XDG_DATA_HOME/meeting-capture)
      --no-captions        skip live captions
      --no-chat            skip meeting chat
      --chat-backlog       also record chat already on screen when joining
      --json               print JSONL to stdout instead of pretty lines
      --quiet              no stdout output
      --pid <pid>          app pid (default: autodetect, refreshed as needed)

    people-snapshot      Teams only: open the People panel, expand the list,
                         and print everyone in the meeting, confirmed against
                         the panel's own head count. --json for machine output.

      -h, --help           this help

    Files are only created once there is something to write. Ctrl-C flushes
    any in-flight captions.
    """
}

func fail(_ message: String) -> Never {
    FileHandle.standardError.write(Data("meeting-capture: \(message)\n".utf8))
    exit(1)
}

func parseOptions() -> Options {
    var options = Options()
    var args = Array(CommandLine.arguments.dropFirst())
    // A positional first argument is a subcommand, not a flag.
    if let first = args.first, first == "people-snapshot" {
        options.subcommand = first
        args.removeFirst()
    }
    func next(_ flag: String) -> String {
        guard !args.isEmpty else { fail("missing value for \(flag)") }
        return args.removeFirst()
    }
    while !args.isEmpty {
        let flag = args.removeFirst()
        switch flag {
        case "--watch": options.follow = true // reads as the passive verb; treat it as one
        case "--once": options.once = true
        case "--follow": options.follow = true
        case "--auto-captions": options.autoCaptions = true
        case "--popout-captions": options.popOutCaptions = true
        case "--popout-chat": options.popOutChat = true
        case "--people-snapshot": options.peopleSnapshot = true
        case "--interval": options.intervalMs = UInt32(next(flag)) ?? options.intervalMs
        case "--idle-interval": options.idleIntervalMs = UInt32(next(flag)) ?? options.idleIntervalMs
        case "--dir": options.directory = (next(flag) as NSString).expandingTildeInPath
        case "--no-captions": options.captureCaptions = false
        case "--no-chat": options.captureChat = false
        case "--chat-backlog": options.includeChatBacklog = true
        case "--json": options.jsonToStdout = true
        case "--quiet": options.quiet = true
        case "--pid": options.pid = pid_t(next(flag))
        case "--app": options.app = next(flag).lowercased()
        case "-h", "--help": print(usage()); exit(0)
        default: fail("unknown option: \(flag)\n\n\(usage())")
        }
    }
    return options
}

func status(_ message: String) {
    let stamp = Recorder.isoFormatter.string(from: Date())
    FileHandle.standardError.write(Data("[\(stamp)] meeting-capture: \(message)\n".utf8))
}

// MARK: - Accessibility helpers

func axAttribute(_ element: AXUIElement, _ name: String) -> CFTypeRef? {
    var value: CFTypeRef?
    guard AXUIElementCopyAttributeValue(element, name as CFString, &value) == .success else { return nil }
    return value
}

func axString(_ element: AXUIElement, _ name: String) -> String {
    axAttribute(element, name) as? String ?? ""
}

func axChildren(_ element: AXUIElement) -> [AXUIElement] {
    axAttribute(element, kAXChildrenAttribute) as? [AXUIElement] ?? []
}

func axParent(_ element: AXUIElement) -> AXUIElement? {
    guard let value = axAttribute(element, kAXParentAttribute), CFGetTypeID(value) == AXUIElementGetTypeID() else { return nil }
    return (value as! AXUIElement)
}

func axClasses(_ element: AXUIElement) -> [String] {
    axAttribute(element, "AXDOMClassList") as? [String] ?? []
}

func axDomID(_ element: AXUIElement) -> String { axString(element, "AXDOMIdentifier") }

/// Native apps expose AXIdentifier where Chromium ones expose DOM ids.
func axIdentifier(_ element: AXUIElement) -> String { axString(element, "AXIdentifier") }

func axDescription(_ element: AXUIElement) -> String { axString(element, kAXDescriptionAttribute) }

func axNodeID(_ element: AXUIElement) -> String { axString(element, "ChromeAXNodeId") }

/// Visible text of a subtree, in document order, without the duplication you
/// get from naively concatenating value/title/description of every node.
func axText(_ element: AXUIElement, depth: Int = 0) -> String {
    guard depth < 24 else { return "" }
    let role = axString(element, kAXRoleAttribute)
    if role == "AXStaticText" || role == "AXHeading" || role == "AXLink" {
        for key in [kAXValueAttribute, kAXTitleAttribute, kAXDescriptionAttribute] {
            let value = axString(element, key).trimmingCharacters(in: .whitespacesAndNewlines)
            if !value.isEmpty { return value }
        }
        return ""
    }
    let parts = axChildren(element).map { axText($0, depth: depth + 1) }.filter { !$0.isEmpty }
    return parts.joined(separator: " ")
}

/// Static text leaves of a subtree, in order.
func axStaticTexts(_ element: AXUIElement, depth: Int = 0) -> [String] {
    guard depth < 24 else { return [] }
    if axString(element, kAXRoleAttribute) == "AXStaticText" {
        let value = axString(element, kAXValueAttribute).trimmingCharacters(in: .whitespacesAndNewlines)
        return value.isEmpty ? [] : [value]
    }
    return axChildren(element).flatMap { axStaticTexts($0, depth: depth + 1) }
}

func findElement(from root: AXUIElement, depth: Int = 0, where match: (AXUIElement) -> Bool) -> AXUIElement? {
    guard depth < 80 else { return nil }
    if match(root) { return root }
    for child in axChildren(root) {
        if let hit = findElement(from: child, depth: depth + 1, where: match) { return hit }
    }
    return nil
}

func axWindows(_ app: AXUIElement) -> [AXUIElement] {
    axAttribute(app, kAXWindowsAttribute) as? [AXUIElement] ?? []
}

/// Position and size in the global, top-left-origin space AX uses — the same
/// one CGDisplayBounds reports in, and NOT the bottom-left space of NSScreen.
func axFrame(_ element: AXUIElement) -> (origin: CGPoint, size: CGSize) {
    var origin = CGPoint.zero, size = CGSize.zero
    if let value = axAttribute(element, kAXPositionAttribute), CFGetTypeID(value) == AXValueGetTypeID() {
        AXValueGetValue(value as! AXValue, .cgPoint, &origin)
    }
    if let value = axAttribute(element, kAXSizeAttribute), CFGetTypeID(value) == AXValueGetTypeID() {
        AXValueGetValue(value as! AXValue, .cgSize, &size)
    }
    return (origin, size)
}

@discardableResult
func axSetPosition(_ element: AXUIElement, _ point: CGPoint) -> Bool {
    var point = point
    guard let value = AXValueCreate(.cgPoint, &point) else { return false }
    return AXUIElementSetAttributeValue(element, kAXPositionAttribute as CFString, value) == .success
}

@discardableResult
func axSetSize(_ element: AXUIElement, _ size: CGSize) -> Bool {
    var size = size
    guard let value = AXValueCreate(.cgSize, &size) else { return false }
    return AXUIElementSetAttributeValue(element, kAXSizeAttribute as CFString, value) == .success
}

/// Every active display, in the global top-left space AX positions use.
func displayBounds() -> [CGRect] {
    var count: UInt32 = 0
    guard CGGetActiveDisplayList(0, nil, &count) == .success, count > 0 else { return [] }
    var ids = [CGDirectDisplayID](repeating: 0, count: Int(count))
    guard CGGetActiveDisplayList(count, &ids, &count) == .success else { return [] }
    return ids.prefix(Int(count)).map { CGDisplayBounds($0) }
}

/// Where to tuck a window so it is out of sight but still open.
///
/// It cannot simply be minimized: a minimized window stops receiving updates
/// entirely. Being covered or offscreen is fine, though — so this hides all
/// but a small nub of it past the outside edge of the second display (or of
/// the only display there is), which macOS allows and which keeps it alive.
///
/// Which edge is "outside" depends on the arrangement: pushing left is right
/// for a second display sitting to the left of the primary, but would shove
/// the window ONTO the primary for one sitting to the right. So both are
/// tried and the one that spills least onto another display wins.
///
/// Pure, so the geometry is testable on a single-monitor machine.
func tuckOrigin(windowSize: CGSize, displays: [CGRect], showing: CGFloat = 40) -> CGPoint? {
    // The primary display is the one at the origin of the global space.
    let secondary = displays.first { $0.origin != .zero }
    guard let screen = secondary ?? displays.first else { return nil }
    let others = displays.filter { $0 != screen }
    let y = screen.maxY - showing // hangs off the bottom edge too
    let candidates = [
        CGPoint(x: screen.minX - (windowSize.width - showing), y: y), // off the left
        CGPoint(x: screen.maxX - showing, y: y),                      // off the right
    ]
    func spill(_ origin: CGPoint) -> CGFloat {
        let rect = CGRect(origin: origin, size: windowSize)
        return others.reduce(0) { $0 + $1.intersection(rect).size.width * $1.intersection(rect).size.height }
    }
    return candidates.min { spill($0) < spill($1) }
}

/// The window server's layer for a window, or nil when it can't be found (it
/// may be on another Space). Teams' "Pin window" raises the layer above the
/// ordinary 0, which is how pinning is detected — the button's own label is
/// localized, so it is no use.
func windowLayer(pid: pid_t, frame: (origin: CGPoint, size: CGSize)) -> Int? {
    let listed = CGWindowListCopyWindowInfo([.optionOnScreenOnly, .excludeDesktopElements],
                                            kCGNullWindowID) as? [[String: Any]] ?? []
    for window in listed {
        guard window[kCGWindowOwnerPID as String] as? pid_t == pid,
              let bounds = window[kCGWindowBounds as String] as? [String: CGFloat],
              let layer = window[kCGWindowLayer as String] as? Int else { continue }
        guard bounds["X"] == frame.origin.x, bounds["Y"] == frame.origin.y,
              bounds["Width"] == frame.size.width, bounds["Height"] == frame.size.height
        else { continue }
        return layer
    }
    return nil
}

/// Click a point the way a hand would: through the window server, with the
/// pointer really there.
///
/// Teams' WebView ignores both AXPress and mouse events posted straight to the
/// process (`postToPid`) — the button reports success and nothing happens — so
/// a real click is the only thing that works on its caption controls. The
/// caller is responsible for putting the pointer and the front app back.
func clickThroughWindowServer(at point: CGPoint) {
    let source = CGEventSource(stateID: .combinedSessionState)
    CGEvent(mouseEventSource: source, mouseType: .mouseMoved,
            mouseCursorPosition: point, mouseButton: .left)?.post(tap: .cghidEventTap)
    usleep(150_000)
    let down = CGEvent(mouseEventSource: source, mouseType: .leftMouseDown,
                       mouseCursorPosition: point, mouseButton: .left)
    let up = CGEvent(mouseEventSource: source, mouseType: .leftMouseUp,
                     mouseCursorPosition: point, mouseButton: .left)
    down?.setIntegerValueField(.mouseEventClickState, value: 1)
    up?.setIntegerValueField(.mouseEventClickState, value: 1)
    down?.post(tap: .cghidEventTap)
    usleep(80_000)
    up?.post(tap: .cghidEventTap)
}

/// Make an app genuinely frontmost before a real click or shortcut. Merely
/// calling NSRunningApplication.activate() is only a request: while the user
/// was active in Ghostty, macOS refused it and every "Teams" click landed on
/// the terminal instead. AXFrontmost is authoritative under the Accessibility
/// permission this tool already requires.
@discardableResult
func bringToFront(pid: pid_t, window: AXUIElement? = nil) -> NSRunningApplication? {
    let prior = NSWorkspace.shared.frontmostApplication
    let app = AXUIElementCreateApplication(pid)
    AXUIElementSetAttributeValue(app, kAXFrontmostAttribute as CFString, kCFBooleanTrue)
    if let window { AXUIElementPerformAction(window, kAXRaiseAction as CFString) }
    usleep(350_000)
    return prior
}

func restoreFrontmost(_ prior: NSRunningApplication?) {
    guard let prior else { return }
    let app = AXUIElementCreateApplication(prior.processIdentifier)
    AXUIElementSetAttributeValue(app, kAXFrontmostAttribute as CFString, kCFBooleanTrue)
}

/// One automated interaction at a time, process-wide.
///
/// Clicking is global state: the pointer, the frontmost app and the window
/// under the cursor are all shared. The roster snapshot runs on a background
/// thread so a 300-person list cannot stall caption polling for minutes, which
/// means it can overlap the poll thread's own clicking (captions/chat pop-out,
/// unpin). Two of those at once would each restore the other's "prior" pointer
/// and app, and land clicks in the wrong window. Whoever gets here second
/// simply tries again later; nothing waits, because the waiter would be the
/// poll loop.
enum UIAutomation {
    private static let mutex = NSLock()
    private static var busy = false

    static func tryEnter() -> Bool {
        mutex.lock()
        defer { mutex.unlock() }
        if busy { return false }
        busy = true
        return true
    }

    /// Wait for a turn, for callers that can afford to.
    ///
    /// The poll loop must never block — it is what records captions — so it
    /// uses tryEnter and skips a tick. The roster snapshot is the opposite
    /// case: it was moved onto a background thread precisely so it could take
    /// its time, and one-shot contention is how it starved. Measured live: the
    /// poll loop held this lock through a whole-tree search four times a
    /// second, the snapshot asked for it once every twenty seconds, and it
    /// never once got in.
    static func enter(waitingUntil deadline: Date) -> Bool {
        while true {
            if tryEnter() { return true }
            guard Date() < deadline else { return false }
            usleep(200_000)
        }
    }

    static func leave() {
        mutex.lock()
        busy = false
        mutex.unlock()
    }
}

/// How long since the human last typed, and how long since they last clicked,
/// dragged or scrolled. Two separate questions, because they mean different
/// things to anything that wants to take over the pointer and the front app.
///
/// Bare mouse MOVEMENT is deliberately not asked about. Measured in a live
/// meeting, a hand resting on a trackpad kept mouseMoved under two seconds
/// continuously for minutes on end, while the keyboard sat idle for twenty:
/// a gate that waits for a still pointer simply never opens, and the first
/// version of the roster snapshot never fired once.
///
/// Asks about specific event types rather than kCGAnyInputEventType: that
/// sentinel is not a case of Swift's CGEventType, so it cannot be spelled
/// without a force-unwrap that would trap. The source is .hidSystemState —
/// real hardware, so our own synthetic clicks do not read as the user being
/// busy.
func secondsSinceTyping() -> TimeInterval {
    [CGEventType.keyDown, .flagsChanged].map {
        CGEventSource.secondsSinceLastEventType(.hidSystemState, eventType: $0)
    }.min() ?? .greatestFiniteMagnitude
}

func secondsSincePointerAction() -> TimeInterval {
    [CGEventType.leftMouseDown, .rightMouseDown, .otherMouseDown,
     .leftMouseDragged, .rightMouseDragged, .scrollWheel].map {
        CGEventSource.secondsSinceLastEventType(.hidSystemState, eventType: $0)
    }.min() ?? .greatestFiniteMagnitude
}

// MARK: - Recording

struct Utterance {
    var speaker: String
    var text: String
    var startedAt: Date
    var changedAt: Date
}

/// The scrolling terminal view: finished lines scroll up, in-progress speech
/// updates in place below them (like `tail -f`). Independent of the files, so a
/// meeting can be displayed before it has written anything.
final class LiveView {
    private let stdout = FileHandle.standardOutput
    /// Only a terminal gets the transcript drawn on stdout. Under launchd stdout
    /// is the log, and every finished line was landing there as well as in the
    /// .txt — so --follow, which tails both, drew each line twice.
    private let isInteractive: Bool
    private var lines: [String] = []

    init(options: Options) {
        isInteractive = !options.quiet && !options.jsonToStdout && isatty(STDOUT_FILENO) == 1
    }

    static func terminalWidth() -> Int {
        var size = winsize()
        if ioctl(STDOUT_FILENO, UInt(TIOCGWINSZ), &size) == 0, size.ws_col > 0 { return Int(size.ws_col) }
        return 100
    }

    static func terminalHeight() -> Int {
        var size = winsize()
        if ioctl(STDOUT_FILENO, UInt(TIOCGWINSZ), &size) == 0, size.ws_row > 0 { return Int(size.ws_row) }
        return 24
    }

    /// Break a line into rows that fit the terminal.
    ///
    /// The live region is erased by moving up one row per line we drew, so the
    /// count has to match what the terminal actually used. Letting a line
    /// soft-wrap would make it occupy several rows, and the region would stack
    /// up instead of being replaced. Truncating kept the count honest but hid
    /// the end of every sentence, which is exactly the part being spoken, so
    /// wrap here and report the real number of rows instead. Stay a column
    /// short of the width: filling the last one makes some terminals wrap by
    /// themselves. (Counting is by String.count, which approximates display
    /// columns; CJK text and emoji wrap at display width everywhere, so a
    /// row's String.count can understate the columns it really occupies.)
    static func wrap(_ text: String, width: Int) -> [String] {
        let limit = max(8, width - 1)
        guard text.count > limit else { return [text] }
        var rows: [String] = []
        var line = ""
        for word in text.split(separator: " ") {
            var word = String(word)
            // A word too long to ever fit has to be broken somewhere.
            while word.count > limit {
                if !line.isEmpty { rows.append(line); line = "" }
                rows.append(String(word.prefix(limit)))
                word = String(word.dropFirst(limit))
            }
            if line.isEmpty {
                line = word
            } else if line.count + 1 + word.count <= limit {
                line += " " + word
            } else {
                rows.append(line)
                line = word
            }
        }
        if !line.isEmpty { rows.append(line) }
        return rows
    }

    /// Wrap every pending line, keeping the most recent rows if the result is
    /// taller than the terminal: the newest words matter most, and erasing more
    /// rows than the screen has would eat the transcript above.
    static func layout(_ pending: [String]) -> [String] {
        let width = terminalWidth()
        let rows = pending
            .flatMap { wrap($0.replacingOccurrences(of: "\n", with: " "), width: width) }
            .filter { !$0.isEmpty }
        let ceiling = max(1, terminalHeight() - 1)
        return rows.count > ceiling ? Array(rows.suffix(ceiling)) : rows
    }

    /// Erase the region, leaving the cursor at the start of its first line.
    func erase() {
        guard isInteractive, !lines.isEmpty else { lines = []; return }
        var escape = "\r\u{1B}[2K"
        for _ in 1..<max(1, lines.count) { escape += "\u{1B}[1A\u{1B}[2K" }
        stdout.write(Data(escape.utf8))
        lines = []
    }

    private func draw(_ rendered: [String]) {
        guard isInteractive, !rendered.isEmpty else { return }
        stdout.write(Data(rendered.joined(separator: "\n").utf8))
        lines = rendered
    }

    func set(_ pending: [String]) {
        guard isInteractive else { return }
        let rendered = LiveView.layout(pending)
        guard rendered != lines else { return } // avoid redrawing unchanged text
        erase()
        draw(rendered)
    }

    /// Print a finished transcript line above the live region.
    func permanent(_ line: String) {
        guard isInteractive else { return }
        let pending = lines
        erase()
        stdout.write(Data((line + "\n").utf8))
        draw(pending)
    }
}

func elapsedString(from start: Date, to end: Date) -> String {
    let total = max(0, Int(end.timeIntervalSince(start)))
    return String(format: "%02d:%02d:%02d", total / 3600, (total / 60) % 60, total % 60)
}

/// Pull "mm:ss" or "h:mm:ss" out of a label like "Elapsed time 21:54" or
/// "My connected time is 34:50". Strict on purpose: every component must be
/// digits, and minutes/seconds must be under 60, so "1::30" fails to parse
/// instead of silently becoming one minute thirty.
func parseMeetingClock(_ raw: String) -> TimeInterval? {
    let token = raw.split(whereSeparator: { !$0.isNumber && $0 != ":" }).first { $0.contains(":") } ?? ""
    var comps: [Int] = []
    for part in token.split(separator: ":", omittingEmptySubsequences: false) {
        guard let value = Int(part) else { return nil }
        comps.append(value)
    }
    guard (2...3).contains(comps.count), comps.dropFirst().allSatisfy({ $0 < 60 }) else { return nil }
    switch comps.count {
    case 2: return TimeInterval(comps[0] * 60 + comps[1])
    default: return TimeInterval(comps[0] * 3600 + comps[1] * 60 + comps[2])
    }
}

/// How the jsonl `elapsed` field is rendered. Chosen once, when the first
/// line is written: the metadata documents what it means, so switching the
/// reference halfway through a file would make it contradict itself.
///
/// The .txt transcript does NOT use this — its stamps are always the time of
/// day (see Recorder.record), which is what makes a line findable in a
/// calendar, a chat log, or someone else's recording.
enum TimestampMode {
    /// Counting from a reference point — the app's connection clock when it
    /// displays a call clock, otherwise the moment recording began.
    case elapsed(from: Date)
    /// The time of day, for apps with no call clock: true whenever we joined,
    /// rather than a count from zero implying the meeting began when we did.
    case timeOfDay

    func stamp(_ date: Date) -> String {
        switch self {
        case .elapsed(let start): return elapsedString(from: start, to: date)
        case .timeOfDay: return Recorder.clockText(from: date)
        }
    }

    /// The value recorded in the jsonl metadata's `timestamps` field.
    var metadataValue: String {
        switch self {
        case .elapsed: return "elapsed"
        case .timeOfDay: return "time-of-day"
        }
    }
}

/// One writable transcript file. A protocol so tests can inject failing or
/// scripted sinks: FileHandle raises unrecoverable ObjC exceptions for closed
/// descriptors and never throws in-process, so write-failure paths are only
/// testable behind this seam.
protocol TranscriptSink {
    var path: String { get }
    func append(_ data: Data) throws
}

/// The real thing: a FileHandle opened for writing, positioned at EOF.
struct FileSink: TranscriptSink {
    let path: String
    private let handle: FileHandle

    init(path: String, handle: FileHandle) {
        self.path = path
        self.handle = handle
    }

    /// nil when the file can't be opened for writing (missing directory,
    /// permissions). Callers decide whether that's fatal. Opens at EOF so
    /// appends never clobber existing transcripts.
    init?(url: URL) {
        guard let handle = FileHandle(forWritingAtPath: url.path) else { return nil }
        handle.seekToEndOfFile()
        self.init(path: url.path, handle: handle)
    }

    func append(_ data: Data) throws {
        try handle.write(contentsOf: data)
    }
}

final class Recorder {
    let startedAt: Date
    /// What `[HH:MM:SS]` stamps count from (see TimestampMode).
    let mode: TimestampMode
    let jsonlURL: URL
    let textURL: URL
    private let jsonl: any TranscriptSink
    private let text: any TranscriptSink
    private let stdout = FileHandle.standardOutput
    let options: Options

    /// Opens both transcript files under options.directory. Tests inject
    /// sinks directly via the delegating initializer instead.
    convenience init(options: Options, app: String, meeting: String, startedAt: Date, mode: TimestampMode) {
        let directory = URL(fileURLWithPath: options.directory, isDirectory: true)
        try? FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)

        let stamp = DateFormatter()
        stamp.dateFormat = "yyyyMMdd_HHmmss"
        // The app is in the name because meeting titles don't say where they
        // happened, and the same people meet in different places.
        let base = "\(stamp.string(from: startedAt))-\(app)-\(Recorder.slugify(meeting))"
        let jsonlURL = directory.appendingPathComponent(base + ".jsonl")
        let textURL = directory.appendingPathComponent(base + ".txt")

        for url in [jsonlURL, textURL] where !FileManager.default.fileExists(atPath: url.path) {
            FileManager.default.createFile(atPath: url.path, contents: nil)
        }
        guard let jsonlSink = FileSink(url: jsonlURL),
              let textSink = FileSink(url: textURL) else {
            fail("cannot write to \(directory.path)")
        }
        self.init(options: options, startedAt: startedAt, mode: mode,
                  jsonlURL: jsonlURL, textURL: textURL,
                  jsonl: jsonlSink, text: textSink)
    }

    /// The storage-free initializer: everything above this line is about
    /// naming and opening files, which fault-injection tests must bypass.
    init(options: Options, startedAt: Date, mode: TimestampMode,
         jsonlURL: URL, textURL: URL, jsonl: any TranscriptSink, text: any TranscriptSink) {
        self.options = options
        self.startedAt = startedAt
        self.mode = mode
        self.jsonlURL = jsonlURL
        self.textURL = textURL
        self.jsonl = jsonl
        self.text = text
    }

    static func slugify(_ value: String) -> String {
        let cleaned = value
            .replacingOccurrences(of: "| Microsoft Teams", with: "")
            .lowercased()
            .map { $0.isLetter || $0.isNumber ? $0 : "-" }
        let slug = String(cleaned)
            .split(separator: "-", omittingEmptySubsequences: true)
            .joined(separator: "-")
        return slug.isEmpty ? "meeting" : slug
    }

    static let isoFormatter: DateFormatter = {
        let formatter = DateFormatter()
        formatter.dateFormat = "yyyy-MM-dd'T'HH:mm:ssXXXXX"
        return formatter
    }()

    func elapsed(_ date: Date) -> String { mode.stamp(date) }

    /// The wall-clock stamp used when there is no call clock. Private so the
    /// shared mutable formatter can't be silently reconfigured elsewhere.
    private static let clockFormatter: DateFormatter = {
        let f = DateFormatter()
        f.dateFormat = "HH:mm:ss"
        return f
    }()

    static func clockText(from date: Date) -> String { clockFormatter.string(from: date) }

    /// Serializes and appends one JSONL event. Returns false when the event
    /// could not be produced or written — the caller then holds back the text
    /// half too (see record).
    @discardableResult
    func writeJSON(_ payload: [String: Any]) -> Bool {
        guard let data = try? JSONSerialization.data(withJSONObject: payload, options: [.sortedKeys]),
              var line = String(data: data, encoding: .utf8) else {
            status("could not serialize a \(payload["type"] ?? "json") event; neither file records it")
            return false
        }
        line += "\n"
        do {
            try jsonl.append(Data(line.utf8))
        } catch {
            status("cannot write to \(jsonlURL.path): \(error.localizedDescription); neither file records this event")
            return false
        }
        if options.jsonToStdout && !options.quiet { stdout.write(Data(line.utf8)) }
        return true
    }

    /// Head the transcript with what the bracketed times mean. Stamps are
    /// wall-clock, so the header is what says which DAY they belong to, and
    /// (when known) when the meeting itself began. Best-effort: a failure here
    /// is logged and otherwise ignored — losing the header must never cost
    /// transcript lines.
    func writeHeader(_ lines: [String]) {
        let block = lines.map { "# \($0)\n" }.joined() + "\n"
        do {
            try text.append(Data(block.utf8))
        } catch {
            status("cannot write header to \(textURL.path): \(error.localizedDescription); continuing without it")
        }
    }

    /// Append to both files and report what persisted. A failed jsonl write
    /// holds the transcript line back, so the pair never disagrees about what
    /// happened; a text write that fails after jsonl succeeded cannot be
    /// undone, so the caller gets .jsonOnly(line) to retry text-only.
    func record(kind: String, speaker: String, body: String, at date: Date, extra: [String: Any] = [:]) -> WriteOutcome {
        // Two renderings of one instant. The jsonl keeps the meeting-relative
        // `elapsed` field for anyone reasoning about position within the call;
        // the transcript gets the time of day, which is what you actually need
        // to line a quote up against a calendar or a chat message.
        let stamped = elapsed(date)
        let clock = Recorder.clockText(from: date)
        var payload: [String: Any] = [
            "type": kind,
            "speaker": speaker,
            "text": body,
            "ts": Recorder.isoFormatter.string(from: date),
            "elapsed": stamped
        ]
        payload.merge(extra) { current, _ in current }
        guard writeJSON(payload) else { return .failed }
        // "(chat) Alex: hi", "(people) 8 in the meeting…" — the kind is worth
        // seeing in the transcript when it is not someone speaking. A roster
        // has no speaker, and "(people) : 8 in" would read like a bug.
        let tag = kind == "caption" ? "" : "(\(kind)) "
        let attribution = speaker.isEmpty ? "" : "\(speaker): "
        let line = "[\(clock)] \(tag)\(attribution)\(body)"
        do {
            try text.append(Data((line + "\n").utf8))
        } catch {
            status("cannot write to \(textURL.path): \(error.localizedDescription); the transcript is missing this line")
            return .jsonOnly(line)
        }
        return .written(line)
    }

    /// Append an already-rendered transcript line (text half only), used when
    /// replaying .jsonOnly outcomes. Throws so callers can surface cause and
    /// path in their own (throttled, aggregate) warnings.
    func appendText(_ line: String) throws {
        try text.append(Data((line + "\n").utf8))
    }
}

/// What persisted when an event was recorded. With the ordered backlog in
/// place, callers commit dedup state for ALL outcomes — a .failed event is
/// queued, not dropped — but the outcome still decides whether the transcript
/// line is drawn now or owed as text debt.
enum WriteOutcome: Equatable {
    /// Both files have it; carries the transcript line for display.
    case written(String)
    /// The jsonl file has it; carries the transcript line for a text-only retry.
    case jsonOnly(String)
    /// Neither file has it.
    case failed
}

/// Outcome of one attempt on one unit of queued output.
enum AttemptResult {
    /// Persisted everywhere it needs to be; drop the unit.
    case done
    /// jsonl persisted; replace the unit with this remaining text debt.
    case needsText(String)
    /// Nothing persisted; keep the unit for retry. Carries the cause for
    /// callers' aggregate warnings.
    case failed(String)
}

// MARK: - Meeting apps

struct CaptionEntry {
    let id: String
    let speaker: String
    let text: String
}

/// Absolute identities for caption segments that reach us as a sliding window
/// with no ids at all (Google Meet's per-speaker blocks, Slack's overlay
/// events). Each poll reports the settled segments currently visible — the
/// tail of the conversation so far — and gets back where they sit overall, so
/// the same words spoken twice land as two utterances and an old segment
/// falling off-screen shifts nothing.
///
/// These apps append, so the visible settled segments are normally the exact
/// tail of the history. If the window ever moves past what history still
/// holds, it re-anchors on the longest overlap so positions keep counting up
/// rather than restarting and rewriting the conversation. Keys are a struct
/// rather than joined strings: a speaker name containing the would-be
/// delimiter must not be able to impersonate a different utterance.
struct SegmentKey: Equatable {
    let speaker: String
    let text: String
}

final class SegmentHistory {
    private var keys: [SegmentKey] = []
    /// Segments already dropped off the front of `keys`.
    private var dropped = 0
    /// The widest window absorbed so far, which sets how much has to be kept.
    private var widest = 0

    /// Fold the visible settled segments into the history; returns the absolute
    /// position of the first one. The rest number on from there, and the
    /// segment still being spoken takes `returned + settled.count`.
    ///
    /// Known limit: a one-segment window whose content equals the newest
    /// retained segment is indistinguishable from that segment still sitting
    /// on screen, so it reuses its position. The apps using this class keep
    /// several segments visible at once, which disambiguates in practice.
    func absorb(_ settled: [SegmentKey]) -> Int {
        guard !settled.isEmpty else { return dropped + keys.count }
        widest = max(widest, settled.count)
        for overlap in stride(from: min(keys.count, settled.count), through: 1, by: -1)
        where Array(keys.suffix(overlap)) == Array(settled.prefix(overlap)) {
            keys.append(contentsOf: settled.dropFirst(overlap))
            trim()
            return dropped + keys.count - settled.count
        }
        // Nothing lines up exactly. Before calling a whole screenful new, look
        // for where the window sits despite the difference: what changed is
        // usually a revision of something already written, and it keeps its
        // position rather than arriving again under a new one.
        if let anchor = anchor(for: settled) {
            let base = dropped + anchor
            let overlap = min(keys.count - anchor, settled.count)
            keys.replaceSubrange(anchor..<(anchor + overlap), with: settled.prefix(overlap))
            keys.append(contentsOf: settled.dropFirst(overlap))
            trim()
            return base
        }
        // No overlap with anything remembered: all of these are new.
        keys.append(contentsOf: settled)
        trim()
        return dropped + keys.count - settled.count
    }

    /// Where this window most likely sits in the history.
    ///
    /// Speech recognition revises what it has already put on screen — Meet was
    /// caught correcting a segment 33 places back, 43 characters becoming 45 —
    /// and an exact prefix match cannot survive that: one changed word in the
    /// middle made every segment around it look new, and the whole panel was
    /// written again. Over six minutes that turned 128 utterances into 2,110
    /// lines.
    ///
    /// So anchor on the oldest visible segment, the one least likely to still
    /// be changing, and only accept a position most of the window agrees with.
    /// Without that agreement a call where someone says "Yeah." twice would
    /// staple the second one over the first.
    private func anchor(for settled: [SegmentKey]) -> Int? {
        var best: (index: Int, matches: Int)?
        for index in stride(from: keys.count - 1, through: 0, by: -1) where keys[index] == settled[0] {
            let overlap = min(keys.count - index, settled.count)
            guard overlap > 1 else { continue }
            let matches = zip(keys[index...], settled.prefix(overlap))
                .reduce(0) { $0 + ($1.0 == $1.1 ? 1 : 0) }
            guard matches * 2 > overlap else { continue }
            if best == nil || matches > best!.matches { best = (index, matches) }
        }
        return best?.index
    }

    /// A many-hour call produces thousands of segments; keep memory flat.
    ///
    /// What is retained must stay comfortably wider than the window, because
    /// overlap matching compares the window's PREFIX against history's SUFFIX:
    /// once history holds less than a window, the two can never line up, every
    /// poll looks entirely new, and the same segments are written again and
    /// again at fresh positions.
    ///
    /// That is not hypothetical. A 29-minute Google Meet call ended up showing
    /// 436 segments at once against a fixed retention of 300, and wrote 882,307
    /// caption events for 734 distinct lines — a 199 MB transcript of the same
    /// sentences over and over. So the floor grows with the widest window seen,
    /// and only the fixed part is a guess.
    private func trim() {
        let floor = max(600, widest * 3)
        guard keys.count > floor * 2 else { return }
        let excess = keys.count - floor
        keys.removeFirst(excess)
        dropped += excess
    }

    /// Forget everything: positions are per meeting, and the apps are singletons.
    func reset() {
        keys = []
        dropped = 0
        widest = 0
    }
}

struct ChatMessage {
    let id: String
    let author: String
    let text: String
}

/// What came of asking an app to turn captions on.
enum CaptionRequest {
    /// The control was pressed; captions should appear shortly.
    case pressed
    /// Captions were already running, so there is nothing left to do.
    case alreadyOn
    /// The control wasn't reachable — no attempt was spent, try again later.
    case unreachable
}

/// How much of an app's UI is reachable through accessibility right now.
/// Detection needs more than .unreadable; caption reading needs .webContent.
enum TreeReadiness {
    /// Nothing to anchor on — a hollow or missing tree.
    case unreadable
    /// Meeting chrome (window title) is visible but captions aren't readable
    /// yet: detection can proceed, caption reading cannot.
    case meetingChrome
    /// Full content tree: everything is readable, captions included.
    case webContent
}

protocol MeetingApp {
    /// Short name used for --app and in metadata.
    var id: String { get }
    var displayName: String { get }
    /// Regex matched against a process's executable path and bundle path,
    /// the same string pgrep -f used to see. NSWorkspace is the lookup now:
    /// four pgrep spawns every two seconds were 10% of a core while idle.
    var processPattern: String { get }

    /// Non-nil while a call is up. The element is also a hint for the title.
    func meetingAnchor(_ app: AXUIElement) -> AXUIElement?
    func meetingTitle(_ app: AXUIElement, anchor: AXUIElement?) -> String

    /// The element whose children are caption entries, if captions are showing.
    func captionsContainer(_ app: AXUIElement) -> AXUIElement?
    /// How long this participant has been connected, if the app displays it.
    /// Lets lines be numbered from that reference rather than from when we
    /// attached, which matters when the daemon is restarted mid-meeting. (Not
    /// necessarily how long the MEETING has run — apps report connection time,
    /// hence the name: this is the app's CLAIMED elapsed seconds.)
    func reportedElapsedSeconds(_ app: AXUIElement) -> TimeInterval?
    func captionEntries(in container: AXUIElement) -> [CaptionEntry]
    /// Whether the captions UI is up, regardless of whether it has any text in
    /// it right now. Used to avoid toggling captions that are already on.
    func captionsPanelOpen(_ app: AXUIElement) -> Bool
    /// Ask the app to show captions.
    func requestCaptions(pid: pid_t) -> CaptionRequest
    /// True when this app can list who is in the meeting, so the daemon can
    /// record a roster once per meeting (see Session.maintainRoster).
    var supportsRosterSnapshot: Bool { get }
    /// True when reading that list disturbs nothing: no pointer taken, no
    /// window brought forward, no window resized. Meet is quiet (AXPress does
    /// everything); Teams is not (its WebView ignores AXPress, so the roster
    /// costs real clicks). A noisy reader has to wait for the user to pause.
    var rosterSnapshotIsQuiet: Bool { get }
    /// Read the participant list. Called on a BACKGROUND THREAD, so an
    /// implementation must not touch the app object's mutable state.
    func captureRoster(pid: pid_t, deadline: Date?) -> RosterOutcome
    /// True when the captions control is a toggle (Teams' ⇧⌘A). A second
    /// press would turn them back off, so we must not retry blindly.
    var captionPressToggles: Bool { get }

    func chatContainer(_ app: AXUIElement) -> AXUIElement?
    func chatMessages(in container: AXUIElement) -> [ChatMessage]
    /// Called when a session starts. Apps are singletons, so any per-meeting
    /// caption bookkeeping (position histories, live-slot tracking) must be
    /// cleared here rather than leaking across meetings.
    func resetCaptureState()

    /// Called every poll while a meeting is being recorded, so an app can keep
    /// the surfaces it reads from readable — Teams stops updating a meeting
    /// window that another window completely covers, and its chat panel may
    /// not even be open. Free to be slow and to touch the UI, but only rarely:
    /// it runs on the polling thread.
    func maintainSurfaces(_ app: AXUIElement, pid: pid_t, now: Date,
                          popOutCaptions: Bool, popOutChat: Bool)

    /// True when finished utterances stay on screen, so waiting for one to
    /// disappear would hold the whole transcript back. Such an app is assumed
    /// to append: anything above the newest entry is done being edited.
    var finalizesWhenSuperseded: Bool { get }
    /// Write an utterance out once its text has been unchanged this long, for
    /// apps that would otherwise leave lines pending indefinitely. The newest
    /// utterance gets twice this long — it may simply be paused mid-speech.
    var idleFinalizeSeconds: TimeInterval? { get }

    /// True when the app displays how long this participant has been
    /// connected, so lines can be numbered from that reference. An app without
    /// one can only count from when we joined, which says nothing useful about
    /// a meeting already in progress - those transcripts get the time of day.
    var reportsMeetingClock: Bool { get }

    /// Whether one specific caption id names one logical utterance: stable
    /// across revisions while it is being spoken, never reused for a different
    /// sentence. (Not "immutable text" — Meet revises its newest segment in
    /// place under the same id.) Stable ids bypass the content-based
    /// deduplication, which exists precisely because some apps re-render
    /// finished lines under fresh ids. Default: none are.
    func hasStableIdentity(_ id: String) -> Bool

    /// True when the caption surface is only present while someone is
    /// speaking. Its absence then says nothing about whether captions are
    /// switched on, so once it has been seen the app must not be asked again.
    var captionsSurfaceIsTransient: Bool { get }

    /// True when the UI is a Chromium/Electron web view. Such apps keep their
    /// accessibility tree switched off until a client asks for it, and must be
    /// woken before anything can be read. Native apps must NOT be poked this
    /// way: AXEnhancedUserInterface triggers window-resize bugs in AppKit.
    var rendersWebContent: Bool { get }

    /// Whether the tree is readable enough to DETECT A MEETING. Deliberately
    /// weaker than "captions can be read": Teams counts via window title while
    /// its WebView is still hollow. Apps whose captions need more than
    /// detection uses should keep waking until both hold.
    func treeReadiness(_ app: AXUIElement) -> TreeReadiness

    /// Whether this app's web content has finished waking up. The default
    /// asks for DOM ids, which is what Chromium and Electron publish; WebKit
    /// publishes none, so Safari web apps override this.
    func webTreeIsAwake(_ app: AXUIElement) -> Bool
}

extension MeetingApp {
    // Teams-style: an utterance is done when its element disappears.
    var finalizesWhenSuperseded: Bool { false }
    var idleFinalizeSeconds: TimeInterval? { nil }
    // Most apps leave the caption panel up between utterances.
    var captionsSurfaceIsTransient: Bool { false }
    // Assume the pessimistic case: an app that re-renders finished lines, so
    // no caption id is stable by default (see hasStableIdentity).
    func hasStableIdentity(_ id: String) -> Bool { false }
    // Most apps don't say how long the call has been going.
    func reportedElapsedSeconds(_ app: AXUIElement) -> TimeInterval? { nil }
    var reportsMeetingClock: Bool { false }
    var captionPressToggles: Bool { false }
    // Only Teams exposes a readable participant list so far.
    var supportsRosterSnapshot: Bool { false }
    // Assume the pessimistic case: a reader that takes the pointer.
    var rosterSnapshotIsQuiet: Bool { false }
    func captureRoster(pid: pid_t, deadline: Date?) -> RosterOutcome {
        .failed("\(displayName) has no participant list that can be read")
    }
    // Assume native AppKit; only opt in to the wake where it is needed.
    var rendersWebContent: Bool { false }
    func webTreeIsAwake(_ app: AXUIElement) -> Bool { webTreeAwake(app) }
    func treeReadiness(_ app: AXUIElement) -> TreeReadiness {
        rendersWebContent
            ? (webTreeIsAwake(app) ? .webContent : .unreadable)
            : (!axChildren(app).isEmpty ? .webContent : .unreadable)
    }
    // Chat is optional; most apps don't expose it to us yet.
    func chatContainer(_ app: AXUIElement) -> AXUIElement? { nil }
    func chatMessages(in container: AXUIElement) -> [ChatMessage] { [] }
    func resetCaptureState() {}
    // Only Teams parks a covered window; everyone else keeps rendering.
    func maintainSurfaces(_ app: AXUIElement, pid: pid_t, now: Date,
                          popOutCaptions: Bool, popOutChat: Bool) {}
}

func windowTitle(containing element: AXUIElement) -> String? {
    var node: AXUIElement? = element
    while let current = node {
        if axString(current, kAXRoleAttribute) == "AXWindow" {
            let title = axString(current, kAXTitleAttribute)
            return title.isEmpty ? nil : title
        }
        node = axParent(current)
    }
    return nil
}

func firstWindowTitle(_ app: AXUIElement) -> String {
    let windows = axAttribute(app, kAXWindowsAttribute) as? [AXUIElement] ?? []
    return windows.map { axString($0, kAXTitleAttribute) }.first { !$0.isEmpty } ?? ""
}

/// Whether this process is the meeting UI for `pattern`.
///
/// `pattern` is the same regex pgrep -f used: a path fragment for the native
/// apps, and `Web App .*Google Meet.app` for Meet, whose executable is named
/// "Web App" and whose bundle is "Google Meet.app". Matching the two together
/// covers both. Helpers (Slack Helper, Teams audio driver) do not match.
func processMatches(pattern: String, executable: String, bundle: String) -> Bool {
    let haystack = executable + " " + bundle
    return haystack.range(of: pattern, options: .regularExpression) != nil
}

/// A snapshot entry is usable when LaunchServices can describe the app at all.
/// A list where nothing can be described is broken, not empty — every
/// logged-in desktop has a Finder it can name.
func usableEntry(executable: String, bundle: String, bundleID: String) -> Bool {
    !(executable.isEmpty && bundle.isEmpty && bundleID.isEmpty)
}

func queryProcess(matching pattern: String) -> ProcessQuery {
    // NSWorkspace is a list the system already keeps; pgrep was a process
    // spawn (and, for a while, an fd leak) every time we wondered whether
    // Teams was still open. Four of those every two seconds was 10% of a
    // core all evening, with no meeting happening.
    //
    // But the list is served from a snapshot that decays: a daemon up for
    // three days matched nothing at all — 0% of samples anywhere near the
    // accessibility API, regexes running over entries with nothing in them —
    // and missed every meeting until it was restarted. So a list that cannot
    // describe even one app is a failure, never an answer.
    let running = NSWorkspace.shared.runningApplications
    guard running.contains(where: {
        usableEntry(executable: $0.executableURL?.path ?? "",
                    bundle: $0.bundleURL?.path ?? "",
                    bundleID: $0.bundleIdentifier ?? "")
    }) else {
        return .failed("the app list is not serving names or paths")
    }
    let match = running.first {
        processMatches(pattern: pattern,
                       executable: $0.executableURL?.path ?? "",
                       bundle: $0.bundleURL?.path ?? "")
    }
    return match.map { .running($0.processIdentifier) } ?? .notRunning
}

/// The ground truth, at the cost of a process spawn. The fallback for when
/// NSWorkspace cannot answer, rate-limited by the caller: four spawns a
/// minute is nothing, four every two seconds was the old CPU bill.
func pgrepLookup(matching pattern: String) -> ProcessQuery {
    let process = Process()
    process.executableURL = URL(fileURLWithPath: "/usr/bin/pgrep")
    process.arguments = ["-f", pattern]
    let pipe = Pipe()
    process.standardOutput = pipe
    // Pipe does not reliably release its descriptors on deinit once the
    // handles have been accessed — without these closes every pgrep call
    // leaks a pair, and ~2,500 leaked fds broke all lookups live on 2026-08-25.
    defer {
        try? pipe.fileHandleForReading.close()
        try? pipe.fileHandleForWriting.close()
    }
    do {
        try process.run()
    } catch {
        return .failed("cannot run pgrep: \(error.localizedDescription)")
    }
    process.waitUntilExit()
    switch process.terminationStatus {
    case 0: break
    case 1: return .notRunning
    default: return .failed("pgrep exited \(process.terminationStatus)")
    }
    // Exit 0 with unusable output is pgrep misbehaving, not proof the app is
    // gone — treating it as notRunning would end an active meeting.
    guard let output = String(data: pipe.fileHandleForReading.readDataToEndOfFile(), encoding: .utf8),
          let pid = output.split(separator: "\n").first.flatMap({ pid_t($0) }) else {
        return .failed("pgrep produced no usable pid")
    }
    return .running(pid)
}

enum ProcessQuery {
    case running(pid_t)
    case notRunning
    /// The lookup could not answer: a broken app-list snapshot, a pgrep launch
    /// error. Says nothing about whether the app is running — callers must
    /// never read it as "the app is gone".
    case failed(String)
}

var lastProcessLookupNote = ""
var lastProcessLookupAt = Date.distantPast

/// Process lookups failing is worth knowing even under --quiet, but not once
/// per poll.
func noteProcessLookupFailure(_ message: String) {
    let now = Date()
    guard !(message == lastProcessLookupNote && now.timeIntervalSince(lastProcessLookupAt) < 60) else { return }
    lastProcessLookupNote = message
    lastProcessLookupAt = now
    status(message)
}

var lastPgrepScanAt = Date.distantPast
/// True once a Chromium/WebKit tree is serving real content (DOM ids), as
/// opposed to the hollow shell it starts with.
/// True when a Chromium or Electron app has published its web content. DOM
/// ids are the signal because they appear exactly when the renderer switches
/// its accessibility tree on. WebKit publishes no AXDOMIdentifier at all, so
/// Safari web apps must answer this question differently — see
/// MeetApp.webTreeIsAwake.
func webTreeAwake(_ app: AXUIElement) -> Bool {
    findElement(from: app, where: { !axDomID($0).isEmpty }) != nil
}

/// Web renderers keep their accessibility tree switched off until a client asks for
/// it, so a fresh launch is a hollow window: ~229 nodes, no DOM ids, no
/// captions. Two attributes turn it on, and which one applies depends on how
/// the app is built:
///
///   AXManualAccessibility   Electron's documented opt-in (Slack, VS Code).
///   AXEnhancedUserInterface Chromium's own switch, which is what Teams 2
///                           needs — it is Edge WebView2, not Electron
///                           (see the EdgeBrowserFrameViewMac DOM class).
///
/// Both report failure on Teams (attributeUnsupported / notImplemented) yet
/// the tree still populates within a second, because the renderer (Chromium or
/// WebKit) activates on the attempt rather than on a successful set. So ignore
/// the return codes and check whether DOM ids showed up instead.
func pokeWebTree(_ app: AXUIElement) {
    AXUIElementSetAttributeValue(app, "AXEnhancedUserInterface" as CFString, kCFBooleanTrue)
    AXUIElementSetAttributeValue(app, "AXManualAccessibility" as CFString, kCFBooleanTrue)
}

/// A conferencing app we are currently watching.
struct Attachment {
    let meetingApp: MeetingApp
    let pid: pid_t
    let element: AXUIElement
}

/// Unified per-pid wake bookkeeping: poke cooldowns, attempt counts, and
/// which pids' trees have filled in. One type serves both the detection loop
/// (TreeWaker) and an attached session's wake path.
struct WakeLedger {
    var attempts: [pid_t: Int] = [:]
    var nextAttempt: [pid_t: Date] = [:]
    private(set) var populated: Set<pid_t> = []

    /// Pure rate-limiter decision: should this pid be poked right now, and at
    /// what attempt count? Separate so tests can drive cooldown and attempt
    /// behavior with synthetic dates — no AX element involved. Clearing state
    /// only on genuine wake (not mere title-readability) keeps Teams'
    /// deadline from resetting every scan into a poke storm.
    mutating func pokeDecision(pid: pid_t, awake: Bool, now: Date) -> (poke: Bool, attempt: Int) {
        if awake {
            nextAttempt.removeValue(forKey: pid)
            attempts.removeValue(forKey: pid)
            return (false, 0)
        }
        guard now >= (nextAttempt[pid] ?? .distantPast) else {
            return (false, attempts[pid] ?? 0)
        }
        nextAttempt[pid] = now.addingTimeInterval(5)
        let attempt = (attempts[pid] ?? 0) + 1
        attempts[pid] = attempt
        return (true, attempt)
    }

    mutating func markPopulated(pid: pid_t) { populated.insert(pid) }
    func isPopulated(pid: pid_t) -> Bool { populated.contains(pid) }

    /// Drop bookkeeping for pids no longer running, so restarts start fresh
    /// instead of inheriting a stale cooldown/count. Callers MUST include any
    /// attached session's pid in `alive` unconditionally: a pid lookup can
    /// miss it transiently, and pruning its entry mid-hollow-period would
    /// reset the attempt-count math the "hollow for Ns" warnings depend on.
    mutating func prune(alive: Set<pid_t>) {
        attempts = attempts.filter { alive.contains($0.key) }
        nextAttempt = nextAttempt.filter { alive.contains($0.key) }
        populated = populated.intersection(alive)
    }
}

/// Wakes the accessibility trees of web-view apps and tracks readability.
/// Detection runs through here because the wake has to precede the anchor
/// search: a freshly launched Teams, Slack, or Meet exposes a hollow tree, and
/// the controls that say a call is happening only appear once it fills in.
struct TreeWaker {
    let quiet: Bool
    var ledger = WakeLedger()

    init(quiet: Bool) { self.quiet = quiet }

    /// True when the app's tree can be searched for a meeting. Web-content
    /// apps are poked (rate-limited) whenever their WebView still lacks DOM
    /// ids — even when the app already counts as readable another way, since
    /// captions need the full tree. Native apps are never poked.
    mutating func ensureReadable(_ attachment: Attachment, now: Date) -> Bool {
        let app = attachment.element
        // Native apps never need waking; answer without recursive DOM scanning
        // (a DOM-id probe is a full tree traversal, too costly per poll).
        guard attachment.meetingApp.rendersWebContent else {
            return attachment.meetingApp.treeReadiness(app) != .unreadable
        }
        // Once a pid's WebView has populated, it does not go hollow without
        // the process restarting (which prunes this entry). Re-scanning every
        // node Slack or Teams has ever rendered, every two seconds, was the
        // other half of the idle CPU — the DOM-id probe is a full walk.
        let awake: Bool
        if ledger.isPopulated(pid: attachment.pid) {
            awake = true
        } else {
            awake = attachment.meetingApp.webTreeIsAwake(app)
            if awake { ledger.markPopulated(pid: attachment.pid) }
        }
        let (poke, attempt) = pokeDecision(pid: attachment.pid, awake: awake, now: now)
        if poke {
            pokeWebTree(app)
            if !quiet, attempt <= 3 {
                status("asked \(attachment.meetingApp.displayName) to expose its accessibility tree (attempt \(attempt))")
            } else if attempt == 4 || attempt % 12 == 0, !quiet {
                status("\(attachment.meetingApp.displayName)'s accessibility tree has stayed hollow for \(attempt * 5)s; captions cannot be read. Check Accessibility permission for meeting-capture-daemon, or restart \(attachment.meetingApp.displayName)")
            }
        }
        if awake { return true }
        // Hollow WebView: Teams can still detect a meeting from the native
        // window title; everyone else is unreadable until the tree fills in.
        return attachment.meetingApp.treeReadiness(app) != .unreadable
    }

    /// Pure rate-limiter behind ensureReadable: should this pid be poked right
    /// now, and at what attempt count? Separate so tests can drive cooldown
    /// and attempt behavior with synthetic dates — no AX element involved.
    mutating func pokeDecision(pid: pid_t, awake: Bool, now: Date) -> (poke: Bool, attempt: Int) {
        ledger.pokeDecision(pid: pid, awake: awake, now: now)
    }

    mutating func prune(alive: Set<pid_t>) { ledger.prune(alive: alive) }
}

// MARK: - Roster parsing (pure; the People panel drives the AX side)

/// The participant count, read from the roster panel's title row — "In this
/// meeting (293)" as a StaticText value, or "In this meeting, 293 total" as
/// the section's description. The People button itself carries no number in
/// the tree, so this title row is the only count the AX side ever gets.
func rosterCount(from candidates: [String]) -> Int? {
    for text in candidates {
        if let range = text.range(of: "\\((\\d+)\\)", options: .regularExpression) {
            let digits = text[text.index(range.lowerBound, offsetBy: 1)..<text.index(range.upperBound, offsetBy: -1)]
            if let n = Int(digits) { return n }
        }
    }
    for text in candidates {
        if let range = text.range(of: "(\\d+) total", options: .regularExpression) {
            let upTo = text.index(range.upperBound, offsetBy: -" total".count)
            if let n = Int(text[range.lowerBound..<upTo]) { return n }
        }
    }
    return nil
}

private let rosterStateWords: Set<String> = ["Muted", "Unmuted", "Organizer",
    "Speaking", "Sharing", "Presenting", "Pinned", "Spotlighted", "On hold"]

/// A row's description is "<Name>[, <state>]…" — "Allen, Mary Catherine,
/// Organizer, Muted". The trailing states are chips, not parts of the name;
/// strip as many as trail. A name is whatever is left.
func bareName(from description: String) -> String {
    var parts = description.components(separatedBy: ", ")
    while let last = parts.last, rosterStateWords.contains(last) { parts.removeLast() }
    return parts.joined(separator: ", ")
}

/// Teams paginates a long roster twice: first "See more", then "+203 more"
/// (the number shrinks as pages are added). Both labels are StaticTexts inside
/// an outline row, not buttons.
func isRosterPager(_ text: String) -> Bool {
    if text == "See more" { return true }
    return text.range(of: "^\\+\\d+ more$", options: .regularExpression) != nil
}

func rosterPagerRemaining(_ text: String) -> Int? {
    guard text.hasPrefix("+"), text.hasSuffix(" more") else { return nil }
    return Int(text.dropFirst().dropLast(" more".count))
}

/// One person on the roster. `key` is the DOM id's tail after
/// `calling-roster-item-` — the participant's identity as Teams sees it, used
/// to dedup when the list re-renders while it is being read.
struct RosterPerson {
    let name: String
    let key: String
}

/// Who the People panel listed, and whether that is everyone.
struct RosterSnapshot {
    let people: [RosterPerson]
    /// The head count the panel's own title row claims, when it exposes one.
    let expected: Int?
    /// True only when the names we loaded match the count Teams printed. A
    /// roster is never presented as complete on our say-so.
    var confirmed: Bool { expected == people.count }

    /// The one transcript line a snapshot becomes. Everything the reader needs
    /// is in it: how many, whether that is the whole room, and who.
    static func headline(count: Int, expected: Int?) -> String {
        var head = "\(count) in the meeting"
        if let expected, expected != count {
            head += " (roster says \(expected); \(count) loaded)"
        } else if expected != nil {
            head += " (confirmed)"
        }
        return head
    }

    static func summary(names: [String], expected: Int?) -> String {
        let head = headline(count: names.count, expected: expected)
        return names.isEmpty ? head : head + ": " + names.joined(separator: ", ")
    }

    var headline: String { RosterSnapshot.headline(count: people.count, expected: expected) }
}

/// Why a roster attempt produced no snapshot. The distinction is what keeps
/// the daemon from burning its few attempts on moments that were never going
/// to work — a deferral is "not now", a failure is "this did not work".
enum RosterOutcome {
    case captured(RosterSnapshot)
    case deferred(String)
    case failed(String)
}

/// Everyone the panel is showing RIGHT NOW. Rows are keyed by their
/// `calling-roster-item-*` DOM id, so re-renders dedup rather than double.
/// The name comes from the avatar's StaticText, which is the bare name; the
/// row's own description trails state chips ("Muted", "Organizer").
func rosterPeople(in panel: AXUIElement) -> [RosterPerson] {
    var seen = Set<String>()
    var people: [RosterPerson] = []
    func scanAvatar(_ e: AXUIElement, _ depth: Int, _ name: inout String) {
        guard depth < 15, name.isEmpty else { return }
        if axDomID(e).hasPrefix("roster-avatar-img-") {
            for text in axStaticTexts(e) where !text.isEmpty { name = text; return }
        }
        for child in axChildren(e) { scanAvatar(child, depth + 1, &name) }
    }
    func scan(_ e: AXUIElement, _ depth: Int) {
        guard depth < 60 else { return }
        let domid = axDomID(e)
        if domid.hasPrefix("calling-roster-item-") {
            let key = String(domid.dropFirst("calling-roster-item-".count))
            if !seen.contains(key) {
                seen.insert(key)
                var name = ""
                scanAvatar(e, 0, &name)
                if name.isEmpty { name = bareName(from: axDescription(e)) }
                if !name.isEmpty { people.append(RosterPerson(name: name, key: key)) }
            }
            return // rows do not nest rows
        }
        for child in axChildren(e) { scan(child, depth + 1) }
    }
    scan(panel, 0)
    return people
}

func axActionNames(_ element: AXUIElement) -> [String] {
    var names: CFArray?
    guard AXUIElementCopyActionNames(element, &names) == .success else { return [] }
    return names as? [String] ?? []
}

func rosterPanel(in window: AXUIElement) -> AXUIElement? {
    findElement(from: window, where: { axDescription($0) == "Participants" })
}

/// The long roster's paginator is not a button. It is an AXStaticText reading
/// "See more", then "+203 more", inside a Fluent TreeItem row.
func rosterPager(in panel: AXUIElement) -> (element: AXUIElement, text: String)? {
    guard let element = findElement(from: panel, where: {
        isRosterPager(axString($0, kAXValueAttribute))
    }) else { return nil }
    return (element, axString(element, kAXValueAttribute))
}

func rosterCount(in panel: AXUIElement) -> Int? {
    guard let title = findElement(from: panel, where: {
        axDomID($0).hasPrefix("roster-title-section")
    }) else { return nil }
    return rosterCount(from: [axDescription(title)] + axStaticTexts(title))
}

/// One overlapping virtualized-list step. Pixel wheel deltas are what
/// Chromium accepts; line deltas changed clipping without advancing rows.
func scrollRoster(_ panel: AXUIElement, direction: Int32) {
    let root = findElement(from: panel, where: { axDescription($0) == "Attendees" }) ?? panel
    let (origin, size) = axFrame(root)
    let point = CGPoint(x: origin.x + size.width / 2, y: origin.y + size.height * 0.6)
    let source = CGEventSource(stateID: .combinedSessionState)
    CGEvent(mouseEventSource: source, mouseType: .mouseMoved,
            mouseCursorPosition: point, mouseButton: .left)?.post(tap: .cghidEventTap)
    usleep(150_000)
    for _ in 0..<2 {
        let wheel = CGEvent(scrollWheelEvent2Source: source, units: .pixel,
                            wheelCount: 1, wheel1: direction * 350, wheel2: 0, wheel3: 0)
        wheel?.location = point
        wheel?.post(tap: .cghidEventTap)
        usleep(120_000)
    }
}

/// Ask the paginator for another page. AXPress works on the first See-more
/// row; later +N-more rows sometimes report a false success, so verify the
/// remaining number and fall back to a real click on the nearest pressable
/// ancestor. A success is a disappearing label or a smaller remainder.
func pressRosterPager(_ pager: (element: AXUIElement, text: String),
                      panel: AXUIElement, window: AXUIElement, pid: pid_t) -> Bool {
    func progressed() -> Bool {
        guard let after = rosterPager(in: panel) else { return true }
        if after.text != pager.text {
            if let before = rosterPagerRemaining(pager.text),
               let remaining = rosterPagerRemaining(after.text) {
                return remaining < before
            }
            return true
        }
        return false
    }
    var row: AXUIElement? = pager.element
    while let element = row,
          axString(element, kAXRoleAttribute) != kAXRowRole {
        row = axParent(element)
    }
    if let row {
        AXUIElementPerformAction(row, kAXPressAction as CFString)
        usleep(1_000_000)
        if progressed() { return true }
    }
    var pressable: AXUIElement? = pager.element
    while let element = pressable,
          !axActionNames(element).contains(kAXPressAction) {
        pressable = axParent(element)
    }
    guard let pressable else { return false }
    bringToFront(pid: pid, window: window)
    let (origin, size) = axFrame(pressable)
    clickThroughWindowServer(at: CGPoint(x: origin.x + size.width / 2,
                                         y: origin.y + size.height / 2))
    usleep(1_200_000)
    return progressed()
}

/// Read the whole Teams roster: open the People panel, expand every page,
/// accumulate each overlapping virtualized viewport by participant key, and
/// put the window size, panel state, pointer and frontmost app back.
///
/// Only a roster too long to render needs the expensive half. A meeting whose
/// loaded rows already match the head count is read from one still panel — no
/// resizing, no scrolling, nothing on screen but a panel opening and closing.
///
/// `deadline` bounds the paging loop, so a 300-person roster cannot run for
/// the length of the meeting: whatever was loaded by then is returned, and
/// says honestly that it is short.
func captureTeamsRoster(pid: pid_t, deadline: Date? = nil) -> RosterOutcome {
    // Clicks and pointer moves are global state; two of them at once would
    // land in each other's windows (see UIAutomation). Wait a few seconds for
    // a turn rather than spending an attempt: the poll loop takes this lock
    // constantly, and one-shot contention starved the snapshot completely.
    guard UIAutomation.enter(waitingUntil: Date().addingTimeInterval(5)) else {
        return .deferred("another automated interaction is already running")
    }
    defer { UIAutomation.leave() }

    let app = AXUIElementCreateApplication(pid)
    AXUIElementSetMessagingTimeout(app, 8.0)
    // A just-joined Teams can expose window chrome before the WebView controls.
    var meetingWindow: AXUIElement?
    for _ in 0..<8 where meetingWindow == nil {
        meetingWindow = axWindows(app).first(where: {
            findElement(from: $0, where: { axDomID($0) == "hangup-button" }) != nil
        })
        if meetingWindow == nil { pokeWebTree(app); usleep(500_000) }
    }
    guard let window = meetingWindow else {
        return .failed("no Microsoft Teams meeting is running")
    }
    // Clicking a window on another Space would drag the user's screen over to
    // it. Wait for a moment when the window is actually here.
    guard windowLayer(pid: pid, frame: axFrame(window)) != nil else {
        return .deferred("the meeting window is not on this Space")
    }

    let priorApp = NSWorkspace.shared.frontmostApplication
    let priorPointer = CGEvent(source: nil)?.location
    let originalSize = axFrame(window).size
    let panelExisted = rosterPanel(in: window) != nil
    var resized = false
    var mustClosePanel = false

    func togglePanel() {
        guard let roster = findElement(from: window, where: {
            axDomID($0) == "roster-button"
        }) else { return }
        bringToFront(pid: pid, window: window)
        let (origin, size) = axFrame(roster)
        clickThroughWindowServer(at: CGPoint(x: origin.x + size.width / 2,
                                             y: origin.y + size.height / 2))
        usleep(700_000)
    }
    // Every exit path leaves the meeting exactly as it was found.
    defer {
        if resized { axSetSize(window, originalSize); usleep(400_000) }
        if mustClosePanel, rosterPanel(in: window) != nil { togglePanel() }
        if let priorPointer {
            CGEvent(mouseEventSource: nil, mouseType: .mouseMoved,
                    mouseCursorPosition: priorPointer, mouseButton: .left)?.post(tap: .cghidEventTap)
        }
        restoreFrontmost(priorApp)
    }

    // Reset an already-open panel to its top: its title/count may have been
    // virtualized away, and the user's scroll position is unknowable.
    if panelExisted {
        togglePanel()
        for _ in 0..<6 where rosterPanel(in: window) != nil { usleep(300_000) }
    }
    var opened = false
    for _ in 0..<3 where !opened {
        togglePanel()
        for _ in 0..<8 {
            if rosterPanel(in: window) != nil { opened = true; break }
            usleep(350_000)
        }
    }
    guard opened, var panel = rosterPanel(in: window) else {
        return .failed("the People panel did not open")
    }
    // Leave it open only if that is how it was found.
    mustClosePanel = !panelExisted

    var expected = rosterCount(in: panel)
    var people: [RosterPerson] = []
    var seen = Set<String>()
    @discardableResult
    func mergeViewport() -> Int {
        let before = seen.count
        for person in rosterPeople(in: panel) where seen.insert(person.key).inserted {
            people.append(person)
        }
        return seen.count - before
    }
    mergeViewport()

    if expected == nil || people.count < expected! {
        // The paginator sits just below the last rendered row and is otherwise
        // clipped away. Grow to the bottom of this display to reveal it.
        let windowFrame = axFrame(window)
        if let display = displayBounds().first(where: {
            $0.contains(CGPoint(x: windowFrame.origin.x + windowFrame.size.width / 2,
                                y: windowFrame.origin.y + windowFrame.size.height / 2))
        }), display.maxY - windowFrame.origin.y > originalSize.height {
            resized = axSetSize(window, CGSize(width: originalSize.width,
                                               height: display.maxY - windowFrame.origin.y))
            usleep(800_000)
            panel = rosterPanel(in: window) ?? panel
            mergeViewport()
        }

        // Down through all pages. Each wheel step overlaps the previous
        // viewport, so no row can fall through the cracks; at page boundaries
        // the pager is pressed and its progress verified before continuing.
        var stale = 0
        for _ in 0..<200 {
            if let expected, seen.count >= expected { break }
            if let deadline, Date() >= deadline { break }
            if let pager = rosterPager(in: panel),
               pressRosterPager(pager, panel: panel, window: window, pid: pid) {
                stale = 0
                mergeViewport()
                continue
            }
            scrollRoster(panel, direction: -1)
            usleep(450_000)
            stale = mergeViewport() == 0 ? stale + 1 : 0
            if stale >= 3 { break }
        }

        // Walk back to the top: catches any row the renderer swapped during
        // the downward pass, and brings the title row back into the tree.
        stale = 0
        for _ in 0..<80 where stale < 3 {
            scrollRoster(panel, direction: 1)
            usleep(300_000)
            stale = mergeViewport() == 0 ? stale + 1 : 0
        }
        expected = rosterCount(in: panel) ?? expected
    }

    people.sort { $0.name.localizedCaseInsensitiveCompare($1.name) == .orderedAscending }
    guard !people.isEmpty else { return .failed("the People panel listed nobody") }
    return .captured(RosterSnapshot(people: people, expected: expected))
}

// MARK: - Microsoft Teams

/// Teams renders its UI in a Chromium WebView, which exposes DOM ids and class
/// lists through the accessibility tree, so we can anchor on those.
///
/// A class rather than a struct because keeping captions readable is stateful:
/// see maintainCaptionSurface.
final class TeamsApp: MeetingApp {
    let id = "teams"
    let displayName = "Microsoft Teams"
    let processPattern = "Microsoft Teams.app/Contents/MacOS/MSTeams"
    let captionPressToggles = true
    // The People panel lists everyone, expandable page by page — with real
    // clicks, because Teams' WebView ignores AXPress (captureTeamsRoster).
    let supportsRosterSnapshot = true
    func captureRoster(pid: pid_t, deadline: Date?) -> RosterOutcome {
        captureTeamsRoster(pid: pid, deadline: deadline)
    }
    // Teams 2 is Edge WebView2, so its tree starts switched off.
    let rendersWebContent = true
    // Teams keeps ~3 lines on screen; without this, --follow sees nothing
    // until they scroll away.
    var idleFinalizeSeconds: TimeInterval? { 6 }

    /// Caption entries are groups of [speaker, text] carrying this class.
    private let captionEntryClass = "fui-ChatMessageCompact__body"
    /// Chrome that exists whenever the captions panel is up, even while idle.
    private let captionPanelIDs: Set<String> = [
        "captions-panel-dismiss-button",
        "closed-captions-pop-out-button",
        "captions-settings-menu-trigger-button-non-overflow"
    ]
    /// The captions panel's "Pop out" control. Teams folds it into an overflow
    /// menu ("closed-captions-overflow-menu-button") when the window is narrow,
    /// and that menu cannot be opened through accessibility — hence the
    /// widen-then-click dance in popOutCaptions.
    private let popOutButtonID = "closed-captions-pop-out-button"
    /// Teams: the chat panel's header, and the button in it that moves the
    /// panel into a window of its own. That button has no DOM id and its
    /// description ("Open in new window") is localized, so it is identified
    /// structurally: the header's other direct child button is the one that
    /// closes the panel, and that one does have an id.
    private let chatPanelID = "message-pane-layout-a11y"
    private let chatCloseButtonID = "rail-header-close-button"
    /// Opens the chat panel in the meeting window.
    private let chatButtonID = "chat-button"
    /// A rendered chat message. The panel can be open with none of them yet.
    private let chatBodyClass = "fui-ChatMessage__body"
    /// The pop-out window's pin (⌃⌘T) control. Teams pops the window out
    /// pinned; see unpin for why it doesn't stay that way.
    private let pinButtonID = "window-always-on-top-button"
    /// Width at which Teams shows the pop-out control rather than folding it away.
    private let popOutRevealWidth: CGFloat = 1250

    // --- keeping a covered meeting readable (see maintainCaptionSurface) ---
    /// Last value of the call timer, and when it last changed. A frozen timer
    /// is how a parked window announces itself.
    private var lastClock = ""
    private var clockChangedAt = Date.distantPast
    private var warnedStalledAt = Date.distantPast
    private var popOutAttempts = 0
    private var nextPopOutAttempt = Date.distantPast
    private var handledCaptionsWindow = false
    private var chatPopOutAttempts = 0
    private var nextChatPopOutAttempt = Date.distantPast
    private var warnedMinimized = false

    /// Meeting-only chrome. hangup-button is the obvious one, but Teams'
    /// WebView can take minutes to expose the full toolbar; the call timer
    /// often appears first and is just as reliable.
    private let meetingAnchorIDs: Set<String> = ["hangup-button", "call-duration-custom"]

    func meetingAnchor(_ app: AXUIElement) -> AXUIElement? {
        if let chrome = findElement(from: app, where: { meetingAnchorIDs.contains(axDomID($0)) }) {
            return chrome
        }
        // Teams often takes minutes to put the WebView in the accessibility
        // tree (229 native nodes, zero DOM ids). The window title still says
        // "Meeting with …" for a 1:1 call, which is enough to start and to
        // press the captions shortcut.
        return meetingWindow(app)
    }

    /// 1:1 calls are titled "Meeting with Name (Org) | Microsoft Teams".
    /// Chat windows use the person's name without that prefix, so this stays
    /// off when you are just messaging.
    private func meetingWindow(_ app: AXUIElement) -> AXUIElement? {
        let windows = axAttribute(app, kAXWindowsAttribute) as? [AXUIElement] ?? []
        return windows.first { window in
            let title = axString(window, kAXTitleAttribute)
                .replacingOccurrences(of: "| Microsoft Teams", with: "")
                .trimmingCharacters(in: .whitespaces)
            return title.hasPrefix("Meeting with ")
        }
    }

    /// Readable once DOM ids show up — OR once a meeting window is titleable:
    /// the WebView can stay hollow for minutes while the native window already
    /// says "Meeting with …", which meetingAnchor works from. Detection must
    /// not wait for the WebView; only caption reading does (see wakeTreeIfNeeded).
    func treeReadiness(_ app: AXUIElement) -> TreeReadiness {
        if webTreeAwake(app) { return .webContent }
        return meetingWindow(app) != nil ? .meetingChrome : .unreadable
    }

    let reportsMeetingClock = true

    /// Teams paints the ticking clock as a child AXStaticText ("31:01").
    /// The group's title ("Elapsed time 21:54") is frozen at first render.
    func reportedElapsedSeconds(_ app: AXUIElement) -> TimeInterval? {
        guard let clock = findElement(from: app, where: { axDomID($0) == "call-duration-custom" }) else {
            return nil
        }
        if let elapsed = Self.parseClock(axStaticTexts(clock).joined(separator: " ")) { return elapsed }
        return Self.parseClock(axString(clock, kAXTitleAttribute))
    }

    private static func parseClock(_ raw: String) -> TimeInterval? { parseMeetingClock(raw) }

    func meetingTitle(_ app: AXUIElement, anchor: AXUIElement?) -> String {
        var title = ""
        if let anchor, let windowTitle = windowTitle(containing: anchor) { title = windowTitle }
        if title.isEmpty { title = firstWindowTitle(app) }
        title = TeamsApp.stripChrome(title, siblings: axWindows(app).map { axString($0, kAXTitleAttribute) })
        return title.isEmpty ? "Teams meeting" : title
    }

    /// The meeting's own name, given one window's title and every other Teams
    /// window's.
    ///
    /// Teams' side windows label themselves by putting a word in FRONT of the
    /// meeting title: "Meeting compact view | Standup | Microsoft Teams",
    /// "Captions | Standup | Microsoft Teams". That matters because when the
    /// meeting window is covered the anchor is found in the compact view, and
    /// its label would become the transcript's name.
    ///
    /// The label is localized, so it can't be matched by name, and splitting
    /// on " | " is wrong for a meeting called "Roadmap | Q3". Instead: the
    /// meeting window titles itself with the bare meeting name, so among the
    /// sibling titles the shortest one that is a suffix of this one is it.
    static func stripChrome(_ title: String, siblings: [String]) -> String {
        func cleaned(_ text: String) -> String {
            text.replacingOccurrences(of: "| Microsoft Teams", with: "")
                .trimmingCharacters(in: .whitespaces)
        }
        let base = cleaned(title)
        var shortest = base
        for sibling in siblings {
            let candidate = cleaned(sibling)
            guard !candidate.isEmpty, candidate.count < shortest.count,
                  base.hasSuffix(candidate) else { continue }
            shortest = candidate
        }
        return shortest
    }

    private func isCaptionEntry(_ element: AXUIElement) -> Bool {
        axClasses(element).contains(captionEntryClass)
    }

    /// The captions list is simply the parent of the caption entries.
    ///
    /// The popped-out window is preferred over the in-window panel. When
    /// another window completely covers the meeting window, Teams stops
    /// updating it but leaves the whole panel in the accessibility tree, so
    /// the frozen copy reads as a live one; the popped-out window keeps
    /// running (its captions arrive independently of that renderer).
    func captionsContainer(_ app: AXUIElement) -> AXUIElement? {
        if let window = captionsWindow(app),
           let entry = findElement(from: window, where: isCaptionEntry) {
            return axParent(entry)
        }
        return findElement(from: app, where: isCaptionEntry).flatMap(axParent)
    }

    /// The captions panel after it has been popped out into its own window.
    /// Found by content rather than by its "Captions | …" title, which is
    /// localized: any non-standard window holding caption rows is it. (The
    /// compact view Teams shows when the meeting window is hidden is also a
    /// non-standard window, but it carries no captions.)
    private func captionsWindow(_ app: AXUIElement) -> AXUIElement? {
        axWindows(app).first { window in
            axString(window, kAXSubroleAttribute) != "AXStandardWindow"
                && findElement(from: window, where: isCaptionEntry) != nil
        }
    }

    /// The ordinary meeting window — the one with the toolbar and the timer.
    /// Matched by the hangup button rather than by being a standard window,
    /// because the popped-out chat is a standard window too, and widening or
    /// measuring the wrong one would be a mess.
    private func standardWindow(_ app: AXUIElement) -> AXUIElement? {
        axWindows(app).first { window in
            axString(window, kAXSubroleAttribute) == "AXStandardWindow"
                && findElement(from: window, where: { axDomID($0) == "hangup-button" }) != nil
        }
    }

    /// The meeting chat after it has been popped out. Unlike the captions
    /// window this one IS a standard window, and its title is the meeting's
    /// own, so it is told apart by content: chat messages, no hangup button.
    private func chatWindow(_ app: AXUIElement) -> AXUIElement? {
        axWindows(app).first { window in
            findElement(from: window, where: { axDomID($0) == "hangup-button" }) == nil
                && findElement(from: window, where: { axClasses($0).contains(chatBodyClass) }) != nil
        }
    }

    func captionEntries(in container: AXUIElement) -> [CaptionEntry] {
        axChildren(container).compactMap { entry in
            guard isCaptionEntry(entry) else { return nil }
            let texts = axStaticTexts(entry)
            guard texts.count >= 2 else { return nil }
            let id = axNodeID(entry)
            guard !id.isEmpty else { return nil }
            return CaptionEntry(id: id, speaker: texts[0], text: texts.dropFirst().joined(separator: " "))
        }
    }

    /// True while the captions panel is up, in the window or popped out of it.
    /// Missing the popped-out case would read as "captions are off" and make
    /// --auto-captions press ⇧⌘A, switching them off for real.
    func captionsPanelOpen(_ app: AXUIElement) -> Bool {
        if captionsWindow(app) != nil { return true }
        return findElement(from: app) { captionPanelIDs.contains(axDomID($0)) } != nil
    }

    /// Teams stops updating a meeting window that is COMPLETELY covered by
    /// another window: the call timer freezes, the caption rows stop arriving,
    /// and the transcript quietly stops. (macOS reports the window as
    /// occluded; Teams parks it and puts up the small "compact view" instead.
    /// A single visible pixel is enough to keep it running, and it resumes the
    /// moment any of it shows again.)
    ///
    /// The way out is the captions panel's own window: it goes on rendering
    /// while the meeting window is parked, because caption text does not come
    /// from that renderer. So pop it out and park it out of the way on the
    /// second display. Without --popout-captions, say what is happening rather
    /// than let the transcript trail off in silence.
    func maintainSurfaces(_ app: AXUIElement, pid: pid_t, now: Date,
                          popOutCaptions: Bool, popOutChat: Bool) {
        maintainCaptionSurface(app, pid: pid, now: now, popOut: popOutCaptions)
        guard popOutChat else { return }
        maintainChatSurface(app, pid: pid, now: now)
    }

    private func maintainCaptionSurface(_ app: AXUIElement, pid: pid_t, now: Date, popOut: Bool) {
        if let window = captionsWindow(app) {
            // Every poll, because it can be minimized at any moment and a
            // minimized window receives nothing at all.
            unminimize(window)
            guard !handledCaptionsWindow else { return }
            handledCaptionsWindow = true
            unpin(window, pid: pid)
            tuck(window)
            return
        }
        guard popOut else { return warnIfStalled(app, now: now) }
        // Nothing to pop out until the panel exists.
        guard findElement(from: app, where: { captionPanelIDs.contains(axDomID($0)) }) != nil
            || findElement(from: app, where: isCaptionEntry) != nil else { return }
        guard popOutAttempts < 2, now >= nextPopOutAttempt else { return }
        popOutAttempts += 1
        nextPopOutAttempt = now.addingTimeInterval(60)
        popOutCaptions(app, pid: pid)
    }

    /// Chat is a panel nobody has to open, and an unopened panel records
    /// nothing at all — so with --popout-chat the meeting chat is opened and
    /// moved into a window of its own. It is read from there in preference to
    /// the in-meeting panel, which stops updating along with the rest of a
    /// covered meeting window.
    ///
    /// Unlike the captions window this one is left in plain sight: chat is
    /// something you read and reply to during a meeting, so hiding it would
    /// take away the panel it just opened.
    private func maintainChatSurface(_ app: AXUIElement, pid: pid_t, now: Date) {
        if let window = chatWindow(app) {
            unminimize(window)
            return
        }
        guard chatPopOutAttempts < 2, now >= nextChatPopOutAttempt else { return }
        chatPopOutAttempts += 1
        nextChatPopOutAttempt = now.addingTimeInterval(60)
        popOutChat(app, pid: pid)
    }

    /// Open the chat panel if it is closed, then press the button in its
    /// header that gives it a window. Both are real clicks for the same
    /// reason as the captions pop-out: Teams' WebView ignores AXPress.
    private func popOutChat(_ app: AXUIElement, pid: pid_t) {
        let priorPointer = CGEvent(source: nil)?.location
        let priorApp = bringToFront(pid: pid, window: standardWindow(app))
        defer {
            if let priorPointer {
                CGEvent(mouseEventSource: nil, mouseType: .mouseMoved,
                        mouseCursorPosition: priorPointer, mouseButton: .left)?.post(tap: .cghidEventTap)
            }
            restoreFrontmost(priorApp)
        }

        var panel = findElement(from: app) { axDomID($0) == chatPanelID }
        if panel == nil {
            guard let chatButton = findElement(from: app, where: { axDomID($0) == chatButtonID })
            else { return }
            press(chatButton)
            for _ in 0..<10 where panel == nil {
                usleep(400_000)
                panel = findElement(from: app) { axDomID($0) == chatPanelID }
            }
        }
        guard let panel else {
            status("could not open Teams' meeting chat; chat will only be recorded if you open the panel yourself")
            return
        }
        // The header holds two buttons: this one and the one that closes the
        // panel. Only the latter has an id, so the other one is the pop-out.
        guard let button = axChildren(panel).first(where: {
            axString($0, kAXRoleAttribute) == "AXButton" && axDomID($0) != chatCloseButtonID
        }) else {
            status("could not find Teams' chat pop-out control; chat will be read from the meeting window")
            return
        }
        press(button)
        for _ in 0..<12 {
            usleep(500_000)
            guard chatWindow(app) != nil else { continue }
            status("opened Teams' meeting chat in its own window")
            return
        }
    }

    /// Click an element where it sits on screen.
    private func press(_ element: AXUIElement) {
        let (origin, size) = axFrame(element)
        clickThroughWindowServer(at: CGPoint(x: origin.x + size.width / 2,
                                             y: origin.y + size.height / 2))
    }

    /// Tuck a pop-out window off the edge of the second display, leaving a
    /// nub of it on screen. It does not need to be visible to work — measured
    /// on a live call, 620x360 with a 40x40 corner showing produced captions
    /// without a gap — but it does need to be OPEN, so this is as far out of
    /// the way as it can go. Done once, so dragging it back is respected.
    private func tuck(_ window: AXUIElement) {
        let size = axFrame(window).size
        guard let origin = tuckOrigin(windowSize: size, displays: displayBounds()) else { return }
        axSetPosition(window, origin)
    }

    /// Un-minimize the captions window, and say why once.
    ///
    /// Minimizing is the one thing that really does stop it. Being covered is
    /// survivable; being in the Dock is not — measured on a live call, the
    /// rows sat frozen for 30 seconds and jumped from 4 to 12 the instant the
    /// window came back. Nothing about the tree says so meanwhile: the stale
    /// rows stay readable, so the daemon would write a silent meeting.
    private func unminimize(_ window: AXUIElement) {
        guard (axAttribute(window, kAXMinimizedAttribute) as? NSNumber)?.boolValue == true else { return }
        AXUIElementSetAttributeValue(window, kAXMinimizedAttribute as CFString, kCFBooleanFalse)
        if !warnedMinimized {
            warnedMinimized = true
            status("reopened Teams' captions window: minimized, it stops receiving captions altogether")
        }
    }

    /// Press the panel's "Pop out", putting the pointer, the window width and
    /// the front app back afterwards. Takes a few seconds and blocks the poll
    /// loop, which is why maintainCaptionSurface only allows two tries.
    private func popOutCaptions(_ app: AXUIElement, pid: pid_t) {
        guard let window = standardWindow(app) else { return }
        let priorPointer = CGEvent(source: nil)?.location
        let priorApp = bringToFront(pid: pid, window: window)
        let originalSize = axFrame(window).size
        var widened = false
        var button = findElement(from: app) { axDomID($0) == popOutButtonID }
        if button == nil, originalSize.width < popOutRevealWidth {
            // Narrow window: the control is in an overflow menu accessibility
            // cannot open, so make room for it and put the width back after.
            widened = axSetSize(window, CGSize(width: popOutRevealWidth, height: originalSize.height))
            for _ in 0..<8 where button == nil {
                usleep(400_000)
                button = findElement(from: app) { axDomID($0) == popOutButtonID }
            }
        }

        defer {
            if widened { axSetSize(window, originalSize) }
            if let priorPointer {
                CGEvent(mouseEventSource: nil, mouseType: .mouseMoved,
                        mouseCursorPosition: priorPointer, mouseButton: .left)?.post(tap: .cghidEventTap)
            }
            restoreFrontmost(priorApp)
        }

        guard let button else {
            status("could not find Teams' captions pop-out control; captions will pause whenever the meeting window is fully covered")
            return
        }
        let (origin, size) = axFrame(button)
        clickThroughWindowServer(at: CGPoint(x: origin.x + size.width / 2, y: origin.y + size.height / 2))
        for _ in 0..<12 {
            usleep(500_000)
            if let popped = captionsWindow(app) {
                handledCaptionsWindow = true
                unpin(popped, pid: pid)
                tuck(popped)
                status("moved Teams' captions into their own window, tucked off the edge of the second display; a covered meeting window can no longer pause them")
                return
            }
        }
    }

    /// Take the pin off the captions window. Teams pops it out floating above
    /// everything, which is in the way for no gain: unlike the meeting window,
    /// this one goes on rendering captions while completely covered — measured
    /// on a live call, with the meeting window parked at the same time — so it
    /// has no reason to be in front.
    ///
    /// Only ever pressed while the window is known to be PINNED, and the check
    /// is repeated before every press. The control is a toggle, so acting on a
    /// guess would pin a window that was fine; one the window server won't
    /// report on (on another Space) is left alone. The press is repeated once
    /// because the first click on a background window can be swallowed as the
    /// click that focuses it.
    ///
    /// The button only exists while the window is pinned — it IS the "Unpin"
    /// affordance — which is exactly when this needs it.
    private func unpin(_ window: AXUIElement, pid: pid_t) {
        let priorPointer = CGEvent(source: nil)?.location
        let priorApp = bringToFront(pid: pid, window: window)
        defer {
            if let priorPointer {
                CGEvent(mouseEventSource: nil, mouseType: .mouseMoved,
                        mouseCursorPosition: priorPointer, mouseButton: .left)?.post(tap: .cghidEventTap)
            }
            restoreFrontmost(priorApp)
        }
        for _ in 0..<2 {
            usleep(300_000)
            guard let layer = windowLayer(pid: pid, frame: axFrame(window)), layer > 0,
                  let button = findElement(from: window, where: { axDomID($0) == pinButtonID })
            else { return }
            let (origin, size) = axFrame(button)
            clickThroughWindowServer(at: CGPoint(x: origin.x + size.width / 2,
                                                 y: origin.y + size.height / 2))
        }
    }

    /// Warn — at most every ten minutes — when the call timer has stopped,
    /// which means Teams has parked the window and no captions are coming.
    private func warnIfStalled(_ app: AXUIElement, now: Date) {
        guard let window = standardWindow(app),
              let clock = findElement(from: window, where: { axDomID($0) == "call-duration-custom" })
        else { return }
        let reading = axStaticTexts(clock).joined(separator: " ")
        guard !reading.isEmpty else { return }
        if reading != lastClock {
            lastClock = reading
            clockChangedAt = now
            return
        }
        guard clockChangedAt != .distantPast,
              now.timeIntervalSince(clockChangedAt) > 10,
              now.timeIntervalSince(warnedStalledAt) > 600 else { return }
        warnedStalledAt = now
        status("Microsoft Teams has stopped updating its meeting window because another window covers it completely; captions are paused until part of it shows again. --popout-captions avoids this.")
    }

    func resetCaptureState() {
        lastClock = ""
        clockChangedAt = .distantPast
        warnedStalledAt = .distantPast
        popOutAttempts = 0
        nextPopOutAttempt = .distantPast
        handledCaptionsWindow = false
        warnedMinimized = false
        chatPopOutAttempts = 0
        nextChatPopOutAttempt = .distantPast
    }

    /// Teams' own shortcut (⇧⌘A), delivered straight to the process so it
    /// bypasses global event taps such as a Hammerspoon remap.
    func requestCaptions(pid: pid_t) -> CaptionRequest {
        let app = AXUIElementCreateApplication(pid)
        AXUIElementSetMessagingTimeout(app, 5.0)
        let prior = bringToFront(pid: pid, window: standardWindow(app))
        defer { usleep(250_000); restoreFrontmost(prior) }
        let source = CGEventSource(stateID: .privateState)
        let keyA: CGKeyCode = 0
        guard let down = CGEvent(keyboardEventSource: source, virtualKey: keyA, keyDown: true),
              let up = CGEvent(keyboardEventSource: source, virtualKey: keyA, keyDown: false) else {
            return .unreachable
        }
        down.flags = [.maskCommand, .maskShift]
        up.flags = [.maskCommand, .maskShift]
        down.postToPid(pid)
        up.postToPid(pid)
        return .pressed
    }

    /// The chat message list: the grandparent of any rendered message body.
    /// The popped-out window is preferred, for the same reason captions are
    /// read from theirs: the panel inside a covered meeting window can be a
    /// frozen copy of itself.
    func chatContainer(_ app: AXUIElement) -> AXUIElement? {
        func list(in root: AXUIElement) -> AXUIElement? {
            findElement(from: root, where: {
                axDomID($0).hasPrefix("message-body-") && axClasses($0).contains(chatBodyClass)
            }).flatMap { axParent($0).flatMap(axParent) }
        }
        if let window = chatWindow(app), let container = list(in: window) { return container }
        return list(in: app)
    }

    func chatMessages(in container: AXUIElement) -> [ChatMessage] {
        let rows = axChildren(container).suffix(20)
        return rows.compactMap { row -> ChatMessage? in
            let parts = axChildren(row)
            guard let body = parts.first(where: {
                axClasses($0).contains(chatBodyClass) && axDomID($0).hasPrefix("message-body-")
            }) else { return nil }
            let author = parts.first { axClasses($0).contains("fui-ChatMessage__author") }.map { axText($0) } ?? ""
            let text = axText(body).trimmingCharacters(in: .whitespacesAndNewlines)
            guard !text.isEmpty else { return nil }
            let id = String(axDomID(body).dropFirst("message-body-".count))
            return ChatMessage(id: id, author: author.isEmpty ? "Unknown" : author, text: text)
        }
    }
}

// MARK: - Slack

// Slack is Electron: its tree starts switched off until woken, and its
// controls then carry DOM ids ("captions" tab) or AXIdentifier-style labels;
// its caption overlay is found by class list. All serve as anchors.
final class SlackApp: MeetingApp {
    let id = "slack"
    let displayName = "Slack"
    let processPattern = "Slack.app/Contents/MacOS/Slack"
    // Slack is Electron, so its tree starts switched off.
    let rendersWebContent = true
    // Overlay events vanish when they are done, so absence means finished.
    // They also grow while being spoken, and Slack replaces the element each
    // time it does, so give an utterance time to settle before writing it:
    // finalizing early emits the partial, then the full line lands as a
    // second copy.
    var idleFinalizeSeconds: TimeInterval? { 8 }

    // The overlay is drawn over the video tiles only while there is something
    // to show, so it goes away during any pause. Absence means silence, not
    // that captions were switched off.
    var captionsSurfaceIsTransient: Bool { true }

    private let leaveDescription = "Leave Huddle"
    private let overlayClass = "p-huddle_closed_captions"
    private let overlayEventClass = "p-huddle_closed_caption_event__wrapper"
    private let settledMarker = "fade_out"

    /// Which utterance the live slot is holding, and what it last said. Slack
    /// swaps the element on every revision, so identity has to be tracked here
    /// rather than read off the tree.
    private var liveSequence = 0
    private var previousLiveText = ""
    /// Settled events carry no id at all, so they are identified by position in
    /// the huddle's whole conversation (see SegmentHistory) — hashing the text
    /// would collapse a repeated phrase into one utterance.
    private var history = SegmentHistory()

    /// A huddle gets its own window, and the Leave button only exists while
    /// one is up. Search that window only: walking the whole Slack workspace
    /// every two seconds, looking for a huddle that is not happening, is why
    /// a sitting-open Slack showed up as 10–27% of a core.
    func meetingAnchor(_ app: AXUIElement) -> AXUIElement? {
        guard let window = huddleWindow(app) else { return nil }
        return findElement(from: window) {
            axString($0, kAXRoleAttribute) == kAXButtonRole
                && axDescription($0) == leaveDescription
        }
    }

    /// The window is titled "Huddle: #channel - Workspace - Slack \u{1F3A4}". Keep the
    /// channel, drop the decoration.
    func meetingTitle(_ app: AXUIElement, anchor: AXUIElement?) -> String {
        guard let window = huddleWindow(app) else { return "Slack huddle" }
        var title = axString(window, kAXTitleAttribute)
        if let range = title.range(of: "Huddle: ") { title = String(title[range.upperBound...]) }
        // Trailing " - Workspace - Slack \u{1F3A4}" is chrome, not part of the name.
        if let dash = title.range(of: " - ", options: .backwards) { title = String(title[..<dash.lowerBound]) }
        title = title.trimmingCharacters(in: .whitespaces)
        return title.isEmpty ? "Slack huddle" : title
    }

    private func huddleWindow(_ app: AXUIElement) -> AXUIElement? {
        let windows = axAttribute(app, kAXWindowsAttribute) as? [AXUIElement] ?? []
        return windows.first { axString($0, kAXTitleAttribute).hasPrefix("Huddle:") }
    }

    private func captionsTab(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) {
            axDomID($0) == "captions" && axString($0, kAXRoleAttribute) == "AXRadioButton"
        }
    }

    /// Captions surface both in the side flexpane's captions tab and as an
    /// overlay on the video tiles, and we deliberately read only the overlay.
    ///
    /// The flexpane shows one tab at a time, so reading it would stop
    /// capturing the moment someone opened Threads. The overlay is there
    /// whichever tab is up, which is the whole point.
    ///
    /// Reading both is worse than reading either. Neither source has a stable
    /// identity \u2014 panel rows are a virtual list keyed by index, and Slack
    /// reuses an index when it merges consecutive utterances by one speaker,
    /// while overlay events are keyed by element hash and Slack replaces the
    /// element whenever the text grows. Two sources of unstable ids meant the
    /// same sentence was written once from each.
    func captionsContainer(_ app: AXUIElement) -> AXUIElement? {
        guard let window = huddleWindow(app) else { return nil }
        return findElement(from: window) { axClasses($0).contains(overlayClass) }
    }

    /// Slack shows no call clock in the huddle window.
    func reportedElapsedSeconds(_ app: AXUIElement) -> TimeInterval? { nil }

    /// Overlay events read [speaker, ":", text], the colon being its own node.
    ///
    /// They carry no id, and the element hash is useless as identity because
    /// Slack replaces the element every time the text changes \u2014 which it does
    /// constantly while speech is being recognised, revising words rather than
    /// only appending ("Kinda hard to fill" becomes "Kind of hard to fill
    /// her"). Keying on the hash wrote one line per revision, and prefix
    /// matching could not collapse them because a revision is not a prefix.
    ///
    /// The list is ordered oldest to newest and holds about five events, and
    /// Slack marks every settled one `fade_out`. So at most one event \u2014 the
    /// last \u2014 is still being spoken, and it is the only one that can change.
    /// Settled events therefore take positional ids (see SegmentHistory), and
    /// the live one keeps a single synthetic id across all its revisions so it
    /// lands as one utterance.
    func captionEntries(in container: AXUIElement) -> [CaptionEntry] {
        var settled: [(speaker: String, text: String)] = []
        var live: (speaker: String, text: String)?

        for item in axChildren(container) {
            let classes = axClasses(item)
            guard classes.contains(overlayEventClass) else { continue }
            let texts = axStaticTexts(item)
            guard texts.count >= 3 else { continue }
            let spoken = texts.dropFirst(2).joined(separator: " ")
                .trimmingCharacters(in: .whitespaces)
            guard !spoken.isEmpty else { continue }
            if classes.contains(where: { $0.contains(settledMarker) }) {
                settled.append((texts[0], spoken))
            } else {
                live = (texts[0], spoken)
            }
        }

        // Once the sentence the live slot was holding shows up settled, the
        // slot has moved on to a new utterance and must not keep the old id.
        // Checked against every settled event, including ones filtered out of
        // the result below.
        if !previousLiveText.isEmpty, settled.contains(where: { $0.text == previousLiveText }) {
            liveSequence += 1
            previousLiveText = ""
        }

        // Every settled event is reported, including one whose text also sits
        // in the live slot. Suppressing those looked like the way to avoid
        // writing a sentence twice, but the live slot is not a safe place to
        // have left it: if Slack settles an utterance with any edit at all,
        // the turnover above is missed, the live id is reused for the next
        // sentence, and the previous one is overwritten before it was ever
        // written out. Reporting both and letting the recorder collapse them
        // loses nothing when that happens.
        let base = history.absorb(settled.map { SegmentKey(speaker: $0.speaker, text: $0.text) })
        var entries = settled.enumerated().map {
            CaptionEntry(id: "seg:\(base + $0.offset)", speaker: $0.element.speaker, text: $0.element.text)
        }
        if let live {
            previousLiveText = live.text
            // Last, so the recorder treats it as the line still being spoken
            // and leaves it out of idle finalization.
            entries.append(CaptionEntry(id: "live:\(liveSequence)", speaker: live.speaker, text: live.text))
        }
        return entries
    }

    func resetCaptureState() {
        liveSequence = 0
        previousLiveText = ""
        history.reset()
    }

    // Settled events carry positional seg: ids that name one specific utterance
    // for life, so they must bypass the content dedup that guards against
    // re-rendering — otherwise saying the same short thing twice in thirty
    // seconds loses the second one. Only the synthetic live: id, which is
    // reused across revisions, needs that protection.
    func hasStableIdentity(_ id: String) -> Bool { id.hasPrefix("seg:") }

    func captionsPanelOpen(_ app: AXUIElement) -> Bool {
        captionsContainer(app) != nil
    }

    /// The control is a tab, not a toggle: selecting it starts captions and
    /// selecting it again is a no-op. But switching tabs is the user's
    /// business, so only reach for it when captions are nowhere to be found.
    /// If the overlay is up, captions are already running and whatever tab
    /// they are reading is left alone.
    func requestCaptions(pid: pid_t) -> CaptionRequest {
        let app = AXUIElementCreateApplication(pid)
        AXUIElementSetMessagingTimeout(app, 5.0)
        if captionsContainer(app) != nil { return .alreadyOn }
        guard let tab = captionsTab(app) else { return .unreachable }
        guard AXUIElementPerformAction(tab, kAXPressAction as CFString) == .success
        else { return .unreachable }
        return .pressed
    }
}

// MARK: - Zoom

/// Zoom is a native app, so there are no DOM ids, but it labels its controls
/// with AXIdentifier (`leave`, `captions`, `chat`) and its caption list with a
/// description, which serve the same purpose.
struct ZoomApp: MeetingApp {
    let id = "zoom"
    let displayName = "Zoom"
    let processPattern = "zoom.us.app/Contents/MacOS/zoom.us"

    private let captionTableDescription = "Closed caption subtitles"

    /// The End/Leave button exists only during a call.
    func meetingAnchor(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) { axIdentifier($0) == "leave" }
    }

    /// Every Zoom window is called "Zoom Meeting", so use the topic button in
    /// the title bar, which reads e.g. "Ada's Personal Meeting Room".
    func meetingTitle(_ app: AXUIElement, anchor: AXUIElement?) -> String {
        if let info = findElement(from: app, where: { axIdentifier($0) == "MeetingTopBarInfoButton" }) {
            let topic = axDescription(info).trimmingCharacters(in: .whitespaces)
            if !topic.isEmpty { return topic }
        }
        return "Zoom meeting"
    }

    func captionsContainer(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) { axDescription($0) == captionTableDescription }
    }

    /// Zoom keeps a clock in the title bar, described as "My connected time is
    /// 34:50" (or "1:34:50"). See reportedElapsedSeconds for what it does and doesn't
    /// measure; this flag tells the recorder lines may count from it.
    let reportsMeetingClock = true

    /// Returns seconds of participant-connection time shown in Zoom's title
    /// bar, or nil when the toolbar (and its clock) is hidden.
    func reportedElapsedSeconds(_ app: AXUIElement) -> TimeInterval? {
        guard let clock = findElement(from: app, where: {
            axDescription($0).hasPrefix("My connected time is")
        }) else { return nil }
        return parseMeetingClock(axDescription(clock))
    }

    /// Rows are AXRow > AXCell > [speaker, text]. Zoom hands out no ids, but
    /// the row elements themselves stay put, so their hash identifies them.
    func captionEntries(in container: AXUIElement) -> [CaptionEntry] {
        axChildren(container).compactMap { row in
            let texts = axStaticTexts(row)
            guard texts.count >= 2 else { return nil }
            return CaptionEntry(
                id: String(CFHash(row)),
                speaker: texts[0],
                text: texts.dropFirst().joined(separator: " ")
            )
        }
    }

    private func captionsButton(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) { axIdentifier($0) == "captions" }
    }

    private func overflowButton(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) { axIdentifier($0) == "more" }
    }

    /// In the overflow the control is an unidentified button described as e.g.
    /// "Show captions, 7 of 13, not pinned".
    private func overflowCaptionsItem(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) {
            axString($0, kAXRoleAttribute) == kAXButtonRole
                && axDescription($0).localizedCaseInsensitiveContains("captions")
                && axIdentifier($0) != "captions"
        }
    }

    @discardableResult
    private func press(_ element: AXUIElement) -> Bool {
        AXUIElementPerformAction(element, kAXPressAction as CFString) == .success
    }

    /// Zoom's caption list only exists while captions are on, which makes it a
    /// reliable signal — unlike the toolbar button, which vanishes with the
    /// toolbar whenever the pointer leaves the window.
    func captionsPanelOpen(_ app: AXUIElement) -> Bool {
        captionsContainer(app) != nil
    }

    /// No synthetic keystroke needed: the button is pressable, and its
    /// description says which way it will toggle. Two obstacles, though: the
    /// toolbar leaves the tree entirely when the pointer isn't over the window,
    /// and unless pinned, captions live in the More overflow.
    func requestCaptions(pid: pid_t) -> CaptionRequest {
        let app = AXUIElementCreateApplication(pid)
        AXUIElementSetMessagingTimeout(app, 5.0)

        // Zoom only puts captions in the toolbar once they are running, so a
        // pinned button that doesn't offer to show them means they are on.
        if let pinned = captionsButton(app) {
            guard axDescription(pinned).localizedCaseInsensitiveContains("show captions") else {
                return .alreadyOn
            }
            return press(pinned) ? .pressed : .unreachable
        }

        guard let more = overflowButton(app), press(more) else { return .unreachable }
        // The overflow is populated a moment after it opens.
        var item: AXUIElement?
        for _ in 0..<10 {
            usleep(100_000)
            if let found = overflowCaptionsItem(app) { item = found; break }
        }
        guard let item else {
            press(more) // put the overflow back the way we found it
            return .unreachable
        }
        guard axDescription(item).localizedCaseInsensitiveContains("show captions") else {
            press(more)
            return .alreadyOn
        }
        return press(item) ? .pressed : .unreachable // pressing an item closes the overflow
    }

    // Chat is skipped via the MeetingApp defaults: Zoom's chat panel is a
    // separate surface that has to be open to read; not wired up yet.

    // NOT finalizesWhenSuperseded, though rows do accumulate rather than being
    // cleared. When two people talk at once Zoom keeps a LIVE, still-growing
    // row per speaker, so "a newer row exists" does not mean the older one has
    // finished: it means someone else started. Finalizing on that wrote the
    // older row on every growth tick — one line per second, each repeating the
    // last ("Yeah, I told him" / "Yeah, I told him about Wilson" / ...). Going
    // quiet is the only reliable end-of-utterance signal Zoom gives us, so
    // rows finalize on idle alone.
    var idleFinalizeSeconds: TimeInterval? { 6 }
}

// MARK: - Google Meet

/// Google Meet's roster, read entirely through AXPress.
///
/// Nothing here resembles the Teams reader, because Meet's list is everything
/// Teams' is not. Measured on a live 59-person call:
///
///  - the side panel holds one `AXList` described "Participants", whose
///    children ARE the people — each row's AXDescription is the name (a
///    dial-in participant's "name" is their phone number);
///  - `AXButton` titled "Contributors 59" is the head count, and it agreed
///    with the rendered rows exactly, so there is no pagination to expand;
///  - the panel answers AXPress, so no window has to come forward, no pointer
///    is taken, and no window is resized. Nothing is stolen from the user.
///
/// A second list, "Guests", sits below "Also invited 104": people who were
/// invited and are NOT here. Reading only the Participants list's children
/// leaves them out, which is the whole point of the distinction.
///
/// Scrolling is kept as a fallback for a call big enough that Meet starts
/// dropping offscreen rows — not seen at 59, but the shortfall would be
/// silent, so it is handled rather than assumed away.
func captureMeetRoster(pid: pid_t, deadline: Date? = nil) -> RosterOutcome {
    guard UIAutomation.enter(waitingUntil: Date().addingTimeInterval(5)) else {
        return .deferred("another automated interaction is already running")
    }
    defer { UIAutomation.leave() }

    let app = AXUIElementCreateApplication(pid)
    AXUIElementSetMessagingTimeout(app, 8.0)
    var found: AXUIElement?
    for _ in 0..<8 where found == nil {
        found = axWindows(app).first(where: {
            findElement(from: $0, where: { axDescription($0) == meetLeaveDescription }) != nil
        })
        if found == nil { pokeWebTree(app); usleep(500_000) }
    }
    guard let window = found else { return .failed("no Google Meet call is running") }

    func sidePanel() -> AXUIElement? {
        findElement(from: window, where: { axDescription($0) == meetSidePanelDescription })
    }
    func participantList() -> AXUIElement? {
        findElement(from: window, where: {
            axString($0, kAXRoleAttribute) == kAXListRole
                && axDescription($0) == meetParticipantsListDescription
        })
    }
    // Which panel the side panel is showing. Identified structurally, because
    // the obvious signal lies: with chat open, the first heading inside the
    // panel is "Today" — a date separator in the message list, not the panel's
    // name. What is reliable is that chat renders in its own AXWebArea (it is
    // an iframe), People renders the Participants list in the main document,
    // and a closed panel has no children at all.
    enum Showing { case people, chat, closed, other }
    func shownPanel() -> Showing {
        guard let panel = sidePanel() else { return .closed }
        if participantList() != nil { return .people }
        if axChildren(panel).isEmpty { return .closed }
        if findElement(from: panel, where: {
            axString($0, kAXRoleAttribute) == "AXWebArea"
                && axDescription($0) == meetChatWebAreaDescription
        }) != nil { return .chat }
        return .other
    }

    let priorPanel = shownPanel()
    // Meet's side panel shows ONE thing at a time, so opening People closes
    // whatever was there — including the chat panel the daemon reads. Put back
    // what was there.
    func restorePanel() {
        switch priorPanel {
        case .people:
            return // already what the user had
        case .chat:
            // The chat button toggles, so this both re-opens chat and is what
            // a user would press.
            if let chat = findElement(from: window, where: {
                axDescription($0).hasPrefix(meetChatButtonPrefix)
            }) { press(chat) }
        case .closed, .other:
            // "Other" is some panel we cannot name (activities, notes). We
            // cannot restore it, so close rather than leave People sitting
            // open over the call.
            if let panel = sidePanel(), let close = findElement(from: panel, where: {
                axString($0, kAXRoleAttribute) == kAXButtonRole
                    && axString($0, kAXTitleAttribute) == meetClosePanelTitle
            }) { press(close) }
        }
    }
    defer { restorePanel() }

    if participantList() == nil {
        guard let people = findElement(from: window, where: {
            axString($0, kAXRoleAttribute) == "AXPopUpButton"
                && axDescription($0) == meetPeoplePanelHeading
        }) else { return .failed("Google Meet's People control is not in the tree") }
        press(people)
        for _ in 0..<12 where participantList() == nil { usleep(400_000) }
    }
    guard let list = participantList() else {
        return .failed("the People panel did not open")
    }

    func headCount() -> Int? {
        guard let button = findElement(from: window, where: {
            meetContributorCount(from: axString($0, kAXTitleAttribute)) != nil
        }) else { return nil }
        return meetContributorCount(from: axString(button, kAXTitleAttribute))
    }
    // A row's name is its description; the StaticText inside says the same
    // thing and is the fallback if a future build drops the description.
    func people(in list: AXUIElement) -> [String] {
        axChildren(list).compactMap { row in
            let name = axDescription(row)
            if !name.isEmpty { return name }
            return axStaticTexts(row).first { !$0.isEmpty }
        }
    }

    var seen = Set<String>()
    var names: [String] = []
    @discardableResult
    func merge() -> Int {
        let before = seen.count
        for name in people(in: list) where seen.insert(name).inserted { names.append(name) }
        return seen.count - before
    }
    merge()

    var expected = headCount()
    // Fallback only: at 59 people the list was complete at rest. If a bigger
    // call ever renders less than it claims, walk it rather than under-report.
    if let need = expected, seen.count < need, let panel = sidePanel() {
        let (origin, size) = axFrame(panel)
        let point = CGPoint(x: origin.x + size.width / 2, y: origin.y + size.height / 2)
        let priorPointer = CGEvent(source: nil)?.location
        var stale = 0
        for _ in 0..<80 {
            if seen.count >= need { break }
            if let deadline, Date() >= deadline { break }
            scrollWheel(at: point, direction: -1)
            stale = merge() == 0 ? stale + 1 : 0
            if stale >= 4 { break }
        }
        for _ in 0..<80 where stale < 4 {
            scrollWheel(at: point, direction: 1)
            stale = merge() == 0 ? stale + 1 : 0
        }
        if let priorPointer {
            CGEvent(mouseEventSource: nil, mouseType: .mouseMoved,
                    mouseCursorPosition: priorPointer, mouseButton: .left)?.post(tap: .cghidEventTap)
        }
        expected = headCount() ?? expected
    }

    guard !names.isEmpty else { return .failed("the People panel listed nobody") }
    let roster = names.sorted { $0.localizedCaseInsensitiveCompare($1) == .orderedAscending }
        .map { RosterPerson(name: $0, key: $0) }
    return .captured(RosterSnapshot(people: roster, expected: expected))
}

/// "Contributors 59" is the number of people actually in the call. The button
/// below the list says "Also invited 104" and must never be read as one.
func meetContributorCount(from title: String) -> Int? {
    guard title.hasPrefix(meetContributorsPrefix) else { return nil }
    let digits = title.dropFirst(meetContributorsPrefix.count)
    guard !digits.isEmpty, digits.allSatisfy(\.isNumber) else { return nil }
    return Int(digits)
}

let meetLeaveDescription = "Leave call"
let meetSidePanelDescription = "Side panel"
let meetParticipantsListDescription = "Participants"
let meetPeoplePanelHeading = "People"
let meetChatWebAreaDescription = "Chat"
let meetContributorsPrefix = "Contributors "
let meetClosePanelTitle = "Close"
let meetChatButtonPrefix = "Chat with everyone"

/// AXPress an element. Meet answers it, so its roster needs no HID clicking.
func press(_ element: AXUIElement) {
    AXUIElementPerformAction(element, kAXPressAction as CFString)
    usleep(400_000)
}

/// One pixel-wheel step at a point. Chromium and WebKit both ignore line
/// deltas in these lists.
func scrollWheel(at point: CGPoint, direction: Int32) {
    let source = CGEventSource(stateID: .combinedSessionState)
    CGEvent(mouseEventSource: source, mouseType: .mouseMoved,
            mouseCursorPosition: point, mouseButton: .left)?.post(tap: .cghidEventTap)
    usleep(80_000)
    let wheel = CGEvent(scrollWheelEvent2Source: source, units: .pixel,
                        wheelCount: 1, wheel1: direction * 300, wheel2: 0, wheel3: 0)
    wheel?.location = point
    wheel?.post(tap: .cghidEventTap)
    usleep(250_000)
}

/// Google Meet installed as a Safari web app (Add to Dock), which is what
/// `Web App` runs when handed the bundle on its command line. A Meet tab in an
/// ordinary browser window is NOT supported: the browser would be the process,
/// its other tabs would sit in the same tree, and finding the call would mean
/// searching all of them.
///
/// Alpha. All of this was worked out in a call with one participant, so the
/// single-speaker path is exercised and the rest is reasoned from it.
final class MeetApp: MeetingApp {
    let id = "meet"
    let displayName = "Google Meet"
    // Matches the --bundlepath argument. The bundle identifier carries a UUID
    // generated when the web app was installed, so it is useless here.
    let processPattern = "Web App .*Google Meet.app"
    // WebKit also serves an empty tree until something asks for it: before the
    // poke this app is 17 nodes with no AXWebArea at all.
    let rendersWebContent = true

    /// WebKit publishes no DOM ids, so the shared "has this tree woken up"
    /// test never passes for a Safari web app. Measured mid-call: 857 nodes,
    /// captions reading perfectly, ZERO AXDOMIdentifier values — the daemon
    /// was warning that captions could not be read while it was recording
    /// them, and everything gated on the ledger (the roster snapshot) never
    /// ran. What actually appears on waking is the AXWebArea itself, since a
    /// hollow web app has none, so that is the signal here. A childless one
    /// does not count: the frame exists before the document is in it.
    func webTreeIsAwake(_ app: AXUIElement) -> Bool {
        findElement(from: app, where: {
            axString($0, kAXRoleAttribute) == "AXWebArea" && !axChildren($0).isEmpty
        }) != nil
    }
    // The button says which way it goes, so pressing is never a guess.
    let captionPressToggles = false
    // The side panel lists everyone, and AXPress opens it: nothing is taken
    // from the user to read it (captureMeetRoster).
    let supportsRosterSnapshot = true
    let rosterSnapshotIsQuiet = true
    func captureRoster(pid: pid_t, deadline: Date?) -> RosterOutcome {
        captureMeetRoster(pid: pid, deadline: deadline)
    }
    // Meet displays no call duration, so lines get the time of day.
    let reportsMeetingClock = false
    // Segments stay put once a newer one lands, so finalize on being
    // superseded rather than waiting for text to disappear.
    var finalizesWhenSuperseded: Bool { true }
    var idleFinalizeSeconds: TimeInterval? { 6 }
    // A segment holds its position for life, so the same sentence twice is two
    // utterances rather than one line re-rendered — every Meet id is stable.
    func hasStableIdentity(_ id: String) -> Bool { true }

    /// Meet labels everything by ARIA, and its class names are obfuscated
    /// build output (`vNKgIf.UDinHf`) that changes without warning. Nothing
    /// here keys off them.
    private let leaveDescription = "Leave call"
    private let captionsDescription = "Captions"
    private let captionsOnLabel = "Turn off captions"
    private let captionsOffLabel = "Turn on captions"
    /// The chat composer. Kept only as a historical note: Google's move to
    /// the Chat iframe removed it from the tree (see chatContainer).
    private let composerDescription = "Send a message"
    /// Opens the chat panel. Its description gains " - New message" when
    /// something is unread, so it is matched by prefix.
    private let chatButtonDescription = "Chat with everyone"

    private var chatOpenAttempts = 0
    private var nextChatOpenAttempt = Date.distantPast

    /// Every caption segment reported so far, tracked by position in the whole
    /// conversation (see SegmentHistory). Meet exposes no DOM ids, and the text
    /// repeats often enough that hashing it would merge separate utterances —
    /// a single "Yeah." said twice was in the first capture.
    private var history = SegmentHistory()

    func meetingAnchor(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) { axDescription($0) == leaveDescription }
    }

    func meetingTitle(_ app: AXUIElement, anchor: AXUIElement?) -> String {
        let windows = axAttribute(app, kAXWindowsAttribute) as? [AXUIElement] ?? []
        var title = windows.map { axString($0, kAXTitleAttribute) }.first { !$0.isEmpty } ?? ""
        // "Meet - abc-defg-hij" for an unnamed call; a scheduled one is named.
        if title.hasPrefix("Meet - ") { title = String(title.dropFirst("Meet - ".count)) }
        title = title.trimmingCharacters(in: .whitespaces)
        return title.isEmpty ? "Google Meet" : title
    }

    func captionsContainer(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) {
            axDescription($0) == captionsDescription && axString($0, kAXRoleAttribute) == "AXGroup"
        }
    }

    func captionsPanelOpen(_ app: AXUIElement) -> Bool {
        // The button label is the authority: the caption group keeps its last
        // text long after anyone stopped speaking, so its presence says only
        // that captions were on at some point.
        captionsButton(app).map { axDescription($0) == captionsOnLabel } ?? false
    }

    func requestCaptions(pid: pid_t) -> CaptionRequest {
        let app = AXUIElementCreateApplication(pid)
        AXUIElementSetMessagingTimeout(app, 5.0)
        guard let button = captionsButton(app) else { return .unreachable }
        guard axDescription(button) == captionsOffLabel else { return .alreadyOn }
        return AXUIElementPerformAction(button, kAXPressAction as CFString) == .success
            ? .pressed : .unreachable
    }

    private func captionsButton(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) {
            let label = axDescription($0)
            return label == captionsOnLabel || label == captionsOffLabel
        }
    }

    /// Captions are one block per speaker - a name, then a group of text
    /// segments - laid out as alternating children. Segments are appended as
    /// sentences finish; only the last one is still being revised.
    /// Meet writes each utterance as two sibling groups: the speaker's name,
    /// then the sentences they said. Pairing them looks like a job for
    /// alternation — and that is what this did, stepping two at a time from
    /// the front of the list.
    ///
    /// It is wrong, and it fails silently. Meet prunes old captions off the
    /// FRONT as the panel fills, so pruning an odd number of groups shifts
    /// every pair by one and swaps every speaker with their words. Observed
    /// live, hours into a call: `[15:32:21] a whole sentence spoken by
    /// someone.: Emily Allan`. Captions kept flowing, and every line was
    /// backwards.
    ///
    /// So which side holds the names is decided from evidence (see
    /// nameParity) rather than from position.
    func captionEntries(in container: AXUIElement) -> [CaptionEntry] {
        let blocks = axChildren(container)
        var lines: [[String]] = []
        var shapes: [CaptionBlockShape] = []
        for block in blocks {
            let text = axStaticTexts(block)
            lines.append(text)
            // Only a single-line group is ambiguous. A group of sentences is
            // never a name, so measuring it would be a round trip for nothing.
            let height = text.count == 1 ? Double(axFrame(block).size.height) : 0
            shapes.append(CaptionBlockShape(lines: text.count, height: height))
        }
        let isName = MeetApp.nameBlocks(shapes)

        var visible: [(speaker: String, text: String)] = []
        var speaker = ""
        for (index, block) in lines.enumerated() {
            if isName[index] {
                speaker = block.first ?? speaker
                continue
            }
            for text in block where !text.isEmpty { visible.append((speaker, text)) }
        }
        guard !visible.isEmpty else { return [] }

        // All but the last are settled. Fold them into the history, which is
        // what absolute positions are counted against.
        let base = history.absorb(visible.dropLast().map { SegmentKey(speaker: $0.speaker, text: $0.text) })
        return visible.enumerated().map { offset, entry in
            CaptionEntry(id: "seg:\(base + offset)", speaker: entry.speaker, text: entry.text)
        }
    }

    /// What a caption group looks like without reading what it says.
    struct CaptionBlockShape {
        /// How many sentences it holds. A name is always exactly one.
        let lines: Int
        /// Its height in points, or 0 when it was not worth measuring.
        let height: Double
    }

    /// Which groups are speakers' names rather than what they said.
    ///
    /// Each group is judged on its own. Pairing them off by alternation is the
    /// obvious reading and it is wrong twice over: Meet prunes old captions
    /// off the FRONT, so counting pairs from index 0 flips every speaker onto
    /// the wrong words as soon as it prunes an odd number, and the alternation
    /// does not even hold from end to end — measured live, one list had its
    /// names on the even indices at the top and the odd ones at the bottom.
    ///
    /// What does hold is typography: Meet sets a name in smaller type than the
    /// caption under it. In that same list, single-line groups measured 15-16
    /// points 144 times and 25 points 74 times, with nothing in between, and
    /// the size class alternated correctly in all but one adjacent pair. So
    /// the smallest type present is the names, and anything taller is speech.
    ///
    /// The threshold is relative to the smallest group rather than absolute,
    /// because Meet's caption size is a setting; and it is anchored to the
    /// SMALL end rather than the span, because a caption that wraps is taller
    /// still and must not drag a midpoint up past the one-line captions.
    static func nameBlocks(_ shapes: [CaptionBlockShape]) -> [Bool] {
        let measured = shapes.filter { $0.lines == 1 && $0.height > 0 }.map(\.height)
        if let smallest = measured.min(), measured.contains(where: { $0 > smallest * 1.2 }) {
            let threshold = smallest * 1.2
            return shapes.map { $0.lines == 1 && $0.height > 0 && $0.height <= threshold }
        }
        // Only one type size among the single-line groups, so there is nothing
        // to compare them against — unless a group of sentences is present,
        // which gives the caption line height directly. Take the LEAST such
        // group: a caption that wrapped is taller per sentence than one that
        // did not, and an inflated estimate would start reading captions as
        // names.
        let perLine = shapes.filter { $0.lines > 1 && $0.height > 0 }
            .map { $0.height / Double($0.lines) }
        if let lineHeight = perLine.min() {
            return shapes.map { $0.lines == 1 && $0.height > 0 && $0.height < lineHeight * 0.9 }
        }
        // Nothing measurable at all: fall back to alternation, but anchored at
        // the END, where new captions arrive, rather than the front, which is
        // the end Meet prunes.
        var names = [Bool](repeating: false, count: shapes.count)
        var index = shapes.count - 2
        while index >= 0 {
            names[index] = shapes[index].lines <= 1
            index -= 2
        }
        return names
    }

    func resetCaptureState() {
        history.reset()
        chatOpenAttempts = 0
        nextChatOpenAttempt = .distantPast
    }

    func reportedElapsedSeconds(_ app: AXUIElement) -> TimeInterval? { nil }
    /// Meet's chat panel has to be open to exist in the tree at all, so an
    /// unattended meeting records no chat unless something opens it. With
    /// --popout-chat, this does — Meet answers AXPress, so unlike Teams there
    /// is no clicking, no activating and no stealing of focus.
    ///
    /// Twice at most, a minute apart: closing the panel again is an answer,
    /// and reopening it forever would be an argument.
    func maintainSurfaces(_ app: AXUIElement, pid: pid_t, now: Date,
                          popOutCaptions: Bool, popOutChat: Bool) {
        guard popOutChat, !chatPanelOpen(app) else { return }
        guard chatOpenAttempts < 2, now >= nextChatOpenAttempt else { return }
        chatOpenAttempts += 1
        nextChatOpenAttempt = now.addingTimeInterval(60)
        guard let button = findElement(from: app, where: {
            axDescription($0).hasPrefix(chatButtonDescription)
        }) else { return }
        guard AXUIElementPerformAction(button, kAXPressAction as CFString) == .success else { return }
        status("opened Google Meet's chat panel so chat is recorded")
    }

    /// Whether the chat panel is showing. The web area only exists while it
    /// is open, so its presence is the test (the composer this used to look
    /// for is no longer in the tree at all).
    private func chatPanelOpen(_ app: AXUIElement) -> Bool {
        findElement(from: app) {
            axString($0, kAXRoleAttribute) == "AXWebArea"
                && axDescription($0) == meetChatWebAreaDescription
        } != nil
    }

    /// Meet's chat lives in its own web area now.
    ///
    /// Google moved the panel to the Chat product: what used to be a flat run
    /// of one-line groups beside a composer described "Send a message" is now
    /// an iframe, exposed as `AXWebArea` described "Chat". The composer is not
    /// in the tree at all any more — measured mid-call, the only AXTextArea in
    /// the whole window was one titled "History is on" — so anchoring on it,
    /// as this did, silently recorded no chat whatsoever.
    ///
    /// The web area itself is the anchor now. It exists only while the panel
    /// is open, which is exactly the condition the old composer test stood in
    /// for.
    func chatContainer(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) {
            axString($0, kAXRoleAttribute) == "AXWebArea"
                && axDescription($0) == meetChatWebAreaDescription
        }
    }

    /// Pull the messages out of that web area.
    ///
    /// A message is a group whose LAST child is the relative age Meet writes
    /// after every message, wrapped in commas so a screen reader pauses around
    /// it: ["," , "3 min", ","]. That triple is the only reliable mark of a
    /// message row, and it keeps the panel's furniture out: the "messages are
    /// only visible to people in the call" notice, the "SPACE UPDATE: HISTORY
    /// IS ON" banner and the "Today" date heading all lack it.
    ///
    /// Before the age come the text-bearing groups: sender then message, or
    /// message alone when the same person sends two in a row. A reactions
    /// AXList can sit between them and is skipped by role.
    func chatMessages(in container: AXUIElement) -> [ChatMessage] {
        var rows: [MeetChatRow] = []
        func walk(_ element: AXUIElement, depth: Int) {
            guard depth < 12 else { return }
            if let row = MeetApp.chatRow(element) { rows.append(row); return }
            for child in axChildren(element) { walk(child, depth: depth + 1) }
        }
        walk(container, depth: 0)
        return MeetApp.messages(from: rows).suffix(20)
    }

    /// One row, flattened to the three things a transcript needs.
    struct MeetChatRow {
        /// Empty when this row continues the sender above it.
        let sender: String
        let text: String
        /// "3 min". Deliberately not part of the id; see messages(from:).
        let age: String
    }

    static func chatRow(_ element: AXUIElement) -> MeetChatRow? {
        guard axString(element, kAXRoleAttribute) == kAXGroupRole else { return nil }
        let children = axChildren(element)
        guard children.count >= 2, let last = children.last,
              let age = commaWrappedAge(last) else { return nil }
        let parts = children.dropLast()
            .filter { axString($0, kAXRoleAttribute) == kAXGroupRole }
            .map { axStaticTexts($0).joined(separator: " ")
                    .trimmingCharacters(in: .whitespacesAndNewlines) }
            .filter { !$0.isEmpty }
        guard let text = parts.last else { return nil }
        return MeetChatRow(sender: parts.count >= 2 ? parts[parts.count - 2] : "",
                           text: text, age: age)
    }

    /// The comma-wrapped age that ends every message row.
    static func commaWrappedAge(_ element: AXUIElement) -> String? {
        guard axString(element, kAXRoleAttribute) == kAXGroupRole else { return nil }
        let texts = axStaticTexts(element)
            .map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }
        guard texts.count == 3, texts[0] == ",", texts[2] == ",", !texts[1].isEmpty else {
            return nil
        }
        return texts[1]
    }

    /// Turn rows into messages: carry the sender down through the follow-ups,
    /// and give each one an id that survives both a restart and the clock.
    ///
    /// The age is NOT hashed, though the old clock timestamp was. It cannot
    /// be: "3 min" becomes "4 min" while the same message sits there, so an
    /// id made from it would rename every message on every poll and record
    /// the whole panel again each minute. The cost is that the same words
    /// twice from one person would collide, so identical (sender, text) pairs
    /// are numbered by their position in the panel instead.
    static func messages(from rows: [MeetChatRow]) -> [ChatMessage] {
        var messages: [ChatMessage] = []
        var sender = ""
        var occurrences: [String: Int] = [:]
        for row in rows {
            if !row.sender.isEmpty { sender = row.sender }
            let author = sender.isEmpty ? "Unknown" : sender
            let key = "\(author)|\(row.text)"
            let seen = (occurrences[key] ?? 0) + 1
            occurrences[key] = seen
            let id = String(fnv1a(seen == 1 ? key : "\(key)|#\(seen)"), radix: 36)
            messages.append(ChatMessage(id: id, author: author, text: row.text))
        }
        return messages
    }

    /// FNV-1a, for ids that are the same in every process.
    static func fnv1a(_ text: String) -> UInt64 {
        var hash: UInt64 = 0xcbf2_9ce4_8422_2325
        for byte in text.utf8 {
            hash ^= UInt64(byte)
            hash &*= 0x100_0000_01b3
        }
        return hash
    }
}

let supportedApps: [MeetingApp] = [TeamsApp(), ZoomApp(), SlackApp(), MeetApp()]


// MARK: - Session

/// One meeting: holds the caption/chat state and creates files lazily, so a
/// meeting that never produces a line leaves nothing behind.
/// Injectable time. Tests drive deadlines, backoff, and the finish drain
/// loop deterministically; production always gets wall-clock.
protocol TimeSource {
    func now() -> Date
}

struct WallClock: TimeSource {
    func now() -> Date { Date() }
}

/// A finished roster attempt, handed from the snapshot thread back to the
/// poll loop. One slot, because only one attempt is ever in flight.
final class RosterInbox {
    private let mutex = NSLock()
    private var value: RosterOutcome?

    func put(_ outcome: RosterOutcome) {
        mutex.lock()
        value = outcome
        mutex.unlock()
    }

    func take() -> RosterOutcome? {
        mutex.lock()
        defer { value = nil; mutex.unlock() }
        return value
    }
}

final class Session {
    let options: Options
    let live: LiveView
    let meetingApp: MeetingApp
    /// Sleep primitive for the finish drain loop's inter-attempt pause —
    /// injectable so tests don't actually sleep while the fake clock advances.
    var sleepFn: (UInt32) -> Void = { usleep($0) }
    let clock: any TimeSource
    let startedAt = Date()
    var title: String
    var recorder: Recorder?
    /// Highest stamp written so far, so the transcript clock never goes back.
    private var lastStamp: Date?
    private var captionsContainer: AXUIElement?
    private var chatContainer: AXUIElement?
    private var lastRelocate = Date.distantPast
    private var activeCaptions: [String: Utterance] = [:]
    private var captionOrder: [String] = []
    // ^ internal so fault tests can count lost items without stderr capture
    private var seenChatIDs = Set<String>()
    private var chatBaselineDone: Bool
    private var captionAttempts = 0
    private var warnedCaptionsUnreachable = false
    /// finish() must be idempotent: it runs both on leave detection and on exit,
    /// and running twice would double-flush and double-report.
    var finished = false
    private var lastPublishWarning = Date.distantPast
    private var lastInitWarning = Date.distantPast
    /// The ordered write backlog: everything that failed to persist, oldest
    /// first. ONE queue holds both whole events (.event) and jsonl-only lines
    /// whose text half is still owed (.text); a single FIFO is what keeps both
    /// transcript files in the same order across write outages. Entries are
    /// drained by drainPendingWrites and count as lost in finish().
    enum PendingWrite {
        case event(kind: String, speaker: String, body: String, at: Date, extra: [String: Any])
        case text(String)
    }
    var pendingWrites: [PendingWrite] = []
    var nextRetry = Date.distantPast
    var retryDelay: TimeInterval = 1
    private var nextCaptionCheck = Date.distantPast
    /// When the surface upkeep (captions on, chat open) may next hold the
    /// automation lock. See tick for why it is rate-limited.
    private var nextSurfaceCheck = Date.distantPast
    private var sawCaptions = false
    /// One line already on disk, kept around to recognise the app re-rendering
    /// it. `lastSeen` is refreshed for as long as a row on screen still shows
    /// exactly this text, which is what keeps the suppressor alive through
    /// node-id churn (see alreadyWritten).
    struct WrittenLine {
        let speaker: String
        let text: String
        /// When the line was written.
        let at: Date
        /// Last poll at which this exact text was still on screen.
        var lastSeen: Date

        init(speaker: String, text: String, at: Date, lastSeen: Date? = nil) {
            self.speaker = speaker
            self.text = text
            self.at = at
            self.lastSeen = lastSeen ?? at
        }
    }
    /// Recently written utterances, to catch an app re-rendering a finished one.
    var written: [WrittenLine] = []
    /// Ids already written but still on screen.
    private var finalized = Set<String>()
    /// What each finalized id's text was AT THE MOMENT WE FINALIZED IT. Growth
    /// has to be judged per row against its own last state: scanning `written`
    /// instead lets an earlier, shorter write OF THE SAME ROW masquerade as
    /// growth forever, re-opening a row that is actually frozen.
    var finalizedText: [String: String] = [:]
    /// What each row has ALREADY CONTRIBUTED to the transcript. A row that goes
    /// quiet, gets written, and then keeps growing (a speaker resuming after a
    /// pause) must not repeat itself on disk; see unwrittenPart.
    var emittedText: [String: String] = [:]
    var ledger = WakeLedger()
    /// What `[HH:MM:SS]` counts from: the app's clock (connection time) once
    /// it tells us, otherwise the moment we attached.
    private var timelineStart: Date
    private var timelineResolved = false
    private var nextTimelineCheck = Date.distantPast
    /// Roster bookkeeping. ONE recorded roster per meeting: read once the
    /// joining rush has settled, retried only while it comes back short of
    /// the head count Teams itself prints.
    private let rosterInbox = RosterInbox()
    private var rosterRunning = false
    private var rosterDone = false
    private var rosterAttempts = 0
    private var nextRosterAttempt: Date
    /// When to stop hunting for a quiet moment and accept that this meeting
    /// goes unrostered.
    private let rosterGiveUpAt: Date
    /// How long after joining the first roster is read. People are still
    /// arriving in the first seconds of a call, and a roster taken then is
    /// both wrong and certain to disagree with the head count. It also leaves
    /// the captions/chat pop-outs (attempted at 0s and 60s) the clear run at
    /// the pointer they need.
    static let rosterSettleSeconds: TimeInterval = 90
    /// A lull, so the pointer is never taken mid-word or mid-gesture. Typing
    /// gets the longer threshold: keystrokes during the snapshot would land in
    /// whatever Teams focuses, which is the one genuinely destructive outcome.
    static let rosterTypingIdleSeconds: TimeInterval = 3
    static let rosterPointerIdleSeconds: TimeInterval = 1.5
    /// How often to look for that lull. This is a HUNT, not a sample: the
    /// first version asked once every 20 seconds and, measured against a
    /// meeting where the user was taking notes throughout, never once found
    /// the keyboard quiet — the roster simply never happened. Gaps of a few
    /// seconds are common; you just have to be looking when one arrives.
    static let rosterLullRecheckSeconds: TimeInterval = 2
    /// How long to keep hunting before giving up and saying so.
    static let rosterHuntSeconds: TimeInterval = 20 * 60
    static let rosterRetrySeconds: TimeInterval = 120
    /// Backoff for conditions that are nobody's fault and cost no attempt:
    /// another automated interaction in progress, or a meeting window sitting
    /// on some other Space.
    static let rosterDeferSeconds: TimeInterval = 20
    static let rosterMaxAttempts = 3
    /// Bound on one attempt's paging, so a huge roster cannot spend the whole
    /// meeting scrolling.
    static let rosterBudgetSeconds: TimeInterval = 180

    init(options: Options, live: LiveView, meetingApp: MeetingApp, title: String,
         clock: any TimeSource = WallClock()) {
        self.options = options
        self.live = live
        self.meetingApp = meetingApp
        self.title = title
        self.clock = clock
        self.timelineStart = clock.now()
        self.nextRosterAttempt = clock.now().addingTimeInterval(Session.rosterSettleSeconds)
        self.rosterGiveUpAt = clock.now()
            .addingTimeInterval(Session.rosterSettleSeconds + Session.rosterHuntSeconds)
        chatBaselineDone = options.includeChatBacklog
        // Apps are singletons; drop any caption bookkeeping a previous meeting left.
        meetingApp.resetCaptureState()
    }

    var wroteAnything: Bool { recorder != nil }
    var files: (jsonl: URL, text: URL)? { recorder.map { ($0.jsonlURL, $0.textURL) } }

    /// Files are created on first write, so a silent meeting leaves no litter.
    /// Returns nil until the METADATA event is written successfully — the one
    /// hard requirement. Header writing and pointer publication are best-effort
    /// follow-ups, not part of the success condition. Callers whose event fails
    /// while this returns nil queue it for replay rather than dropping it.
    private func recorderForWriting() -> Recorder? {
        if let recorder { return recorder }
        // Whatever the timeline looks like now is what the file gets: the header
        // documents it, and changing it later would rewrite history (see resolveTimeline).
        let mode: TimestampMode
        if timelineResolved {
            mode = .elapsed(from: timelineStart)
        } else if meetingApp.reportsMeetingClock {
            mode = .elapsed(from: startedAt)
        } else {
            mode = .timeOfDay
        }
        let created = Recorder(
            options: options, app: meetingApp.id, meeting: title, startedAt: startedAt,
            mode: mode)
        var metadata: [String: Any] = [
            "type": "metadata",
            "source": "\(meetingApp.id)-ax",
            "app": meetingApp.displayName,
            "meeting": title,
            "recorded_at": Recorder.isoFormatter.string(from: startedAt),
            "timestamps": mode.metadataValue
        ]
        if timelineResolved {
            metadata["meeting_started_at"] = Recorder.isoFormatter.string(from: timelineStart)
        }
        // The metadata event must persist before anything else is recorded;
        // writeJSON has already logged the failure. Throttled because this
        // fires once per skipped event while writes are broken.
        guard created.writeJSON(metadata) else {
            if Date().timeIntervalSince(lastInitWarning) > 30 {
                lastInitWarning = Date()
                status("cannot start recording \"\(title)\"; captions will be retried")
            }
            return nil
        }

        var header = ["\(title) (\(meetingApp.displayName))",
                      "recording started \(Recorder.isoFormatter.string(from: startedAt))"]
        if timelineResolved {
            header.append("meeting started   \(Recorder.isoFormatter.string(from: timelineStart))")
        }
        header.append("[hh:mm:ss] is the time of day")
        created.writeHeader(header)
        recorder = created
        let pointer = options.stateDirectory + "/current"
        do {
            try created.textURL.path.write(toFile: pointer, atomically: true, encoding: .utf8)
        } catch {
            // Without this pointer --follow has nothing to tail and silently waits forever.
            status("cannot update \(pointer): \(error.localizedDescription)")
        }
        if !options.quiet {
            status("recording \"\(title)\"\n  jsonl: \(created.jsonlURL.path)\n  text:  \(created.textURL.path)")
        }
        return created
    }

    /// Both attributes are set by pokeWebTree; see it for how the wake works.
    private func wakeTreeIfNeeded(app: AXUIElement, pid: pid_t, now: Date) {
        // Native short-circuit: mark populated even though no WebView exists —
        // caption gating below reads the ledger, not rendersWebContent.
        guard meetingApp.rendersWebContent else { ledger.markPopulated(pid: pid); return }
        if meetingApp.webTreeIsAwake(app) { // whatever waking looks like for this app
            // Transition announcement only fires if we poked at least once
            // before — detection-side wakes never announce, and this must not
            // become a behavior change inside a refactor.
            if !ledger.isPopulated(pid: pid), ledger.attempts[pid, default: 0] > 0, !options.quiet {
                status("\(meetingApp.displayName) exposed its accessibility tree")
            }
            ledger.markPopulated(pid: pid)
            return
        }
        let (poke, attempt) = ledger.pokeDecision(pid: pid, awake: false, now: now)
        guard poke else { return }
        pokeWebTree(app)
        if !options.quiet, attempt <= 3 {
            status("asked \(meetingApp.displayName) to expose its accessibility tree (attempt \(attempt))")
        } else if !options.quiet, attempt == 4 || attempt % 12 == 0 {
            status("\(meetingApp.displayName)'s accessibility tree has stayed hollow for \(attempt * 5)s; captions cannot be read. Check Accessibility permission for meeting-capture-daemon, or restart \(meetingApp.displayName)")
        }
    }

    /// Ask the app how long its participant has been connected, so lines are
    /// numbered from that clock rather than from when we joined. The clock is
    /// part of the window chrome, which Zoom hides along with its toolbar, so
    /// keep asking until it answers — but only until the first line is written.
    /// Past that the header already declares what the stamps mean, and moving
    /// the reference halfway through would make the file contradict itself; such
    /// a recording simply counts from when recording began.
    private func resolveTimeline(app: AXUIElement, now: Date) {
        guard recorder == nil else { return }
        guard now >= nextTimelineCheck else { return }
        nextTimelineCheck = now.addingTimeInterval(5)
        guard let elapsed = meetingApp.reportedElapsedSeconds(app), elapsed > 0 else { return }
        timelineResolved = true
        timelineStart = now.addingTimeInterval(-elapsed)
    }

    /// Records an event and draws it. Returns true when the event persisted
    /// somewhere or was accepted onto the ordered retry queue; false when it
    /// failed outright (callers roll their dedup state back).
    ///
    /// Records an event and draws it, preserving transcript order: while any
    /// earlier output is still queued, new events are queued behind it rather
    /// than written. Queued == committed for dedup purposes — the backlog is
    /// drained by retryPendingWrites and finish(), never dropped silently.
    private func emit(kind: String, speaker: String, body: String, at date: Date, extra: [String: Any]) {
        guard pendingWrites.isEmpty else {
            pendingWrites.append(.event(
                kind: kind, speaker: speaker, body: body, at: date, extra: extra))
            return
        }
        switch attemptEventWrite(kind: kind, speaker: speaker, body: body,
                                 at: date, extra: extra) {
        case .done:
            break
        case .needsText(let line):
            // jsonl persisted; the text half becomes this event's remaining debt.
            pendingWrites.append(.text(line))
        case .failed:
            // Nothing persisted anywhere; queue the whole event for retry.
            pendingWrites.append(.event(
                kind: kind, speaker: speaker, body: body, at: date, extra: extra))
        }
    }
    /// One attempt at writing a whole event through the recorder.
    private func attemptEventWrite(kind: String, speaker: String, body: String,
                                   at date: Date, extra: [String: Any]) -> AttemptResult {
        // Lines are appended as they finish but stamped with when they began,
        // so a long sentence can land after a short one that started later and
        // the clock appears to run backwards. Hold the stamp at the high-water
        // mark; it only moves once the line persisted somewhere.
        let stamp = max(date, lastStamp ?? date)
        var extra = extra
        if stamp != date { extra["started_at"] = Recorder.isoFormatter.string(from: date) }
        guard let writer = recorderForWriting() else {
            return .failed("transcript metadata could not be written; details logged above")
        }
        switch writer.record(kind: kind, speaker: speaker, body: body, at: stamp, extra: extra) {
        case .written(let line):
            lastStamp = stamp
            live.permanent(line)
            return .done
        case .jsonOnly(let line):
            lastStamp = stamp
            live.permanent(line) // display it even though the text file owes it
            return .needsText(line)
        case .failed:
            return .failed("event write failed; details logged above")
        }
    }

    /// Render in-progress utterances for the live region. Stamps match how the
    /// recorder stamps finished lines, so the live region and the transcript
    /// above it read the same way — both are the time of day.
    ///
    /// Stamps get the SAME high-water clamp attemptEventWrite applies when the
    /// line eventually lands (`after` is the last stamp written). Without it
    /// the live region shows a line stamped EARLIER than the finished line
    /// printed above it: a long sentence that began first is still being
    /// spoken when a shorter one that began later finishes and is written. The
    /// clamp is cumulative so the pending block reads in order within itself
    /// too, and because it mirrors the writer's clamp, a line's stamp does not
    /// jump when it graduates from live to transcript.
    static func liveLines(_ pending: [Utterance], after floor: Date?) -> [String] {
        var floor = floor
        return pending.map { utterance in
            let at = max(utterance.startedAt, floor ?? utterance.startedAt)
            floor = at
            return "[\(Recorder.clockText(from: at))] \(utterance.speaker): \(utterance.text)"
        }
    }

    func tick(app: AXUIElement, pid: pid_t, now: Date) {
        guard !finished else { return }
        // Drain the backlog before fresh polls emit anything new, so recovered
        // output always precedes newer lines.
        retryPendingWrites(now: now)
        wakeTreeIfNeeded(app: app, pid: pid, now: now)
        resolveTimeline(app: app, now: now)
        let needsCaptions = options.captureCaptions && captionsContainer == nil
        let needsChat = options.captureChat && chatContainer == nil
        if (needsCaptions || needsChat) && now.timeIntervalSince(lastRelocate) > 3 {
            lastRelocate = now
            if needsCaptions { captionsContainer = meetingApp.captionsContainer(app) }
            if needsChat { chatContainer = meetingApp.chatContainer(app) }
        }

        if options.peopleSnapshot { maintainRoster(pid: pid, now: now) }
        // Fronting, clicking and key posting are all global state, so none of
        // them may overlap the roster snapshot's background thread (see
        // UIAutomation). Whoever loses simply tries again next poll.
        //
        // Both of these search the whole tree before they decide they have
        // nothing to do, and they were doing it under the lock at every poll —
        // four times a second, against a caption panel of thousands of nodes.
        // That left no gap for anything else to take the lock, and the roster
        // snapshot (which asks once every 20s) never ran at all. A second
        // between looks is plenty for turning captions on or reopening chat.
        if now >= nextSurfaceCheck, UIAutomation.tryEnter() {
            nextSurfaceCheck = now.addingTimeInterval(1)
            if options.autoCaptions { ensureCaptionsOn(app: app, pid: pid, now: now) }
            meetingApp.maintainSurfaces(app, pid: pid, now: now,
                                        popOutCaptions: options.popOutCaptions,
                                        popOutChat: options.popOutChat)
            UIAutomation.leave()
        }
        if options.captureCaptions { pollCaptions(now: now) }
        if options.captureChat { pollChat(now: now) }
    }

    /// Record who was in the meeting, once.
    ///
    /// The reading runs on a background thread: expanding a 300-person roster
    /// is minutes of clicking and scrolling, and doing that on the poll loop
    /// would drop every caption spoken meanwhile. This only starts attempts
    /// and writes back what they found.
    ///
    /// A snapshot is written when it matches Teams' own head count, or when
    /// the last attempt is spent — so a transcript holds exactly one roster,
    /// and a short one says how short it is.
    private func maintainRoster(pid: pid_t, now: Date) {
        if let outcome = rosterInbox.take() {
            rosterRunning = false
            switch outcome {
            case .captured(let snapshot):
                rosterAttempts += 1
                nextRosterAttempt = now.addingTimeInterval(Session.rosterRetrySeconds)
                // An unconfirmed roster is usually a meeting still filling up.
                // Take it as the answer only when there are no tries left.
                if snapshot.confirmed || rosterAttempts >= Session.rosterMaxAttempts {
                    writeRoster(snapshot, at: now)
                    rosterDone = true
                }
            case .failed(let why):
                rosterAttempts += 1
                nextRosterAttempt = now.addingTimeInterval(Session.rosterRetrySeconds)
                guard rosterAttempts >= Session.rosterMaxAttempts else { return }
                rosterDone = true
                if !options.quiet {
                    status("could not read the \(meetingApp.displayName) participant list: \(why)")
                }
            case .deferred:
                // Not now, and not this meeting's fault: costs no attempt.
                nextRosterAttempt = now.addingTimeInterval(Session.rosterDeferSeconds)
            }
            return
        }
        guard meetingApp.supportsRosterSnapshot, !rosterDone, !rosterRunning else { return }
        guard rosterAttempts < Session.rosterMaxAttempts else { return }
        // Hunting for a lull cannot go on all day; say so rather than leaving
        // a silent gap where the roster should be.
        if now >= rosterGiveUpAt {
            rosterDone = true
            if !options.quiet {
                status("never found a quiet moment to read the \(meetingApp.displayName) participant list; this meeting has no roster")
            }
            return
        }
        guard now >= nextRosterAttempt else { return }
        // Reading the panel means clicking it, so the tree has to be awake.
        guard ledger.isPopulated(pid: pid) else { return }
        // The snapshot borrows the pointer and the front app for a moment.
        // Wait for a lull rather than stealing mid-sentence or mid-gesture —
        // unless this app's reader takes nothing, as Meet's does not.
        if !meetingApp.rosterSnapshotIsQuiet,
           Session.interruptsUser(typingIdle: secondsSinceTyping(),
                                  pointerIdle: secondsSincePointerAction()) {
            nextRosterAttempt = now.addingTimeInterval(Session.rosterLullRecheckSeconds)
            return
        }
        rosterRunning = true
        let inbox = rosterInbox
        let reader = meetingApp
        let deadline = now.addingTimeInterval(Session.rosterBudgetSeconds)
        DispatchQueue.global(qos: .utility).async {
            inbox.put(reader.captureRoster(pid: pid, deadline: deadline))
        }
    }

    /// Whether taking the pointer and the front app right now would interrupt
    /// something the user is in the middle of.
    static func interruptsUser(typingIdle: TimeInterval, pointerIdle: TimeInterval) -> Bool {
        typingIdle < rosterTypingIdleSeconds || pointerIdle < rosterPointerIdleSeconds
    }

    /// Write the roster as one event: a `people` line in the transcript and a
    /// `people` record in the jsonl carrying the names as a list, so it can be
    /// read by machine without parsing the sentence.
    private func writeRoster(_ snapshot: RosterSnapshot, at date: Date) {
        let names = snapshot.people.map(\.name)
        var extra: [String: Any] = [
            "people": names,
            "count": names.count,
            "confirmed": snapshot.confirmed,
        ]
        if let expected = snapshot.expected { extra["roster_count"] = expected }
        emit(kind: "people", speaker: "",
             body: RosterSnapshot.summary(names: names, expected: snapshot.expected),
             at: date, extra: extra)
        if !options.quiet {
            status("recorded the participant list: \(snapshot.headline)")
        }
    }

    /// Retry the ordered backlog on bounded exponential backoff (capped at
    /// 30s) so a persistently broken disk doesn't get hammered every 250ms.
    /// Draining uses attemptEventWrite directly — deliberately NOT emit(),
    /// whose order guard would re-queue everything behind itself.
    /// Drain the backlog, strictly oldest-first, stopping at the first item
    /// whose write fails so nothing overtakes it. A .event that lands as
    /// jsonOnly is REPLACED in place by its text debt rather than dropped, so
    /// later items can never pass it.
    ///
    /// Returns the BLOCKING failure's cause for callers' aggregate warning,
    /// or nil when everything drained — or when the deadline expired first
    /// with items still queued (read pendingWrites.count to tell those apart).
    @discardableResult
    func drainPendingWrites(until deadline: Date?) -> String? {
        while !pendingWrites.isEmpty {
            // Same injected source as finish()'s deadline — a fake clock that
            // advances per now() call is what makes the loop terminate in tests.
            if let deadline, clock.now() >= deadline { break }
            let result: AttemptResult
            switch pendingWrites[0] {
            case .event(let kind, let speaker, let body, let at, let extra):
                result = attemptEventWrite(kind: kind, speaker: speaker,
                                           body: body, at: at, extra: extra)
            case .text(let line):
                guard let writer = recorder else {
                    result = .failed("transcript is not initialized")
                    break
                }
                do {
                    try writer.appendText(line)
                    result = .done
                } catch {
                    result = .failed("\(writer.textURL.path): \(error.localizedDescription)")
                }
            }
            switch result {
            case .done:
                pendingWrites.removeFirst()
            case .needsText(let line):
                pendingWrites[0] = .text(line)
            case .failed(let why):
                return why
            }
        }
        return nil
    }

    /// Retry queued output on a bounded exponential backoff (capped at 30s).
    /// Runs before fresh polls each tick; combined with emit's order guard,
    /// this means recovered output always precedes anything newer.
    func retryPendingWrites(now: Date) {
        guard !finished else { return }
        guard !pendingWrites.isEmpty else { return }
        guard now >= nextRetry else { return }
        if let why = drainPendingWrites(until: nil) {
            retryDelay = min(retryDelay * 2, 30)
            nextRetry = now.addingTimeInterval(retryDelay)
            status("\(pendingWrites.count) item(s) awaiting writable storage; retrying every \(Int(retryDelay))s\n  blocked by: \(why)")
        } else {
            retryDelay = 1
        }
    }

    /// Turn captions on if the panel isn't up. Gives up quickly: toggling a
    /// shortcut we can't verify is worse than missing a transcript.
    private func ensureCaptionsOn(app: AXUIElement, pid: pid_t, now: Date) {
        if meetingApp.captionsPanelOpen(app) {
            sawCaptions = true
            return
        }
        // Panel looks closed. For an app whose captions only appear while
        // someone is speaking, that is just silence - asking again would
        // reopen a panel the user closed, or warn about captions that are
        // running. Otherwise, if we already pressed while the tree was hollow,
        // do not guess again. Once the tree is readable we can see it is
        // really off and it is safe to toggle back on.
        if sawCaptions {
            guard !meetingApp.captionsSurfaceIsTransient else { return }
            guard ledger.isPopulated(pid: pid) else { return }
            sawCaptions = false
            captionAttempts = 0
        }
        guard captionAttempts < 2,
              now.timeIntervalSince(startedAt) > 3,
              now >= nextCaptionCheck else { return }
        nextCaptionCheck = now.addingTimeInterval(8)
        switch meetingApp.requestCaptions(pid: pid) {
        case .alreadyOn:
            sawCaptions = true
            return
        case .unreachable:
            if !warnedCaptionsUnreachable, !options.quiet {
                warnedCaptionsUnreachable = true
                status("\(meetingApp.displayName) is hiding its captions control; will turn captions on when it reappears")
            }
            return
        case .pressed:
            captionAttempts += 1
            if !options.quiet {
                status("asked \(meetingApp.displayName) to show live captions (attempt \(captionAttempts))")
            }
            if meetingApp.captionPressToggles && !ledger.isPopulated(pid: pid) {
                sawCaptions = true
            } else {
                nextCaptionCheck = now.addingTimeInterval(20)
            }
        }
    }

    private func pollCaptions(now: Date) {
        guard let container = captionsContainer else { return }
        let entries = meetingApp.captionEntries(in: container)
        if !entries.isEmpty { sawCaptions = true }
        refreshWrittenLines(visibleIn: entries, now: now)
        if entries.isEmpty && axChildren(container).isEmpty {
            captionsContainer = nil // panel closed or re-rendered
        }
        let visible = Set(entries.map(\.id))
        finalized.formIntersection(visible) // let ids be reused once they are gone
        finalizedText = finalizedText.filter { visible.contains($0.key) }
        emittedText = emittedText.filter { visible.contains($0.key) }
        for entry in entries {
            if finalized.contains(entry.id) {
                // Same row kept growing after we idle-finalized it (Zoom).
                if reopensAfterGrowth(id: entry.id, text: entry.text) {
                    finalized.remove(entry.id)
                } else {
                    continue
                }
            }
            if var utterance = activeCaptions[entry.id] {
                if utterance.text != entry.text {
                    utterance.changedAt = now
                    // Same node, new sentence (not a live edit growing the text).
                    if !entry.text.hasPrefix(utterance.text) && !utterance.text.hasPrefix(entry.text) {
                        utterance.startedAt = now
                    }
                }
                utterance.speaker = entry.speaker
                utterance.text = entry.text
                activeCaptions[entry.id] = utterance
            } else {
                activeCaptions[entry.id] = Utterance(
                    speaker: entry.speaker, text: entry.text, startedAt: now, changedAt: now)
                captionOrder.append(entry.id)
            }
        }

        // Finalize what left the screen only after taking in what is on it.
        // An app can retire one element and put the same sentence up under
        // another in a single refresh, and finalizing first meant the
        // replacement was not there yet to be recognised as the same
        // utterance, so it was written twice.
        for id in captionOrder where !visible.contains(id) { finalizeCaption(id, at: now) }

        // Apps that keep finished utterances on screen need another way to tell
        // that one is done.
        if meetingApp.finalizesWhenSuperseded, let newest = entries.last?.id {
            for id in captionOrder where id != newest { finalizeCaption(id, at: now) }
        }
        if let idle = meetingApp.idleFinalizeSeconds {
            let newest = entries.last?.id
            for id in captionOrder {
                // The newest utterance may simply be paused mid-speech, so it
                // waits twice as long before idle finalization calls it done.
                let threshold = id == newest ? idle * 2 : idle
                guard let utterance = activeCaptions[id],
                      now.timeIntervalSince(utterance.changedAt) > threshold else { continue }
                finalizeCaption(id, at: now)
            }
        }
        guard recorder != nil || !captionOrder.isEmpty else { return }
        // Mirror every in-progress utterance; finished lines scroll above.
        let pending = Session.liveLines(captionOrder.compactMap { id -> Utterance? in
            guard let utterance = activeCaptions[id],
                  !supersededByActive(utterance, id: id) else { return nil }
            return utterance
        }, after: lastStamp)
        let shown = pending.enumerated().map { $0.offset == pending.count - 1 ? "\($0.element) ▍" : $0.element }
        live.set(shown)
        publishLive(shown)
    }

    /// So `--follow` can show in-progress speech. The daemon is not a tty, so
    /// LiveView's in-place region never appears in launchd.log.
    private func publishLive(_ pending: [String]) {
        let url = URL(fileURLWithPath: options.stateDirectory + "/live")
        do {
            try pending.joined(separator: "\n").write(to: url, atomically: true, encoding: .utf8)
        } catch {
            // This runs every poll while broken; say something occasionally,
            // not once per caption.
            guard Date().timeIntervalSince(lastPublishWarning) > 30 else { return }
            lastPublishWarning = Date()
            status("cannot update \(url.path): \(error.localizedDescription)")
        }
    }

    private func pollChat(now: Date) {
        guard let container = chatContainer else { return }
        let messages = meetingApp.chatMessages(in: container)
        if messages.isEmpty && axChildren(container).isEmpty { chatContainer = nil }
        for message in messages {
            if !chatBaselineDone {
                seenChatIDs.insert(message.id)
                continue
            }
            guard !seenChatIDs.contains(message.id) else { continue }
            let sent = Double(message.id).map { Date(timeIntervalSince1970: $0 / 1000) } ?? now
            // Identity commits immediately: the AX list is virtualized and the
            // message can vanish at any moment. If writes are broken, emit
            // queues it onto the ordered backlog instead of losing it.
            seenChatIDs.insert(message.id)
            emit(
                kind: "chat",
                speaker: message.author,
                body: message.text,
                at: sent > startedAt ? sent : now,
                extra: ["message_id": message.id]
            )
        }
        if !messages.isEmpty { chatBaselineDone = true }
    }

    /// When an utterance finishes, Teams often replaces its node with a fresh
    /// one holding the same (or corrected) text. Without this, the utterance
    /// gets written twice: once when the old node goes, once when the new does.
    private func supersededByActive(_ utterance: Utterance, id: String) -> Bool {
        guard !meetingApp.hasStableIdentity(id) else { return false }
        return activeCaptions.contains { key, other in
            key != id && other.speaker == utterance.speaker && other.text.hasPrefix(utterance.text)
        }
    }

    /// How long a written line keeps suppressing re-renders of itself. Genuine
    /// repetition ("Yes." ... "Yes.") has to survive, so this cannot be
    /// unbounded — it is a heuristic window, not a correctness guarantee.
    static let rewriteWindow: TimeInterval = 30

    /// Whether this utterance duplicates something already on disk.
    ///
    /// Matching is deliberately ASYMMETRIC. A written line suppresses the
    /// incoming one when the incoming text is a PREFIX of it (equality
    /// included) — the transcript already holds a superset, so skipping loses
    /// nothing. That covers a row re-read while only partly rendered, which
    /// exact-equality matching let straight through.
    ///
    /// The reverse is NOT suppressed. When the incoming text EXTENDS something
    /// written, the extension is content we do not have yet; dropping it to
    /// avoid a near-duplicate would trade a cosmetic problem for real data
    /// loss ("Okay" written, then the row grows to "Okay, and the other
    /// thing..."). Append-only files cannot amend the earlier line, so the
    /// pair is emitted and the fuller text wins on read.
    ///
    /// The window is measured from two different clocks on purpose:
    ///
    ///  - IDENTICAL text counts from `lastSeen`, which refreshWrittenLines
    ///    pushes forward for as long as the very same words are still on
    ///    screen. Teams re-creates finished rows with fresh ChromeAXNodeIds
    ///    while they linger, so each churn looks like a brand-new utterance;
    ///    counting from write time meant the row was re-emitted the moment the
    ///    30s window lapsed (~33s after the original, and again after that).
    ///  - A SHORTER PREFIX counts from write time, and so still expires. That
    ///    branch exists for partly-rendered re-reads, and letting an on-screen
    ///    row extend it would swallow genuine short utterances forever ("All
    ///    right." is a prefix of "All right, so this is sprint planning...").
    func alreadyWritten(_ utterance: Utterance, id: String, now: Date) -> Bool {
        guard !meetingApp.hasStableIdentity(id) else { return false }
        return written.contains {
            guard $0.speaker == utterance.speaker else { return false }
            if $0.text == utterance.text {
                return now.timeIntervalSince($0.lastSeen) < Session.rewriteWindow
            }
            return $0.text.hasPrefix(utterance.text)
                && now.timeIntervalSince($0.at) < Session.rewriteWindow
        }
    }

    /// Keep a written line's suppressor alive while the app is still showing
    /// it. Exact matches only: a row that merely starts with the written text
    /// may be a different, genuinely shorter utterance (see alreadyWritten).
    func refreshWrittenLines(visibleIn entries: [CaptionEntry], now: Date) {
        guard !written.isEmpty, !entries.isEmpty else { return }
        for index in written.indices {
            let line = written[index]
            guard entries.contains(where: { $0.speaker == line.speaker && $0.text == line.text })
            else { continue }
            written[index].lastSeen = now
        }
    }

    /// Whether a row we already finalized has GENUINELY grown since, and so
    /// must be re-opened rather than skipped (Zoom keeps extending a row after
    /// it has gone idle).
    ///
    /// Judged against this row's own text at finalize time. The older form of
    /// this check scanned `written` for anything the current text extends,
    /// which meant a row that Teams froze mid-revision — leaving it a strict
    /// extension of its own earlier, shorter write — looked like it was still
    /// growing on every single poll. That re-opened it forever, and the only
    /// brake was alreadyWritten's 30s TTL, so the frozen row was re-emitted
    /// every ~33s for as long as it stayed on screen.
    func reopensAfterGrowth(id: String, text: String) -> Bool {
        guard let atFinalize = finalizedText[id] else { return false }
        return text != atFinalize && text.hasPrefix(atFinalize)
    }

    /// What a row still owes the transcript: the part of `text` that has not
    /// been written for this row yet.
    ///
    /// Captions grow in place, and an append-only file cannot amend the line it
    /// already wrote. When a row that was written keeps growing, writing the
    /// whole row again repeats everything the reader has — the same sentence
    /// three times with three words added. Writing only the new tail keeps the
    /// file lossless and readable: the row's words appear exactly once, in
    /// order, split across as many lines as it took the speaker to say them.
    ///
    /// Returns nil when the row has nothing new to say, and the whole text when
    /// the row was REPLACED rather than extended (a recycled node holding a
    /// different sentence owes all of it).
    static func unwrittenPart(of text: String, alreadyEmitted: String?) -> String? {
        guard let alreadyEmitted, text.hasPrefix(alreadyEmitted) else { return text }
        let tail = String(text.dropFirst(alreadyEmitted.count))
            .trimmingCharacters(in: .whitespaces)
        return tail.isEmpty ? nil : tail
    }

    private func finalizeCaption(_ id: String, at date: Date) {
        guard let utterance = activeCaptions.removeValue(forKey: id) else { return }
        captionOrder.removeAll { $0 == id }
        finalized.insert(id)
        finalizedText[id] = utterance.text
        guard !utterance.text.isEmpty else { return }
        guard !supersededByActive(utterance, id: id), !alreadyWritten(utterance, id: id, now: date) else { return }
        // A row picking up where it left off contributes only its new tail.
        guard let body = Session.unwrittenPart(of: utterance.text, alreadyEmitted: emittedText[id])
        else { return }
        var extra: [String: Any] = [
            "node_id": id,
            "ended_at": Recorder.isoFormatter.string(from: date)
        ]
        if body != utterance.text {
            // The jsonl says so explicitly; `text` is the tail, not the row.
            extra["continues"] = true
        }
        // emit queues failed writes onto the ordered backlog, which finish()
        // drains before declaring loss — so committing dedup state here is
        // always safe.
        emit(
            kind: "caption",
            speaker: utterance.speaker,
            body: body,
            at: utterance.startedAt,
            extra: extra
        )
        emittedText[id] = utterance.text
        // The dedup ledger holds the WHOLE row, not the tail we wrote: it
        // answers "have we already heard these words", which is what a
        // re-render under a fresh node id has to be matched against.
        written.append(WrittenLine(speaker: utterance.speaker, text: utterance.text, at: date))
        if written.count > 40 { written.removeFirst(written.count - 40) }
    }

    /// Flush in-flight captions and close out the transcript. Safe to call more
    /// than once (leave detection and process exit both do).
    func finish(at date: Date) {
        guard !finished else { return }
        finished = true
        live.erase()
        // Finalize every pending utterance. finalizeCaption hands failures to
        // the ordered backlog, and no poll follows a finish — so drain that
        // backlog here on a short bounded deadline before declaring loss.
        // The deadline is wall-clock NOW (or the injected test clock), not the
        // caller's meeting timestamp: endSession captures that date before
        // multi-second AX round-trips, and an already-expired deadline would
        // mean zero retries.
        let deadline = clock.now().addingTimeInterval(5)
        var drainNote: String?
        repeat {
            for id in captionOrder { finalizeCaption(id, at: date) }
            // Keep the last non-nil cause: a nil here means the deadline cut
            // the drain off, not that nothing failed.
            if let note = drainPendingWrites(until: deadline) { drainNote = note }
            if !captionOrder.isEmpty || !pendingWrites.isEmpty {
                sleepFn(250_000)
            }
        } while (!captionOrder.isEmpty || !pendingWrites.isEmpty) && clock.now() < deadline
        removeStateFile(options.stateDirectory + "/live")
        removeStateFile(options.stateDirectory + "/current")
        // Known data loss is always reported — even with no recorder at all
        // (nothing ever initialized), even under --quiet, even if the stopped
        // event itself fails to write.
        let lost = captionOrder.count + pendingWrites.count
        if lost > 0 {
            var message = "\(lost) item(s) of \"\(title)\" could not be written and are lost"
            if let note = drainNote {
                message += "\n  last failure: \(note)"
            } else {
                message += "\n  retry deadline expired before all remaining writes completed; earlier errors are logged above"
            }
            message += "\n  check free space and permissions for \(options.directory)"
            status(message)
        }
        guard let writer = recorder else { return }
        // A duration is time spent recording — not whatever the transcript
        // stamps happen to count from (Slack/Meet stamps are the time of day).
        let duration = elapsedString(from: startedAt, to: date)
        // Only claim "finished" if the stopped event landed; writeJSON has
        // already logged the failure otherwise. Loss (if any) was reported above.
        if writer.writeJSON([
            "type": "metadata",
            "event": "stopped",
            "stopped_at": Recorder.isoFormatter.string(from: date),
            "duration": duration,
            "lost_events": lost
        ]), !options.quiet {
            status("finished \"\(title)\" after \(duration)")
        }
    }
}

// MARK: - Single instance, and following someone else's transcript

/// Hold an exclusive lock for the lifetime of the process. Two capturers on one
/// meeting would write two transcripts of the same words.
func acquireLock(_ path: String) -> Int32? {
    let descriptor = open(path, O_CREAT | O_RDWR, 0o644)
    guard descriptor >= 0 else { return nil }
    guard flock(descriptor, LOCK_EX | LOCK_NB) == 0 else {
        close(descriptor)
        return nil
    }
    return descriptor
}

func newestTranscript(in directory: String) -> URL? {
    let url = URL(fileURLWithPath: directory, isDirectory: true)
    let keys: [URLResourceKey] = [.contentModificationDateKey]
    guard let entries = try? FileManager.default.contentsOfDirectory(
        at: url, includingPropertiesForKeys: keys) else { return nil }
    func modified(_ file: URL) -> Date {
        (try? file.resourceValues(forKeys: Set(keys)))?.contentModificationDate ?? .distantPast
    }
    return entries.filter { $0.pathExtension == "txt" }.max { modified($0) < modified($1) }
}

/// What became of reading a state/transcript file. `.absent` is normal while
/// idle — the pointer only exists during a meeting; swallowing anything else
/// would make --follow sit silent through real I/O trouble.
enum FileRead {
    case data(String)
    case absent
    case failed(Error)
}

/// Only genuine "the file is not there" counts as absent; everything else is
/// a real failure that callers must surface. NSFileReadUnknownError (=256) is a
/// GENERIC read failure — EIO, ESTALE, etc. all surface as 256 — so it only
/// counts as missing when the wrapped POSIX error is specifically ENOENT.
func isMissingFileError(_ error: NSError) -> Bool {
    guard error.domain == NSCocoaErrorDomain else { return posixENOENT(error) }
    switch error.code {
    case NSFileNoSuchFileError, NSFileReadNoSuchFileError:
        return true
    case NSFileReadUnknownError:
        return posixENOENT(error)
    default:
        return false
    }
}

private func posixENOENT(_ error: NSError) -> Bool {
    let underlying = error.userInfo[NSUnderlyingErrorKey] as? NSError ?? error
    return underlying.domain == NSPOSIXErrorDomain && underlying.code == Int(ENOENT)
}

func readFile(_ path: String) -> FileRead {
    do { return .data(try String(contentsOfFile: path, encoding: .utf8)) }
    catch let error as NSError where isMissingFileError(error) {
        return .absent
    }
    catch { return .failed(error) }
}

/// Remove a state file, tolerating only its absence; anything else is worth
/// hearing about, since a stale pointer sends --follow to a dead transcript.
func removeStateFile(_ path: String) {
    do { try FileManager.default.removeItem(atPath: path) }
    catch let error as NSError where isMissingFileError(error) {}
    catch { status("cannot remove \(path): \(error.localizedDescription)") }
}

/// Append whatever appeared past `offset` in a growing file to `sink`, and
/// return the offset to resume from. Existence is checked with a throwing
/// call (only genuine not-found counts as absent); seek and read use the
/// throwing FileHandle APIs so real I/O failures reach `warn`. `beforeWrite`
/// runs after bytes are in hand but before they are printed, so callers can
/// erase their live region first — permanent lines must not land under an
/// unterminated caption. Source failures leave the offset untouched (bytes
/// will be re-read next poll); SINK failures throw, because retrying a broken
/// output would either spin forever or duplicate the already-printed bytes.
func drainFileTail(_ path: String, from offset: UInt64, into sink: FileHandle,
                   beforeWrite: () -> Void, warn: (String) -> Void) throws -> UInt64 {
    do {
        _ = try FileManager.default.attributesOfItem(atPath: path)
    } catch let error as NSError where !isMissingFileError(error) {
        warn("cannot stat \(path): \(error.localizedDescription)")
        return offset
    } catch {
        return offset // absent: normal while idle
    }
    guard let handle = FileHandle(forReadingAtPath: path) else {
        warn("cannot open \(path)")
        return offset
    }
    defer { try? handle.close() } // closing is inconsequential; reading is not
    // Source reads: failures are retryable, so warn and leave the offset put.
    let data: Data
    do {
        try handle.seek(toOffset: offset)
        guard let read = try handle.readToEnd(), !read.isEmpty else { return offset }
        data = read
    } catch {
        warn("cannot tail \(path): \(error.localizedDescription)")
        return offset
    }
    beforeWrite()
    // The sink write happens outside the catch above on purpose: a broken
    // output would either spin forever or duplicate the printed bytes, so its
    // error propagates to the caller instead of being retried here.
    try sink.write(contentsOf: data)
    return offset + UInt64(data.count)
}

/// Tail the meeting the daemon is recording. Prefers the `current` pointer
/// (set when the first line is written) so we never reopen last week's Zoom
/// file. In-progress speech lives in `live` because the daemon is not a tty
/// and Teams does not write a line until it settles.
func followTranscripts(_ options: Options) {
    let stdout = FileHandle.standardOutput
    var current: URL?
    var offset: UInt64 = 0
    var lastLive = ""
    var liveRows = 0
    var lastScan = Date.distantPast
    var logOffset: UInt64 = 0
    let pointer = options.stateDirectory + "/current"
    let livePath = options.stateDirectory + "/live"
    let logURL = URL(fileURLWithPath: options.stateDirectory + "/launchd.log")
    if let attrs = try? FileManager.default.attributesOfItem(atPath: logURL.path),
       let size = attrs[.size] as? UInt64 {
        logOffset = size
    }
    if !options.quiet { status("following \(options.directory)") }
    // Real I/O trouble (permissions, a full disk) deserves a mention, but not
    // one per poll. Keyed by message so alternating failures each get through.
    var warnedAt: [String: Date] = [:]
    func warnThrottled(_ message: String) {
        let now = Date()
        if let at = warnedAt[message], now.timeIntervalSince(at) < 30 { return }
        warnedAt[message] = now
        status(message)
    }

    func eraseLive() {
        guard liveRows > 0, isatty(STDOUT_FILENO) == 1 else { liveRows = 0; return }
        var escape = "\r\u{1B}[2K"
        for _ in 1..<liveRows { escape += "\u{1B}[1A\u{1B}[2K" }
        stdout.write(Data(escape.utf8))
        liveRows = 0
    }

    while !stopRequested {
        let now = Date()
        if now.timeIntervalSince(lastScan) > 0.4 {
            lastScan = now
            switch readFile(pointer) {
            case .data(let path):
                let url = URL(fileURLWithPath: path.trimmingCharacters(in: .whitespacesAndNewlines))
                if url != current {
                    eraseLive()
                    current = url
                    offset = 0
                    if !options.quiet { status(url.lastPathComponent) }
                }
            case .absent:
                if current != nil {
                    eraseLive()
                    current = nil
                    offset = 0
                    lastLive = ""
                    if !options.quiet { status("waiting for the next meeting") }
                }
            case .failed(let error):
                warnThrottled("cannot read active-transcript pointer \(pointer): \(error.localizedDescription)")
            }
            do {
                logOffset = try drainFileTail(logURL.path, from: logOffset, into: stdout,
                    beforeWrite: { eraseLive(); lastLive = "" },
                    warn: warnThrottled)
            } catch {
                // The output stream itself broke (pipe closed, disk full);
                // retrying would spin forever or duplicate printed bytes.
                eraseLive()
                status("output failed; --follow cannot continue: \(error.localizedDescription)")
                exit(1)
            }
        }
        if let current {
            if FileManager.default.fileExists(atPath: current.path) {
                do {
                    offset = try drainFileTail(current.path, from: offset, into: stdout,
                        beforeWrite: {
                            eraseLive()
                            // redraw the live region under the new permanent lines
                            lastLive = ""
                        },
                        warn: warnThrottled)
                } catch {
                    eraseLive()
                    status("output failed; --follow cannot continue: \(error.localizedDescription)")
                    exit(1)
                }
            } else {
                warnThrottled("transcript \(current.path) has vanished")
            }
        }
        let liveText: String
        switch readFile(livePath) {
        case .data(let text): liveText = text
        case .absent: liveText = ""
        case .failed(let error):
            // Keep what is already drawn rather than flapping on every read.
            liveText = lastLive
            warnThrottled("cannot read \(livePath): \(error.localizedDescription)")
        }
        if liveText != lastLive {
            eraseLive()
            lastLive = liveText
            let rendered = LiveView.layout(
                liveText.trimmingCharacters(in: .newlines)
                    .split(separator: "\n", omittingEmptySubsequences: false)
                    .map(String.init)
            )
            if !rendered.isEmpty {
                stdout.write(Data(rendered.joined(separator: "\n").utf8))
                liveRows = rendered.count
            }
        }
        usleep(250_000)
    }
    eraseLive()
    // On the way out, say where the words went. The filename alone was shown
    // when the meeting started, which may be a long way up the scrollback.
    if let transcript = current ?? newestTranscript(in: options.directory) {
        var report = "transcript: \(transcript.path)"
        let json = transcript.deletingPathExtension().appendingPathExtension("jsonl")
        if FileManager.default.fileExists(atPath: json.path) { report += "\n  jsonl: \(json.path)" }
        stdout.write(Data("\n".utf8)) // stand the report off from the last thing said
        status(report)
    }
}

// The flag lives above the entry-point marker so it survives tests/run.sh's
// strip; followTranscripts polls it.
var stopRequested = false

// MARK: - Main

// Everything from here down is the daemon's entry point; tests/run.sh strips
// this section so the rest of the file compiles as a plain module.
signal(SIGINT) { _ in stopRequested = true }
signal(SIGTERM) { _ in stopRequested = true }

/// `meeting-capture people-snapshot`: one roster, printed. The daemon records
/// the same snapshot itself (see Session.maintainRoster); this is for when you
/// want one right now, or want to see whether the reading works at all.
func peopleSnapshot(app: MeetingApp, pid: pid_t, json: Bool) -> Never {
    let snapshot: RosterSnapshot
    switch app.captureRoster(pid: pid, deadline: nil) {
    case .captured(let captured): snapshot = captured
    case .deferred(let why), .failed(let why): fail(why)
    }
    if json {
        var payload: [String: Any] = [
            "type": "people-snapshot", "app": app.id, "pid": pid,
            "people": snapshot.people.map { ["name": $0.name, "key": $0.key] },
            "confirmed": snapshot.confirmed,
        ]
        if let expected = snapshot.expected { payload["count"] = expected }
        guard let data = try? JSONSerialization.data(withJSONObject: payload, options: [.sortedKeys]),
              let text = String(data: data, encoding: .utf8) else {
            fail("could not encode the snapshot")
        }
        print(text)
    } else {
        print(snapshot.headline)
        for person in snapshot.people { print("  \(person.name)") }
    }
    exit(0)
}

let options = parseOptions()

if options.subcommand == "people-snapshot" {
    guard AXIsProcessTrusted() else {
        fail("no Accessibility permission — grant it in System Settings → Privacy & Security → Accessibility")
    }
    // Which app to ask. --app names one; otherwise take the first roster-
    // capable app that is actually running, so the command works in a Meet
    // call and a Teams call without being told which.
    let candidates = supportedApps.filter(\.supportsRosterSnapshot).filter {
        options.app == nil || $0.id == options.app
    }
    guard !candidates.isEmpty else {
        fail("no app that can list participants was asked for (known: "
             + supportedApps.filter(\.supportsRosterSnapshot).map(\.id).joined(separator: ", ") + ")")
    }
    var target: (app: MeetingApp, pid: pid_t)?
    if let forced = options.pid, let only = candidates.first, candidates.count == 1 {
        target = (only, forced)
    } else {
        for candidate in candidates {
            if case .running(let found) = queryProcess(matching: candidate.processPattern) {
                target = (candidate, found)
                break
            }
        }
    }
    guard let target else {
        fail(candidates.map(\.displayName).joined(separator: " or ") + " is not running")
    }
    peopleSnapshot(app: target.app, pid: target.pid, json: options.jsonToStdout)
}
let live = LiveView(options: options)

if options.follow {
    followTranscripts(options)
    exit(0)
}

guard AXIsProcessTrusted() else {
    fail("no Accessibility permission — grant it in System Settings → Privacy & Security → Accessibility")
}

try? FileManager.default.createDirectory(
    atPath: options.stateDirectory, withIntermediateDirectories: true)
let lockDescriptor = acquireLock(options.stateDirectory + "/lock")
if lockDescriptor == nil {
    // Someone else is recording this meeting — show it rather than duplicate it.
    guard isatty(STDOUT_FILENO) == 1, !options.once else {
        fail("another meeting-capture is already recording")
    }
    status("another meeting-capture is already recording; following it instead")
    followTranscripts(options)
    exit(0)
}

let wanted: [MeetingApp] = {
    guard let name = options.app else { return supportedApps }
    guard let match = supportedApps.first(where: { $0.id == name }) else {
        fail("unknown app: \(name) (known: \(supportedApps.map(\.id).joined(separator: ", ")))")
    }
    return [match]
}()

func attach(_ meetingApp: MeetingApp, pid: pid_t) -> Attachment {
    let element = AXUIElementCreateApplication(pid)
    // Generous: a busy app can take seconds to answer, and a timed-out read is
    // indistinguishable from "the meeting ended".
    AXUIElementSetMessagingTimeout(element, 5.0)
    return Attachment(meetingApp: meetingApp, pid: pid, element: element)
}

/// Every wanted app that is currently running.
func runningApps() -> [Attachment] {
    if let forced = options.pid {
        return wanted.map { attach($0, pid: forced) }
    }
    // One snapshot, four patterns: four separate lookups used to mean four
    // process spawns, and the list does not change in the time between them.
    let running = NSWorkspace.shared.runningApplications
    var attachments = wanted.compactMap { meetingApp -> Attachment? in
        let match = running.first {
            processMatches(pattern: meetingApp.processPattern,
                           executable: $0.executableURL?.path ?? "",
                           bundle: $0.bundleURL?.path ?? "")
        }
        return match.map { attach(meetingApp, pid: $0.processIdentifier) }
    }
    // The snapshot can decay out from under a long-lived process — three days
    // blind once. When the cheap list cannot see one of the apps we want, take
    // a second opinion from pgrep: a spawn a minute is nothing, and it sees
    // the truth every time because it reads the process table, not a cache.
    let unmatched = wanted.filter { app in
        !attachments.contains { $0.meetingApp.id == app.id }
    }
    if !unmatched.isEmpty, Date().timeIntervalSince(lastPgrepScanAt) >= 60 {
        lastPgrepScanAt = Date()
        for meetingApp in unmatched {
            switch pgrepLookup(matching: meetingApp.processPattern) {
            case .running(let found):
                attachments.append(attach(meetingApp, pid: found))
            case .notRunning:
                break
            case .failed(let why):
                noteProcessLookupFailure("cannot look up \(meetingApp.displayName): \(why)")
            }
        }
    }
    return attachments
}

var attachment: Attachment?
var session: Session?
var waker = TreeWaker(quiet: options.quiet)
var leaveMissingSince: Date?
var treeUnreadableSince: Date?

if options.once {
    // Attach to a meeting, not merely to a running app: an idle Teams must not
    // shadow an active Zoom. Web-view apps get woken here too, since a freshly
    // launched one looks like nothing at all until its tree fills in.
    var found: Attachment?
    for _ in 0..<20 {
        let now = Date()
        found = runningApps().filter { waker.ensureReadable($0, now: now) }
            .first { $0.meetingApp.meetingAnchor($0.element) != nil }
        if found != nil { break }
        usleep(500_000)
    }
    guard let found else {
        fail("no active meeting in \(wanted.map(\.displayName).joined(separator: ", "))")
    }
    attachment = found
    let anchor = found.meetingApp.meetingAnchor(found.element)
    session = Session(
        options: options,
        live: live,
        meetingApp: found.meetingApp,
        title: found.meetingApp.meetingTitle(found.element, anchor: anchor)
    )
} else if !options.quiet {
    status("watching for meetings in \(wanted.map(\.displayName).joined(separator: ", "))…")
}

var lastMeetingCheck = Date.distantPast
var lastUnreadableWarning = Date.distantPast
/// Apps last reported as "running, waiting for a meeting" — idle logs only
/// fire when this set changes, so an app sitting open all day stays silent.
var lastWaitingApps: [String] = []
var lastProcessWarning = Date.distantPast

while !stopRequested {
    let now = Date()

    // Scanning trees is expensive, and pointless several times a second:
    // joining and leaving are not that urgent.
    if !options.once && now.timeIntervalSince(lastMeetingCheck) >= 2 {
        lastMeetingCheck = now

        if session == nil {
            // Look for a call in any supported app, re-resolving pids as apps
            // are quit and reopened.
            let candidates = runningApps()
            // Drop wake bookkeeping for pids that no longer exist so app
            // restarts start fresh. LOAD-BEARING: the attached session's pid
            // rides along unconditionally — a pid lookup can miss it transiently, and
            // pruning its entry mid-hollow-period would reset the attempt
            // counts the "hollow for Ns" warnings count on.
            let alive = Set(candidates.map(\.pid)).union(attachment.map { [$0.pid] } ?? [])
            waker.prune(alive: alive)
            var unreadable: [String] = []
            var waiting: [String] = []
            for candidate in candidates {
                guard waker.ensureReadable(candidate, now: now) else {
                    unreadable.append(candidate.meetingApp.displayName)
                    continue
                }
                guard let anchor = candidate.meetingApp.meetingAnchor(candidate.element) else {
                    waiting.append(candidate.meetingApp.displayName)
                    continue
                }
                let title = candidate.meetingApp.meetingTitle(candidate.element, anchor: anchor)
                attachment = candidate
                session = Session(options: options, live: live, meetingApp: candidate.meetingApp, title: title)
                leaveMissingSince = nil
                if !options.quiet {
                    status("joined \"\(title)\" in \(candidate.meetingApp.displayName) (pid \(candidate.pid))")
                }
                break
            }
            if session == nil, !unreadable.isEmpty, now.timeIntervalSince(lastUnreadableWarning) > 60 {
                lastUnreadableWarning = now
                if !options.quiet {
                    status("cannot read the accessibility tree of \(unreadable.joined(separator: ", "))")
                }
            }
            if session == nil, !waiting.isEmpty, waiting != lastWaitingApps {
                // Transition log (app opened/quit/reopened), not a heartbeat:
                // a Slack idling all day would otherwise spam every 30s.
                lastWaitingApps = waiting
                if !options.quiet {
                    status("\(waiting.joined(separator: ", ")) is running, waiting for a meeting")
                }
            } else if session != nil || waiting.isEmpty {
                lastWaitingApps = []
            }
        } else if let current = attachment {
            func endSession(_ reason: String) {
                if !options.quiet { status("\(reason), ending session") }
                session?.finish(at: now)
                session = nil
                attachment = nil
                leaveMissingSince = nil
                treeUnreadableSince = nil
            }

            if let forced = options.pid {
                if forced != current.pid {
                    endSession("\(current.meetingApp.displayName) restarted")
                }
            } else {
                switch queryProcess(matching: current.meetingApp.processPattern) {
                case .running(let livePID):
                    // A new pid means a different instance entirely.
                    if livePID != current.pid {
                        endSession("\(current.meetingApp.displayName) restarted")
                    }
                case .notRunning:
                    // The lookup is name-based against a snapshot that can go
                    // stale; the pid itself is the ground truth. A pid that is
                    // still alive means the snapshot is lying — a blind lookup
                    // once ran for three days and would have called every
                    // meeting over the moment it started.
                    if kill(current.pid, 0) == 0 || errno == EPERM {
                        if now.timeIntervalSince(lastProcessWarning) > 60 {
                            lastProcessWarning = now
                            status("\(current.meetingApp.displayName) is running but the app list cannot see it; trusting the process")
                        }
                    } else {
                        // Quitting the app ends the meeting as surely as leaving does.
                        endSession("\(current.meetingApp.displayName) quit")
                    }
                case .failed(let why):
                    // The lookup itself failed; that says nothing about the app,
                    // and ending the session here would truncate an active meeting.
                    if now.timeIntervalSince(lastProcessWarning) > 60 {
                        lastProcessWarning = now
                        status("cannot tell whether \(current.meetingApp.displayName) is still running (\(why)); assuming it is")
                    }
                }
            }
            if session != nil && axChildren(current.element).isEmpty {
                // A failed read is not evidence that the call ended — but if it
                // never recovers we are stuck watching a tree that will never
                // answer, and would miss every later meeting.
                let since = treeUnreadableSince ?? now
                treeUnreadableSince = since
                if now.timeIntervalSince(since) > 30 {
                    endSession("lost the \(current.meetingApp.displayName) accessibility tree")
                } else if now.timeIntervalSince(lastUnreadableWarning) > 60 {
                    lastUnreadableWarning = now
                    if !options.quiet {
                        status("cannot read the \(current.meetingApp.displayName) accessibility tree")
                    }
                }
            } else if current.meetingApp.meetingAnchor(current.element) != nil {
                leaveMissingSince = nil
                treeUnreadableSince = nil
            } else {
                treeUnreadableSince = nil
                // Debounce: the Leave button vanishes during UI transitions.
                let missingSince = leaveMissingSince ?? now
                leaveMissingSince = missingSince
                if now.timeIntervalSince(missingSince) > 10 {
                    endSession("left \"\(session?.title ?? "")\"")
                }
            }
        }
    }

    if let active = session, let current = attachment {
        active.tick(app: current.element, pid: current.pid, now: now)
        usleep(options.intervalMs * 1000)
    } else {
        usleep(options.idleIntervalMs * 1000)
    }
}

session?.finish(at: Date())


