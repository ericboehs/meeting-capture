#!/usr/bin/env swift

// meeting-capture — continuously extract live captions and meeting chat from
// macOS conferencing apps via the Accessibility (AX) API.
//
// Apps keep only a handful of live caption entries on screen at a time, so this
// polls the accessibility tree and finalizes each utterance as it scrolls away.
//
//   meeting-capture              follow the running daemon, or capture if none
//   meeting-capture --once       capture the current meeting only, Ctrl-C to stop
//
// Output (default ~/.local/share/meeting-capture), created on first captured
// line so meetings without captions leave no empty files behind:
//   YYYYMMDD_HHMMSS-<meeting-slug>.jsonl   structured events
//   YYYYMMDD_HHMMSS-<meeting-slug>.txt     readable transcript
//
// Requires Accessibility permission for whatever runs this (terminal, or the
// compiled binary when run from launchd).

import ApplicationServices
import AppKit
import CoreGraphics
import Foundation

// MARK: - Options

struct Options {
    var intervalMs: UInt32 = 250
    var idleIntervalMs: UInt32 = 2000
    var directory: String = {
        let base = ProcessInfo.processInfo.environment["XDG_DATA_HOME"]
            ?? NSHomeDirectory() + "/.local/share"
        return base + "/meeting-capture"
    }()
    var captureCaptions = true
    var captureChat = true
    var includeChatBacklog = false
    var autoCaptions = false
    var once = false
    var follow = false
    var jsonToStdout = false
    var quiet = false
    var pid: pid_t?
    var app: String?
    var stateDirectory: String = {
        let base = ProcessInfo.processInfo.environment["XDG_STATE_HOME"]
            ?? NSHomeDirectory() + "/.local/state"
        return base + "/meeting-capture"
    }()
}

func usage() -> String {
    """
    usage: meeting-capture [options]

    With no options: record every meeting, one transcript each, forever. If
    another meeting-capture (e.g. the launchd agent) already holds the lock,
    follow its transcript instead of fighting it for the same meeting.

      --once               capture only the meeting happening now, then stop
      --follow             just watch whatever the daemon is recording, never
                           record (--watch does the same)
      --app <name>         only watch one app (\(supportedApps.map(\.id).joined(separator: ", ")))
      --auto-captions      turn live captions on when a meeting starts
      --interval <ms>      poll interval while in a meeting (default 250)
      --idle-interval <ms> poll interval while waiting for one (default 2000)
      --dir <path>         output directory (default $XDG_DATA_HOME/meeting-capture)
      --no-captions        skip live captions
      --no-chat            skip meeting chat
      --chat-backlog       also record chat already on screen when joining
      --json               print JSONL to stdout instead of pretty lines
      --quiet              no stdout output
      --pid <pid>          app pid (default: autodetect, refreshed as needed)
      -h, --help           this help

    Files are only created once there is something to write. Ctrl-C flushes
    any in-flight captions.
    """
}

func fail(_ message: String) -> Never {
    FileHandle.standardError.write(Data("meeting-capture: \(message)\n".utf8))
    exit(1)
}

func parseOptions() -> Options {
    var options = Options()
    var args = Array(CommandLine.arguments.dropFirst())
    func next(_ flag: String) -> String {
        guard !args.isEmpty else { fail("missing value for \(flag)") }
        return args.removeFirst()
    }
    while !args.isEmpty {
        let flag = args.removeFirst()
        switch flag {
        case "--watch": options.follow = true // reads as the passive verb; treat it as one
        case "--once": options.once = true
        case "--follow": options.follow = true
        case "--auto-captions": options.autoCaptions = true
        case "--interval": options.intervalMs = UInt32(next(flag)) ?? options.intervalMs
        case "--idle-interval": options.idleIntervalMs = UInt32(next(flag)) ?? options.idleIntervalMs
        case "--dir": options.directory = (next(flag) as NSString).expandingTildeInPath
        case "--no-captions": options.captureCaptions = false
        case "--no-chat": options.captureChat = false
        case "--chat-backlog": options.includeChatBacklog = true
        case "--json": options.jsonToStdout = true
        case "--quiet": options.quiet = true
        case "--pid": options.pid = pid_t(next(flag))
        case "--app": options.app = next(flag).lowercased()
        case "-h", "--help": print(usage()); exit(0)
        default: fail("unknown option: \(flag)\n\n\(usage())")
        }
    }
    return options
}

func status(_ message: String) {
    let stamp = Recorder.isoFormatter.string(from: Date())
    FileHandle.standardError.write(Data("[\(stamp)] meeting-capture: \(message)\n".utf8))
}

// MARK: - Accessibility helpers

func axAttribute(_ element: AXUIElement, _ name: String) -> CFTypeRef? {
    var value: CFTypeRef?
    guard AXUIElementCopyAttributeValue(element, name as CFString, &value) == .success else { return nil }
    return value
}

func axString(_ element: AXUIElement, _ name: String) -> String {
    axAttribute(element, name) as? String ?? ""
}

func axChildren(_ element: AXUIElement) -> [AXUIElement] {
    axAttribute(element, kAXChildrenAttribute) as? [AXUIElement] ?? []
}

func axParent(_ element: AXUIElement) -> AXUIElement? {
    guard let value = axAttribute(element, kAXParentAttribute), CFGetTypeID(value) == AXUIElementGetTypeID() else { return nil }
    return (value as! AXUIElement)
}

func axClasses(_ element: AXUIElement) -> [String] {
    axAttribute(element, "AXDOMClassList") as? [String] ?? []
}

func axDomID(_ element: AXUIElement) -> String { axString(element, "AXDOMIdentifier") }

/// Native apps expose AXIdentifier where Chromium ones expose DOM ids.
func axIdentifier(_ element: AXUIElement) -> String { axString(element, "AXIdentifier") }

func axDescription(_ element: AXUIElement) -> String { axString(element, kAXDescriptionAttribute) }

func axNodeID(_ element: AXUIElement) -> String { axString(element, "ChromeAXNodeId") }

/// Visible text of a subtree, in document order, without the duplication you
/// get from naively concatenating value/title/description of every node.
func axText(_ element: AXUIElement, depth: Int = 0) -> String {
    guard depth < 24 else { return "" }
    let role = axString(element, kAXRoleAttribute)
    if role == "AXStaticText" || role == "AXHeading" || role == "AXLink" {
        for key in [kAXValueAttribute, kAXTitleAttribute, kAXDescriptionAttribute] {
            let value = axString(element, key).trimmingCharacters(in: .whitespacesAndNewlines)
            if !value.isEmpty { return value }
        }
        return ""
    }
    let parts = axChildren(element).map { axText($0, depth: depth + 1) }.filter { !$0.isEmpty }
    return parts.joined(separator: " ")
}

/// Static text leaves of a subtree, in order.
func axStaticTexts(_ element: AXUIElement, depth: Int = 0) -> [String] {
    guard depth < 24 else { return [] }
    if axString(element, kAXRoleAttribute) == "AXStaticText" {
        let value = axString(element, kAXValueAttribute).trimmingCharacters(in: .whitespacesAndNewlines)
        return value.isEmpty ? [] : [value]
    }
    return axChildren(element).flatMap { axStaticTexts($0, depth: depth + 1) }
}

func findElement(from root: AXUIElement, depth: Int = 0, where match: (AXUIElement) -> Bool) -> AXUIElement? {
    guard depth < 80 else { return nil }
    if match(root) { return root }
    for child in axChildren(root) {
        if let hit = findElement(from: child, depth: depth + 1, where: match) { return hit }
    }
    return nil
}

// MARK: - Recording

struct Utterance {
    var speaker: String
    var text: String
    var startedAt: Date
    var changedAt: Date
}

/// The scrolling terminal view: finished lines scroll up, in-progress speech
/// updates in place below them (like `tail -f`). Independent of the files, so a
/// meeting can be displayed before it has written anything.
final class LiveView {
    private let stdout = FileHandle.standardOutput
    /// Only a terminal gets the transcript drawn on stdout. Under launchd stdout
    /// is the log, and every finished line was landing there as well as in the
    /// .txt — so --follow, which tails both, drew each line twice.
    private let isInteractive: Bool
    private var lines: [String] = []

    init(options: Options) {
        isInteractive = !options.quiet && !options.jsonToStdout && isatty(STDOUT_FILENO) == 1
    }

    static func terminalWidth() -> Int {
        var size = winsize()
        if ioctl(STDOUT_FILENO, UInt(TIOCGWINSZ), &size) == 0, size.ws_col > 0 { return Int(size.ws_col) }
        return 100
    }

    static func terminalHeight() -> Int {
        var size = winsize()
        if ioctl(STDOUT_FILENO, UInt(TIOCGWINSZ), &size) == 0, size.ws_row > 0 { return Int(size.ws_row) }
        return 24
    }

    /// Break a line into rows that fit the terminal.
    ///
    /// The live region is erased by moving up one row per line we drew, so the
    /// count has to match what the terminal actually used. Letting a line
    /// soft-wrap would make it occupy several rows, and the region would stack
    /// up instead of being replaced. Truncating kept the count honest but hid
    /// the end of every sentence, which is exactly the part being spoken, so
    /// wrap here and report the real number of rows instead. Stay a column
    /// short of the width: filling the last one makes some terminals wrap by
    /// themselves. (Counting is by String.count, which approximates display
    /// columns; CJK text and emoji wrap at display width everywhere, so a
    /// row's String.count can understate the columns it really occupies.)
    static func wrap(_ text: String, width: Int) -> [String] {
        let limit = max(8, width - 1)
        guard text.count > limit else { return [text] }
        var rows: [String] = []
        var line = ""
        for word in text.split(separator: " ") {
            var word = String(word)
            // A word too long to ever fit has to be broken somewhere.
            while word.count > limit {
                if !line.isEmpty { rows.append(line); line = "" }
                rows.append(String(word.prefix(limit)))
                word = String(word.dropFirst(limit))
            }
            if line.isEmpty {
                line = word
            } else if line.count + 1 + word.count <= limit {
                line += " " + word
            } else {
                rows.append(line)
                line = word
            }
        }
        if !line.isEmpty { rows.append(line) }
        return rows
    }

    /// Wrap every pending line, keeping the most recent rows if the result is
    /// taller than the terminal: the newest words matter most, and erasing more
    /// rows than the screen has would eat the transcript above.
    static func layout(_ pending: [String]) -> [String] {
        let width = terminalWidth()
        let rows = pending
            .flatMap { wrap($0.replacingOccurrences(of: "\n", with: " "), width: width) }
            .filter { !$0.isEmpty }
        let ceiling = max(1, terminalHeight() - 1)
        return rows.count > ceiling ? Array(rows.suffix(ceiling)) : rows
    }

    /// Erase the region, leaving the cursor at the start of its first line.
    func erase() {
        guard isInteractive, !lines.isEmpty else { lines = []; return }
        var escape = "\r\u{1B}[2K"
        for _ in 1..<max(1, lines.count) { escape += "\u{1B}[1A\u{1B}[2K" }
        stdout.write(Data(escape.utf8))
        lines = []
    }

    private func draw(_ rendered: [String]) {
        guard isInteractive, !rendered.isEmpty else { return }
        stdout.write(Data(rendered.joined(separator: "\n").utf8))
        lines = rendered
    }

    func set(_ pending: [String]) {
        guard isInteractive else { return }
        let rendered = LiveView.layout(pending)
        guard rendered != lines else { return } // avoid redrawing unchanged text
        erase()
        draw(rendered)
    }

    /// Print a finished transcript line above the live region.
    func permanent(_ line: String) {
        guard isInteractive else { return }
        let pending = lines
        erase()
        stdout.write(Data((line + "\n").utf8))
        draw(pending)
    }
}

func elapsedString(from start: Date, to end: Date) -> String {
    let total = max(0, Int(end.timeIntervalSince(start)))
    return String(format: "%02d:%02d:%02d", total / 3600, (total / 60) % 60, total % 60)
}

/// Pull "mm:ss" or "h:mm:ss" out of a label like "Elapsed time 21:54" or
/// "My connected time is 34:50". Strict on purpose: every component must be
/// digits, and minutes/seconds must be under 60, so "1::30" fails to parse
/// instead of silently becoming one minute thirty.
func parseMeetingClock(_ raw: String) -> TimeInterval? {
    let token = raw.split(whereSeparator: { !$0.isNumber && $0 != ":" }).first { $0.contains(":") } ?? ""
    var comps: [Int] = []
    for part in token.split(separator: ":", omittingEmptySubsequences: false) {
        guard let value = Int(part) else { return nil }
        comps.append(value)
    }
    guard (2...3).contains(comps.count), comps.dropFirst().allSatisfy({ $0 < 60 }) else { return nil }
    switch comps.count {
    case 2: return TimeInterval(comps[0] * 60 + comps[1])
    default: return TimeInterval(comps[0] * 3600 + comps[1] * 60 + comps[2])
    }
}

/// How `[HH:MM:SS]` stamps are rendered. Chosen once, when the first line is
/// written: the header documents what the stamps mean, so switching the
/// reference halfway through a file would make it contradict itself.
enum TimestampMode {
    /// Counting from a reference point — the app's connection clock when it
    /// displays a call clock, otherwise the moment recording began.
    case elapsed(from: Date)
    /// The time of day, for apps with no call clock: true whenever we joined,
    /// rather than a count from zero implying the meeting began when we did.
    case timeOfDay

    func stamp(_ date: Date) -> String {
        switch self {
        case .elapsed(let start): return elapsedString(from: start, to: date)
        case .timeOfDay: return Recorder.clockText(from: date)
        }
    }

    /// The value recorded in the jsonl metadata's `timestamps` field.
    var metadataValue: String {
        switch self {
        case .elapsed: return "elapsed"
        case .timeOfDay: return "time-of-day"
        }
    }
}

/// One writable transcript file. A protocol so tests can inject failing or
/// scripted sinks: FileHandle raises unrecoverable ObjC exceptions for closed
/// descriptors and never throws in-process, so write-failure paths are only
/// testable behind this seam.
protocol TranscriptSink {
    var path: String { get }
    func append(_ data: Data) throws
}

/// The real thing: a FileHandle opened for writing, positioned at EOF.
struct FileSink: TranscriptSink {
    let path: String
    private let handle: FileHandle

    init(path: String, handle: FileHandle) {
        self.path = path
        self.handle = handle
    }

    /// nil when the file can't be opened for writing (missing directory,
    /// permissions). Callers decide whether that's fatal. Opens at EOF so
    /// appends never clobber existing transcripts.
    init?(url: URL) {
        guard let handle = FileHandle(forWritingAtPath: url.path) else { return nil }
        handle.seekToEndOfFile()
        self.init(path: url.path, handle: handle)
    }

    func append(_ data: Data) throws {
        try handle.write(contentsOf: data)
    }
}

final class Recorder {
    let startedAt: Date
    /// What `[HH:MM:SS]` stamps count from (see TimestampMode).
    let mode: TimestampMode
    let jsonlURL: URL
    let textURL: URL
    private let jsonl: any TranscriptSink
    private let text: any TranscriptSink
    private let stdout = FileHandle.standardOutput
    let options: Options

    /// Opens both transcript files under options.directory. Tests inject
    /// sinks directly via the delegating initializer instead.
    convenience init(options: Options, app: String, meeting: String, startedAt: Date, mode: TimestampMode) {
        let directory = URL(fileURLWithPath: options.directory, isDirectory: true)
        try? FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)

        let stamp = DateFormatter()
        stamp.dateFormat = "yyyyMMdd_HHmmss"
        // The app is in the name because meeting titles don't say where they
        // happened, and the same people meet in different places.
        let base = "\(stamp.string(from: startedAt))-\(app)-\(Recorder.slugify(meeting))"
        let jsonlURL = directory.appendingPathComponent(base + ".jsonl")
        let textURL = directory.appendingPathComponent(base + ".txt")

        for url in [jsonlURL, textURL] where !FileManager.default.fileExists(atPath: url.path) {
            FileManager.default.createFile(atPath: url.path, contents: nil)
        }
        guard let jsonlSink = FileSink(url: jsonlURL),
              let textSink = FileSink(url: textURL) else {
            fail("cannot write to \(directory.path)")
        }
        self.init(options: options, startedAt: startedAt, mode: mode,
                  jsonlURL: jsonlURL, textURL: textURL,
                  jsonl: jsonlSink, text: textSink)
    }

    /// The storage-free initializer: everything above this line is about
    /// naming and opening files, which fault-injection tests must bypass.
    init(options: Options, startedAt: Date, mode: TimestampMode,
         jsonlURL: URL, textURL: URL, jsonl: any TranscriptSink, text: any TranscriptSink) {
        self.options = options
        self.startedAt = startedAt
        self.mode = mode
        self.jsonlURL = jsonlURL
        self.textURL = textURL
        self.jsonl = jsonl
        self.text = text
    }

    static func slugify(_ value: String) -> String {
        let cleaned = value
            .replacingOccurrences(of: "| Microsoft Teams", with: "")
            .lowercased()
            .map { $0.isLetter || $0.isNumber ? $0 : "-" }
        let slug = String(cleaned)
            .split(separator: "-", omittingEmptySubsequences: true)
            .joined(separator: "-")
        return slug.isEmpty ? "meeting" : slug
    }

    static let isoFormatter: DateFormatter = {
        let formatter = DateFormatter()
        formatter.dateFormat = "yyyy-MM-dd'T'HH:mm:ssXXXXX"
        return formatter
    }()

    func elapsed(_ date: Date) -> String { mode.stamp(date) }

    /// The wall-clock stamp used when there is no call clock. Private so the
    /// shared mutable formatter can't be silently reconfigured elsewhere.
    private static let clockFormatter: DateFormatter = {
        let f = DateFormatter()
        f.dateFormat = "HH:mm:ss"
        return f
    }()

    static func clockText(from date: Date) -> String { clockFormatter.string(from: date) }

    /// Serializes and appends one JSONL event. Returns false when the event
    /// could not be produced or written — the caller then holds back the text
    /// half too (see record).
    @discardableResult
    func writeJSON(_ payload: [String: Any]) -> Bool {
        guard let data = try? JSONSerialization.data(withJSONObject: payload, options: [.sortedKeys]),
              var line = String(data: data, encoding: .utf8) else {
            status("could not serialize a \(payload["type"] ?? "json") event; neither file records it")
            return false
        }
        line += "\n"
        do {
            try jsonl.append(Data(line.utf8))
        } catch {
            status("cannot write to \(jsonlURL.path): \(error.localizedDescription); neither file records this event")
            return false
        }
        if options.jsonToStdout && !options.quiet { stdout.write(Data(line.utf8)) }
        return true
    }

    /// Head the transcript with what the bracketed times mean. Without it a
    /// file of relative stamps can't be placed in time at all, and one of
    /// wall-clock stamps doesn't say which day. Best-effort: a failure here
    /// is logged and otherwise ignored — losing the header must never cost
    /// transcript lines.
    func writeHeader(_ lines: [String]) {
        let block = lines.map { "# \($0)\n" }.joined() + "\n"
        do {
            try text.append(Data(block.utf8))
        } catch {
            status("cannot write header to \(textURL.path): \(error.localizedDescription); continuing without it")
        }
    }

    /// Append to both files and report what persisted. A failed jsonl write
    /// holds the transcript line back, so the pair never disagrees about what
    /// happened; a text write that fails after jsonl succeeded cannot be
    /// undone, so the caller gets .jsonOnly(line) to retry text-only.
    func record(kind: String, speaker: String, body: String, at date: Date, extra: [String: Any] = [:]) -> WriteOutcome {
        let stamped = elapsed(date)
        var payload: [String: Any] = [
            "type": kind,
            "speaker": speaker,
            "text": body,
            "ts": Recorder.isoFormatter.string(from: date),
            "elapsed": stamped
        ]
        payload.merge(extra) { current, _ in current }
        guard writeJSON(payload) else { return .failed }
        let tag = kind == "chat" ? "(chat) " : ""
        let line = "[\(stamped)] \(tag)\(speaker): \(body)"
        do {
            try text.append(Data((line + "\n").utf8))
        } catch {
            status("cannot write to \(textURL.path): \(error.localizedDescription); the transcript is missing this line")
            return .jsonOnly(line)
        }
        return .written(line)
    }

    /// Append an already-rendered transcript line (text half only), used when
    /// replaying .jsonOnly outcomes. Throws so callers can surface cause and
    /// path in their own (throttled, aggregate) warnings.
    func appendText(_ line: String) throws {
        try text.append(Data((line + "\n").utf8))
    }
}

/// What persisted when an event was recorded. With the ordered backlog in
/// place, callers commit dedup state for ALL outcomes — a .failed event is
/// queued, not dropped — but the outcome still decides whether the transcript
/// line is drawn now or owed as text debt.
enum WriteOutcome: Equatable {
    /// Both files have it; carries the transcript line for display.
    case written(String)
    /// The jsonl file has it; carries the transcript line for a text-only retry.
    case jsonOnly(String)
    /// Neither file has it.
    case failed
}

/// Outcome of one attempt on one unit of queued output.
enum AttemptResult {
    /// Persisted everywhere it needs to be; drop the unit.
    case done
    /// jsonl persisted; replace the unit with this remaining text debt.
    case needsText(String)
    /// Nothing persisted; keep the unit for retry. Carries the cause for
    /// callers' aggregate warnings.
    case failed(String)
}

// MARK: - Meeting apps

struct CaptionEntry {
    let id: String
    let speaker: String
    let text: String
}

/// Absolute identities for caption segments that reach us as a sliding window
/// with no ids at all (Google Meet's per-speaker blocks, Slack's overlay
/// events). Each poll reports the settled segments currently visible — the
/// tail of the conversation so far — and gets back where they sit overall, so
/// the same words spoken twice land as two utterances and an old segment
/// falling off-screen shifts nothing.
///
/// These apps append, so the visible settled segments are normally the exact
/// tail of the history. If the window ever moves past what history still
/// holds, it re-anchors on the longest overlap so positions keep counting up
/// rather than restarting and rewriting the conversation. Keys are a struct
/// rather than joined strings: a speaker name containing the would-be
/// delimiter must not be able to impersonate a different utterance.
struct SegmentKey: Equatable {
    let speaker: String
    let text: String
}

final class SegmentHistory {
    private var keys: [SegmentKey] = []
    /// Segments already dropped off the front of `keys`.
    private var dropped = 0

    /// Fold the visible settled segments into the history; returns the absolute
    /// position of the first one. The rest number on from there, and the
    /// segment still being spoken takes `returned + settled.count`.
    ///
    /// Known limit: a one-segment window whose content equals the newest
    /// retained segment is indistinguishable from that segment still sitting
    /// on screen, so it reuses its position. The apps using this class keep
    /// several segments visible at once, which disambiguates in practice.
    func absorb(_ settled: [SegmentKey]) -> Int {
        guard !settled.isEmpty else { return dropped + keys.count }
        for overlap in stride(from: min(keys.count, settled.count), through: 1, by: -1)
        where Array(keys.suffix(overlap)) == Array(settled.prefix(overlap)) {
            keys.append(contentsOf: settled.dropFirst(overlap))
            trim()
            return dropped + keys.count - settled.count
        }
        // No overlap with anything remembered: all of these are new.
        keys.append(contentsOf: settled)
        trim()
        return dropped + keys.count - settled.count
    }

    /// A many-hour call produces thousands of segments; keep memory flat.
    /// Retain far more than any real window holds (overlays show ~5, Meet's
    /// blocks a handful): overlap matching compares the visible window against
    /// retained history only, so a window wider than what was retained would
    /// find no overlap and jump the numbering.
    private func trim() {
        guard keys.count > 600 else { return }
        let excess = keys.count - 300
        keys.removeFirst(excess)
        dropped += excess
    }

    /// Forget everything: positions are per meeting, and the apps are singletons.
    func reset() {
        keys = []
        dropped = 0
    }
}

struct ChatMessage {
    let id: String
    let author: String
    let text: String
}

/// What came of asking an app to turn captions on.
enum CaptionRequest {
    /// The control was pressed; captions should appear shortly.
    case pressed
    /// Captions were already running, so there is nothing left to do.
    case alreadyOn
    /// The control wasn't reachable — no attempt was spent, try again later.
    case unreachable
}

protocol MeetingApp {
    /// Short name used for --app and in metadata.
    var id: String { get }
    var displayName: String { get }
    /// pgrep -f pattern matching the process that owns the meeting UI.
    var processPattern: String { get }

    /// Non-nil while a call is up. The element is also a hint for the title.
    func meetingAnchor(_ app: AXUIElement) -> AXUIElement?
    func meetingTitle(_ app: AXUIElement, anchor: AXUIElement?) -> String

    /// The element whose children are caption entries, if captions are showing.
    func captionsContainer(_ app: AXUIElement) -> AXUIElement?
    /// How long this participant has been connected, if the app displays it.
    /// Lets lines be numbered from that reference rather than from when we
    /// attached, which matters when the daemon is restarted mid-meeting. (Not
    /// necessarily how long the MEETING has run — apps report connection time.)
    func meetingElapsed(_ app: AXUIElement) -> TimeInterval?
    func captionEntries(in container: AXUIElement) -> [CaptionEntry]
    /// Whether the captions UI is up, regardless of whether it has any text in
    /// it right now. Used to avoid toggling captions that are already on.
    func captionsPanelOpen(_ app: AXUIElement) -> Bool
    /// Ask the app to show captions.
    func requestCaptions(pid: pid_t) -> CaptionRequest
    /// True when the captions control is a toggle (Teams' ⇧⌘A). A second
    /// press would turn them back off, so we must not retry blindly.
    var captionPressToggles: Bool { get }

    func chatContainer(_ app: AXUIElement) -> AXUIElement?
    func chatMessages(in container: AXUIElement) -> [ChatMessage]
    /// Called when a session starts. Apps are singletons, so any per-meeting
    /// caption bookkeeping (position histories, live-slot tracking) must be
    /// cleared here rather than leaking across meetings.
    func resetCaptureState()

    /// True when finished utterances stay on screen, so waiting for one to
    /// disappear would hold the whole transcript back. Such an app is assumed
    /// to append: anything above the newest entry is done being edited.
    var finalizesWhenSuperseded: Bool { get }
    /// Write an utterance out once its text has been unchanged this long, for
    /// apps that would otherwise leave lines pending indefinitely. The newest
    /// utterance gets twice this long — it may simply be paused mid-speech.
    var idleFinalizeSeconds: TimeInterval? { get }

    /// True when the app displays how long this participant has been
    /// connected, so lines can be numbered from that reference. An app without
    /// one can only count from when we joined, which says nothing useful about
    /// a meeting already in progress - those transcripts get the time of day.
    var reportsMeetingClock: Bool { get }

    /// Whether one specific caption id names one logical utterance: stable
    /// across revisions while it is being spoken, never reused for a different
    /// sentence. (Not "immutable text" — Meet revises its newest segment in
    /// place under the same id.) Stable ids bypass the content-based
    /// deduplication, which exists precisely because some apps re-render
    /// finished lines under fresh ids. Default: none are.
    func hasStableIdentity(_ id: String) -> Bool

    /// True when the caption surface is only present while someone is
    /// speaking. Its absence then says nothing about whether captions are
    /// switched on, so once it has been seen the app must not be asked again.
    var captionsSurfaceIsTransient: Bool { get }

    /// True when the UI is a Chromium/Electron web view. Such apps keep their
    /// accessibility tree switched off until a client asks for it, and must be
    /// woken before anything can be read. Native apps must NOT be poked this
    /// way: AXEnhancedUserInterface triggers window-resize bugs in AppKit.
    var rendersWebContent: Bool { get }

    /// Whether the tree is readable enough to DETECT A MEETING. Deliberately
    /// weaker than "captions can be read": Teams counts via window title while
    /// its WebView is still hollow. Apps whose captions need more than
    /// detection uses should keep waking until both hold.
    func treeIsReadable(_ app: AXUIElement) -> Bool
}

extension MeetingApp {
    // Teams-style: an utterance is done when its element disappears.
    var finalizesWhenSuperseded: Bool { false }
    var idleFinalizeSeconds: TimeInterval? { nil }
    // Most apps leave the caption panel up between utterances.
    var captionsSurfaceIsTransient: Bool { false }
    // Assume the pessimistic case: an app that re-renders finished lines, so
    // no caption id is stable by default (see hasStableIdentity).
    func hasStableIdentity(_ id: String) -> Bool { false }
    // Most apps don't say how long the call has been going.
    func meetingElapsed(_ app: AXUIElement) -> TimeInterval? { nil }
    var reportsMeetingClock: Bool { false }
    var captionPressToggles: Bool { false }
    // Assume native AppKit; only opt in to the wake where it is needed.
    var rendersWebContent: Bool { false }
    func treeIsReadable(_ app: AXUIElement) -> Bool {
        rendersWebContent ? webTreeAwake(app) : !axChildren(app).isEmpty
    }
    // Chat is optional; most apps don't expose it to us yet.
    func chatContainer(_ app: AXUIElement) -> AXUIElement? { nil }
    func chatMessages(in container: AXUIElement) -> [ChatMessage] { [] }
    func resetCaptureState() {}
}

func windowTitle(containing element: AXUIElement) -> String? {
    var node: AXUIElement? = element
    while let current = node {
        if axString(current, kAXRoleAttribute) == "AXWindow" {
            let title = axString(current, kAXTitleAttribute)
            return title.isEmpty ? nil : title
        }
        node = axParent(current)
    }
    return nil
}

func firstWindowTitle(_ app: AXUIElement) -> String {
    let windows = axAttribute(app, kAXWindowsAttribute) as? [AXUIElement] ?? []
    return windows.map { axString($0, kAXTitleAttribute) }.first { !$0.isEmpty } ?? ""
}

func queryProcess(matching pattern: String) -> ProcessQuery {
    let process = Process()
    process.executableURL = URL(fileURLWithPath: "/usr/bin/pgrep")
    process.arguments = ["-f", pattern]
    let pipe = Pipe()
    process.standardOutput = pipe
    do {
        try process.run()
    } catch {
        return .failed("cannot run pgrep: \(error.localizedDescription)")
    }
    process.waitUntilExit()
    switch process.terminationStatus {
    case 0: break
    case 1: return .notRunning
    default: return .failed("pgrep exited \(process.terminationStatus)")
    }
    // Exit 0 with unusable output is pgrep misbehaving, not proof the app is
    // gone — treating it as notRunning would end an active meeting.
    guard let output = String(data: pipe.fileHandleForReading.readDataToEndOfFile(), encoding: .utf8),
          let pid = output.split(separator: "\n").first.flatMap({ pid_t($0) }) else {
        return .failed("pgrep produced no usable pid")
    }
    return .running(pid)
}

enum ProcessQuery {
    case running(pid_t)
    /// pgrep confirmed no matching process (exit 1) — and only that.
    case notRunning
    /// The lookup itself failed (launch error, nonzero exit, unusable output);
    /// this says nothing about whether the app is running. Carries the reason.
    case failed(String)
}

var lastProcessLookupNote = ""
var lastProcessLookupAt = Date.distantPast

/// Process lookups failing is worth knowing even under --quiet, but not once
/// per poll.
func noteProcessLookupFailure(_ message: String) {
    let now = Date()
    guard !(message == lastProcessLookupNote && now.timeIntervalSince(lastProcessLookupAt) < 60) else { return }
    lastProcessLookupNote = message
    lastProcessLookupAt = now
    status(message)
}

/// True once a Chromium/WebKit tree is serving real content (DOM ids), as
/// opposed to the hollow shell it starts with.
func webTreeAwake(_ app: AXUIElement) -> Bool {
    findElement(from: app, where: { !axDomID($0).isEmpty }) != nil
}

/// Web renderers keep their accessibility tree switched off until a client asks for
/// it, so a fresh launch is a hollow window: ~229 nodes, no DOM ids, no
/// captions. Two attributes turn it on, and which one applies depends on how
/// the app is built:
///
///   AXManualAccessibility   Electron's documented opt-in (Slack, VS Code).
///   AXEnhancedUserInterface Chromium's own switch, which is what Teams 2
///                           needs — it is Edge WebView2, not Electron
///                           (see the EdgeBrowserFrameViewMac DOM class).
///
/// Both report failure on Teams (attributeUnsupported / notImplemented) yet
/// the tree still populates within a second, because the renderer (Chromium or
/// WebKit) activates on the attempt rather than on a successful set. So ignore
/// the return codes and check whether DOM ids showed up instead.
func pokeWebTree(_ app: AXUIElement) {
    AXUIElementSetAttributeValue(app, "AXEnhancedUserInterface" as CFString, kCFBooleanTrue)
    AXUIElementSetAttributeValue(app, "AXManualAccessibility" as CFString, kCFBooleanTrue)
}

/// A conferencing app we are currently watching.
struct Attachment {
    let meetingApp: MeetingApp
    let pid: pid_t
    let element: AXUIElement
}

/// Unified per-pid wake bookkeeping: poke cooldowns, attempt counts, and
/// which pids' trees have filled in. One type serves both the detection loop
/// (TreeWaker) and an attached session's wake path.
struct WakeLedger {
    var attempts: [pid_t: Int] = [:]
    var nextAttempt: [pid_t: Date] = [:]
    private(set) var populated: Set<pid_t> = []

    /// Pure rate-limiter decision: should this pid be poked right now, and at
    /// what attempt count? Separate so tests can drive cooldown and attempt
    /// behavior with synthetic dates — no AX element involved. Clearing state
    /// only on genuine wake (not mere title-readability) keeps Teams'
    /// deadline from resetting every scan into a poke storm.
    mutating func pokeDecision(pid: pid_t, awake: Bool, now: Date) -> (poke: Bool, attempt: Int) {
        if awake {
            nextAttempt.removeValue(forKey: pid)
            attempts.removeValue(forKey: pid)
            return (false, 0)
        }
        guard now >= (nextAttempt[pid] ?? .distantPast) else {
            return (false, attempts[pid] ?? 0)
        }
        nextAttempt[pid] = now.addingTimeInterval(5)
        let attempt = (attempts[pid] ?? 0) + 1
        attempts[pid] = attempt
        return (true, attempt)
    }

    mutating func markPopulated(pid: pid_t) { populated.insert(pid) }
    func isPopulated(pid: pid_t) -> Bool { populated.contains(pid) }

    /// Drop bookkeeping for pids no longer running, so restarts start fresh
    /// instead of inheriting a stale cooldown/count. Callers MUST include any
    /// attached session's pid in `alive` unconditionally: pgrep can miss it
    /// transiently, and pruning its entry mid-hollow-period would reset the
    /// attempt-count math the "hollow for Ns" warnings depend on.
    mutating func prune(alive: Set<pid_t>) {
        attempts = attempts.filter { alive.contains($0.key) }
        nextAttempt = nextAttempt.filter { alive.contains($0.key) }
        populated = populated.intersection(alive)
    }
}

/// Wakes the accessibility trees of web-view apps and tracks readability.
/// Detection runs through here because the wake has to precede the anchor
/// search: a freshly launched Teams, Slack, or Meet exposes a hollow tree, and
/// the controls that say a call is happening only appear once it fills in.
struct TreeWaker {
    let quiet: Bool
    var ledger = WakeLedger()

    init(quiet: Bool) { self.quiet = quiet }

    /// True when the app's tree can be searched for a meeting. Web-content
    /// apps are poked (rate-limited) whenever their WebView still lacks DOM
    /// ids — even when the app already counts as readable another way, since
    /// captions need the full tree. Native apps are never poked.
    mutating func ensureReadable(_ attachment: Attachment, now: Date) -> Bool {
        let app = attachment.element
        // Native apps never need waking; answer without recursive DOM scanning
        // (a DOM-id probe is a full tree traversal, too costly per poll).
        guard attachment.meetingApp.rendersWebContent else {
            return attachment.meetingApp.treeIsReadable(app)
        }
        let awake = webTreeAwake(app)
        let (poke, attempt) = pokeDecision(pid: attachment.pid, awake: awake, now: now)
        if poke {
            pokeWebTree(app)
            if !quiet, attempt <= 3 {
                status("asked \(attachment.meetingApp.displayName) to expose its accessibility tree (attempt \(attempt))")
            } else if attempt == 4 || attempt % 12 == 0, !quiet {
                status("\(attachment.meetingApp.displayName)'s accessibility tree has stayed hollow for \(attempt * 5)s; captions cannot be read. Check Accessibility permission for meeting-capture-daemon, or restart \(attachment.meetingApp.displayName)")
            }
        }
        return attachment.meetingApp.treeIsReadable(app)
    }

    /// Pure rate-limiter behind ensureReadable: should this pid be poked right
    /// now, and at what attempt count? Separate so tests can drive cooldown
    /// and attempt behavior with synthetic dates — no AX element involved.
    mutating func pokeDecision(pid: pid_t, awake: Bool, now: Date) -> (poke: Bool, attempt: Int) {
        ledger.pokeDecision(pid: pid, awake: awake, now: now)
    }

    mutating func prune(alive: Set<pid_t>) { ledger.prune(alive: alive) }
}

// MARK: - Microsoft Teams

/// Teams renders its UI in a Chromium WebView, which exposes DOM ids and class
/// lists through the accessibility tree, so we can anchor on those.
struct TeamsApp: MeetingApp {
    let id = "teams"
    let displayName = "Microsoft Teams"
    let processPattern = "Microsoft Teams.app/Contents/MacOS/MSTeams"
    let captionPressToggles = true
    // Teams 2 is Edge WebView2, so its tree starts switched off.
    let rendersWebContent = true
    // Teams keeps ~3 lines on screen; without this, --follow sees nothing
    // until they scroll away.
    var idleFinalizeSeconds: TimeInterval? { 6 }

    /// Caption entries are groups of [speaker, text] carrying this class.
    private let captionEntryClass = "fui-ChatMessageCompact__body"
    /// Chrome that exists whenever the captions panel is up, even while idle.
    private let captionPanelIDs: Set<String> = [
        "captions-panel-dismiss-button",
        "closed-captions-pop-out-button",
        "captions-settings-menu-trigger-button-non-overflow"
    ]

    /// Meeting-only chrome. hangup-button is the obvious one, but Teams'
    /// WebView can take minutes to expose the full toolbar; the call timer
    /// often appears first and is just as reliable.
    private let meetingAnchorIDs: Set<String> = ["hangup-button", "call-duration-custom"]

    func meetingAnchor(_ app: AXUIElement) -> AXUIElement? {
        if let chrome = findElement(from: app, where: { meetingAnchorIDs.contains(axDomID($0)) }) {
            return chrome
        }
        // Teams often takes minutes to put the WebView in the accessibility
        // tree (229 native nodes, zero DOM ids). The window title still says
        // "Meeting with …" for a 1:1 call, which is enough to start and to
        // press the captions shortcut.
        return meetingWindow(app)
    }

    /// 1:1 calls are titled "Meeting with Name (Org) | Microsoft Teams".
    /// Chat windows use the person's name without that prefix, so this stays
    /// off when you are just messaging.
    private func meetingWindow(_ app: AXUIElement) -> AXUIElement? {
        let windows = axAttribute(app, kAXWindowsAttribute) as? [AXUIElement] ?? []
        return windows.first { window in
            let title = axString(window, kAXTitleAttribute)
                .replacingOccurrences(of: "| Microsoft Teams", with: "")
                .trimmingCharacters(in: .whitespaces)
            return title.hasPrefix("Meeting with ")
        }
    }

    /// Readable once DOM ids show up — OR once a meeting window is titleable:
    /// the WebView can stay hollow for minutes while the native window already
    /// says "Meeting with …", which meetingAnchor works from. Detection must
    /// not wait for the WebView; only caption reading does (see wakeTreeIfNeeded).
    func treeIsReadable(_ app: AXUIElement) -> Bool {
        webTreeAwake(app) || meetingWindow(app) != nil
    }

    let reportsMeetingClock = true

    /// Teams paints the ticking clock as a child AXStaticText ("31:01").
    /// The group's title ("Elapsed time 21:54") is frozen at first render.
    func meetingElapsed(_ app: AXUIElement) -> TimeInterval? {
        guard let clock = findElement(from: app, where: { axDomID($0) == "call-duration-custom" }) else {
            return nil
        }
        if let elapsed = Self.parseClock(axStaticTexts(clock).joined(separator: " ")) { return elapsed }
        return Self.parseClock(axString(clock, kAXTitleAttribute))
    }

    private static func parseClock(_ raw: String) -> TimeInterval? { parseMeetingClock(raw) }

    func meetingTitle(_ app: AXUIElement, anchor: AXUIElement?) -> String {
        var title = ""
        if let anchor, let windowTitle = windowTitle(containing: anchor) { title = windowTitle }
        if title.isEmpty { title = firstWindowTitle(app) }
        title = title
            .replacingOccurrences(of: "| Microsoft Teams", with: "")
            .trimmingCharacters(in: .whitespaces)
        return title.isEmpty ? "Teams meeting" : title
    }

    private func isCaptionEntry(_ element: AXUIElement) -> Bool {
        axClasses(element).contains(captionEntryClass)
    }

    /// The captions list is simply the parent of the caption entries. Anchoring
    /// on the entries themselves survives the panel being popped out.
    func captionsContainer(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app, where: isCaptionEntry).flatMap(axParent)
    }

    func captionEntries(in container: AXUIElement) -> [CaptionEntry] {
        axChildren(container).compactMap { entry in
            guard isCaptionEntry(entry) else { return nil }
            let texts = axStaticTexts(entry)
            guard texts.count >= 2 else { return nil }
            let id = axNodeID(entry)
            guard !id.isEmpty else { return nil }
            return CaptionEntry(id: id, speaker: texts[0], text: texts.dropFirst().joined(separator: " "))
        }
    }

    func captionsPanelOpen(_ app: AXUIElement) -> Bool {
        findElement(from: app) { captionPanelIDs.contains(axDomID($0)) } != nil
    }

    /// Teams' own shortcut (⇧⌘A), delivered straight to the process so it
    /// bypasses global event taps such as a Hammerspoon remap.
    func requestCaptions(pid: pid_t) -> CaptionRequest {
        let source = CGEventSource(stateID: .privateState)
        let keyA: CGKeyCode = 0
        guard let down = CGEvent(keyboardEventSource: source, virtualKey: keyA, keyDown: true),
              let up = CGEvent(keyboardEventSource: source, virtualKey: keyA, keyDown: false) else {
            return .unreachable
        }
        down.flags = [.maskCommand, .maskShift]
        up.flags = [.maskCommand, .maskShift]
        down.postToPid(pid)
        up.postToPid(pid)
        return .pressed
    }

    /// The chat message list: the grandparent of any rendered message body.
    func chatContainer(_ app: AXUIElement) -> AXUIElement? {
        guard let body = findElement(from: app, where: {
            axDomID($0).hasPrefix("message-body-") && axClasses($0).contains("fui-ChatMessage__body")
        }) else { return nil }
        return axParent(body).flatMap(axParent)
    }

    func chatMessages(in container: AXUIElement) -> [ChatMessage] {
        let rows = axChildren(container).suffix(20)
        return rows.compactMap { row -> ChatMessage? in
            let parts = axChildren(row)
            guard let body = parts.first(where: {
                axClasses($0).contains("fui-ChatMessage__body") && axDomID($0).hasPrefix("message-body-")
            }) else { return nil }
            let author = parts.first { axClasses($0).contains("fui-ChatMessage__author") }.map { axText($0) } ?? ""
            let text = axText(body).trimmingCharacters(in: .whitespacesAndNewlines)
            guard !text.isEmpty else { return nil }
            let id = String(axDomID(body).dropFirst("message-body-".count))
            return ChatMessage(id: id, author: author.isEmpty ? "Unknown" : author, text: text)
        }
    }
}

// MARK: - Slack

// Slack is Electron: its tree starts switched off until woken, and its
// controls then carry DOM ids ("captions" tab) or AXIdentifier-style labels;
// its caption overlay is found by class list. All serve as anchors.
final class SlackApp: MeetingApp {
    let id = "slack"
    let displayName = "Slack"
    let processPattern = "Slack.app/Contents/MacOS/Slack"
    // Slack is Electron, so its tree starts switched off.
    let rendersWebContent = true
    // Overlay events vanish when they are done, so absence means finished.
    // They also grow while being spoken, and Slack replaces the element each
    // time it does, so give an utterance time to settle before writing it:
    // finalizing early emits the partial, then the full line lands as a
    // second copy.
    var idleFinalizeSeconds: TimeInterval? { 8 }

    // The overlay is drawn over the video tiles only while there is something
    // to show, so it goes away during any pause. Absence means silence, not
    // that captions were switched off.
    var captionsSurfaceIsTransient: Bool { true }

    private let leaveDescription = "Leave Huddle"
    private let overlayClass = "p-huddle_closed_captions"
    private let overlayEventClass = "p-huddle_closed_caption_event__wrapper"
    private let settledMarker = "fade_out"

    /// Which utterance the live slot is holding, and what it last said. Slack
    /// swaps the element on every revision, so identity has to be tracked here
    /// rather than read off the tree.
    private var liveSequence = 0
    private var previousLiveText = ""
    /// Settled events carry no id at all, so they are identified by position in
    /// the huddle's whole conversation (see SegmentHistory) — hashing the text
    /// would collapse a repeated phrase into one utterance.
    private var history = SegmentHistory()

    /// A huddle gets its own window, and the Leave button only exists while
    /// one is up.
    func meetingAnchor(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) {
            axString($0, kAXRoleAttribute) == kAXButtonRole
                && axDescription($0) == leaveDescription
        }
    }

    /// The window is titled "Huddle: #channel - Workspace - Slack \u{1F3A4}". Keep the
    /// channel, drop the decoration.
    func meetingTitle(_ app: AXUIElement, anchor: AXUIElement?) -> String {
        guard let window = huddleWindow(app) else { return "Slack huddle" }
        var title = axString(window, kAXTitleAttribute)
        if let range = title.range(of: "Huddle: ") { title = String(title[range.upperBound...]) }
        // Trailing " - Workspace - Slack \u{1F3A4}" is chrome, not part of the name.
        if let dash = title.range(of: " - ", options: .backwards) { title = String(title[..<dash.lowerBound]) }
        title = title.trimmingCharacters(in: .whitespaces)
        return title.isEmpty ? "Slack huddle" : title
    }

    private func huddleWindow(_ app: AXUIElement) -> AXUIElement? {
        let windows = axAttribute(app, kAXWindowsAttribute) as? [AXUIElement] ?? []
        return windows.first { axString($0, kAXTitleAttribute).hasPrefix("Huddle:") }
    }

    private func captionsTab(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) {
            axDomID($0) == "captions" && axString($0, kAXRoleAttribute) == "AXRadioButton"
        }
    }

    /// Captions surface both in the side flexpane's captions tab and as an
    /// overlay on the video tiles, and we deliberately read only the overlay.
    ///
    /// The flexpane shows one tab at a time, so reading it would stop
    /// capturing the moment someone opened Threads. The overlay is there
    /// whichever tab is up, which is the whole point.
    ///
    /// Reading both is worse than reading either. Neither source has a stable
    /// identity \u2014 panel rows are a virtual list keyed by index, and Slack
    /// reuses an index when it merges consecutive utterances by one speaker,
    /// while overlay events are keyed by element hash and Slack replaces the
    /// element whenever the text grows. Two sources of unstable ids meant the
    /// same sentence was written once from each.
    func captionsContainer(_ app: AXUIElement) -> AXUIElement? {
        guard let window = huddleWindow(app) else { return nil }
        return findElement(from: window) { axClasses($0).contains(overlayClass) }
    }

    /// Slack shows no call clock in the huddle window.
    func meetingElapsed(_ app: AXUIElement) -> TimeInterval? { nil }

    /// Overlay events read [speaker, ":", text], the colon being its own node.
    ///
    /// They carry no id, and the element hash is useless as identity because
    /// Slack replaces the element every time the text changes \u2014 which it does
    /// constantly while speech is being recognised, revising words rather than
    /// only appending ("Kinda hard to fill" becomes "Kind of hard to fill
    /// her"). Keying on the hash wrote one line per revision, and prefix
    /// matching could not collapse them because a revision is not a prefix.
    ///
    /// The list is ordered oldest to newest and holds about five events, and
    /// Slack marks every settled one `fade_out`. So at most one event \u2014 the
    /// last \u2014 is still being spoken, and it is the only one that can change.
    /// Settled events therefore take positional ids (see SegmentHistory), and
    /// the live one keeps a single synthetic id across all its revisions so it
    /// lands as one utterance.
    func captionEntries(in container: AXUIElement) -> [CaptionEntry] {
        var settled: [(speaker: String, text: String)] = []
        var live: (speaker: String, text: String)?

        for item in axChildren(container) {
            let classes = axClasses(item)
            guard classes.contains(overlayEventClass) else { continue }
            let texts = axStaticTexts(item)
            guard texts.count >= 3 else { continue }
            let spoken = texts.dropFirst(2).joined(separator: " ")
                .trimmingCharacters(in: .whitespaces)
            guard !spoken.isEmpty else { continue }
            if classes.contains(where: { $0.contains(settledMarker) }) {
                settled.append((texts[0], spoken))
            } else {
                live = (texts[0], spoken)
            }
        }

        // Once the sentence the live slot was holding shows up settled, the
        // slot has moved on to a new utterance and must not keep the old id.
        // Checked against every settled event, including ones filtered out of
        // the result below.
        if !previousLiveText.isEmpty, settled.contains(where: { $0.text == previousLiveText }) {
            liveSequence += 1
            previousLiveText = ""
        }

        // Every settled event is reported, including one whose text also sits
        // in the live slot. Suppressing those looked like the way to avoid
        // writing a sentence twice, but the live slot is not a safe place to
        // have left it: if Slack settles an utterance with any edit at all,
        // the turnover above is missed, the live id is reused for the next
        // sentence, and the previous one is overwritten before it was ever
        // written out. Reporting both and letting the recorder collapse them
        // loses nothing when that happens.
        let base = history.absorb(settled.map { SegmentKey(speaker: $0.speaker, text: $0.text) })
        var entries = settled.enumerated().map {
            CaptionEntry(id: "seg:\(base + $0.offset)", speaker: $0.element.speaker, text: $0.element.text)
        }
        if let live {
            previousLiveText = live.text
            // Last, so the recorder treats it as the line still being spoken
            // and leaves it out of idle finalization.
            entries.append(CaptionEntry(id: "live:\(liveSequence)", speaker: live.speaker, text: live.text))
        }
        return entries
    }

    func resetCaptureState() {
        liveSequence = 0
        previousLiveText = ""
        history.reset()
    }

    // Settled events carry positional seg: ids that name one specific utterance
    // for life, so they must bypass the content dedup that guards against
    // re-rendering — otherwise saying the same short thing twice in thirty
    // seconds loses the second one. Only the synthetic live: id, which is
    // reused across revisions, needs that protection.
    func hasStableIdentity(_ id: String) -> Bool { id.hasPrefix("seg:") }

    func captionsPanelOpen(_ app: AXUIElement) -> Bool {
        captionsContainer(app) != nil
    }

    /// The control is a tab, not a toggle: selecting it starts captions and
    /// selecting it again is a no-op. But switching tabs is the user's
    /// business, so only reach for it when captions are nowhere to be found.
    /// If the overlay is up, captions are already running and whatever tab
    /// they are reading is left alone.
    func requestCaptions(pid: pid_t) -> CaptionRequest {
        let app = AXUIElementCreateApplication(pid)
        AXUIElementSetMessagingTimeout(app, 5.0)
        if captionsContainer(app) != nil { return .alreadyOn }
        guard let tab = captionsTab(app) else { return .unreachable }
        guard AXUIElementPerformAction(tab, kAXPressAction as CFString) == .success
        else { return .unreachable }
        return .pressed
    }
}

// MARK: - Zoom

/// Zoom is a native app, so there are no DOM ids, but it labels its controls
/// with AXIdentifier (`leave`, `captions`, `chat`) and its caption list with a
/// description, which serve the same purpose.
struct ZoomApp: MeetingApp {
    let id = "zoom"
    let displayName = "Zoom"
    let processPattern = "zoom.us.app/Contents/MacOS/zoom.us"

    private let captionTableDescription = "Closed caption subtitles"

    /// The End/Leave button exists only during a call.
    func meetingAnchor(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) { axIdentifier($0) == "leave" }
    }

    /// Every Zoom window is called "Zoom Meeting", so use the topic button in
    /// the title bar, which reads e.g. "Ada's Personal Meeting Room".
    func meetingTitle(_ app: AXUIElement, anchor: AXUIElement?) -> String {
        if let info = findElement(from: app, where: { axIdentifier($0) == "MeetingTopBarInfoButton" }) {
            let topic = axDescription(info).trimmingCharacters(in: .whitespaces)
            if !topic.isEmpty { return topic }
        }
        return "Zoom meeting"
    }

    func captionsContainer(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) { axDescription($0) == captionTableDescription }
    }

    /// Zoom keeps a clock in the title bar, described as "My connected time is
    /// 34:50" (or "1:34:50"). See meetingElapsed for what it does and doesn't
    /// measure; this flag tells the recorder lines may count from it.
    let reportsMeetingClock = true

    /// Returns seconds of participant-connection time shown in Zoom's title
    /// bar, or nil when the toolbar (and its clock) is hidden.
    func meetingElapsed(_ app: AXUIElement) -> TimeInterval? {
        guard let clock = findElement(from: app, where: {
            axDescription($0).hasPrefix("My connected time is")
        }) else { return nil }
        return parseMeetingClock(axDescription(clock))
    }

    /// Rows are AXRow > AXCell > [speaker, text]. Zoom hands out no ids, but
    /// the row elements themselves stay put, so their hash identifies them.
    func captionEntries(in container: AXUIElement) -> [CaptionEntry] {
        axChildren(container).compactMap { row in
            let texts = axStaticTexts(row)
            guard texts.count >= 2 else { return nil }
            return CaptionEntry(
                id: String(CFHash(row)),
                speaker: texts[0],
                text: texts.dropFirst().joined(separator: " ")
            )
        }
    }

    private func captionsButton(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) { axIdentifier($0) == "captions" }
    }

    private func overflowButton(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) { axIdentifier($0) == "more" }
    }

    /// In the overflow the control is an unidentified button described as e.g.
    /// "Show captions, 7 of 13, not pinned".
    private func overflowCaptionsItem(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) {
            axString($0, kAXRoleAttribute) == kAXButtonRole
                && axDescription($0).localizedCaseInsensitiveContains("captions")
                && axIdentifier($0) != "captions"
        }
    }

    @discardableResult
    private func press(_ element: AXUIElement) -> Bool {
        AXUIElementPerformAction(element, kAXPressAction as CFString) == .success
    }

    /// Zoom's caption list only exists while captions are on, which makes it a
    /// reliable signal — unlike the toolbar button, which vanishes with the
    /// toolbar whenever the pointer leaves the window.
    func captionsPanelOpen(_ app: AXUIElement) -> Bool {
        captionsContainer(app) != nil
    }

    /// No synthetic keystroke needed: the button is pressable, and its
    /// description says which way it will toggle. Two obstacles, though: the
    /// toolbar leaves the tree entirely when the pointer isn't over the window,
    /// and unless pinned, captions live in the More overflow.
    func requestCaptions(pid: pid_t) -> CaptionRequest {
        let app = AXUIElementCreateApplication(pid)
        AXUIElementSetMessagingTimeout(app, 5.0)

        // Zoom only puts captions in the toolbar once they are running, so a
        // pinned button that doesn't offer to show them means they are on.
        if let pinned = captionsButton(app) {
            guard axDescription(pinned).localizedCaseInsensitiveContains("show captions") else {
                return .alreadyOn
            }
            return press(pinned) ? .pressed : .unreachable
        }

        guard let more = overflowButton(app), press(more) else { return .unreachable }
        // The overflow is populated a moment after it opens.
        var item: AXUIElement?
        for _ in 0..<10 {
            usleep(100_000)
            if let found = overflowCaptionsItem(app) { item = found; break }
        }
        guard let item else {
            press(more) // put the overflow back the way we found it
            return .unreachable
        }
        guard axDescription(item).localizedCaseInsensitiveContains("show captions") else {
            press(more)
            return .alreadyOn
        }
        return press(item) ? .pressed : .unreachable // pressing an item closes the overflow
    }

    // Chat is skipped via the MeetingApp defaults: Zoom's chat panel is a
    // separate surface that has to be open to read; not wired up yet.

    // Rows accumulate rather than being cleared, so finalize on being pushed
    // up by a newer row, and give the newest row a few seconds to settle.
    var finalizesWhenSuperseded: Bool { true }
    var idleFinalizeSeconds: TimeInterval? { 6 }
}

// MARK: - Google Meet

/// Google Meet installed as a Safari web app (Add to Dock), which is what
/// `Web App` runs when handed the bundle on its command line. A Meet tab in an
/// ordinary browser window is NOT supported: the browser would be the process,
/// its other tabs would sit in the same tree, and finding the call would mean
/// searching all of them.
///
/// Alpha. All of this was worked out in a call with one participant, so the
/// single-speaker path is exercised and the rest is reasoned from it.
final class MeetApp: MeetingApp {
    let id = "meet"
    let displayName = "Google Meet"
    // Matches the --bundlepath argument. The bundle identifier carries a UUID
    // generated when the web app was installed, so it is useless here.
    let processPattern = "Web App .*Google Meet.app"
    // WebKit also serves an empty tree until something asks for it: before the
    // poke this app is 17 nodes with no AXWebArea at all.
    let rendersWebContent = true
    // The button says which way it goes, so pressing is never a guess.
    let captionPressToggles = false
    // Meet displays no call duration, so lines get the time of day.
    let reportsMeetingClock = false
    // Segments stay put once a newer one lands, so finalize on being
    // superseded rather than waiting for text to disappear.
    var finalizesWhenSuperseded: Bool { true }
    var idleFinalizeSeconds: TimeInterval? { 6 }
    // A segment holds its position for life, so the same sentence twice is two
    // utterances rather than one line re-rendered — every Meet id is stable.
    func hasStableIdentity(_ id: String) -> Bool { true }

    /// Meet labels everything by ARIA, and its class names are obfuscated
    /// build output (`vNKgIf.UDinHf`) that changes without warning. Nothing
    /// here keys off them.
    private let leaveDescription = "Leave call"
    private let captionsDescription = "Captions"
    private let captionsOnLabel = "Turn off captions"
    private let captionsOffLabel = "Turn on captions"

    /// Every caption segment reported so far, tracked by position in the whole
    /// conversation (see SegmentHistory). Meet exposes no DOM ids, and the text
    /// repeats often enough that hashing it would merge separate utterances —
    /// a single "Yeah." said twice was in the first capture.
    private var history = SegmentHistory()

    func meetingAnchor(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) { axDescription($0) == leaveDescription }
    }

    func meetingTitle(_ app: AXUIElement, anchor: AXUIElement?) -> String {
        let windows = axAttribute(app, kAXWindowsAttribute) as? [AXUIElement] ?? []
        var title = windows.map { axString($0, kAXTitleAttribute) }.first { !$0.isEmpty } ?? ""
        // "Meet - abc-defg-hij" for an unnamed call; a scheduled one is named.
        if title.hasPrefix("Meet - ") { title = String(title.dropFirst("Meet - ".count)) }
        title = title.trimmingCharacters(in: .whitespaces)
        return title.isEmpty ? "Google Meet" : title
    }

    func captionsContainer(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) {
            axDescription($0) == captionsDescription && axString($0, kAXRoleAttribute) == "AXGroup"
        }
    }

    func captionsPanelOpen(_ app: AXUIElement) -> Bool {
        // The button label is the authority: the caption group keeps its last
        // text long after anyone stopped speaking, so its presence says only
        // that captions were on at some point.
        captionsButton(app).map { axDescription($0) == captionsOnLabel } ?? false
    }

    func requestCaptions(pid: pid_t) -> CaptionRequest {
        let app = AXUIElementCreateApplication(pid)
        AXUIElementSetMessagingTimeout(app, 5.0)
        guard let button = captionsButton(app) else { return .unreachable }
        guard axDescription(button) == captionsOffLabel else { return .alreadyOn }
        return AXUIElementPerformAction(button, kAXPressAction as CFString) == .success
            ? .pressed : .unreachable
    }

    private func captionsButton(_ app: AXUIElement) -> AXUIElement? {
        findElement(from: app) {
            let label = axDescription($0)
            return label == captionsOnLabel || label == captionsOffLabel
        }
    }

    /// Captions are one block per speaker - a name, then a group of text
    /// segments - laid out as alternating children. Segments are appended as
    /// sentences finish; only the last one is still being revised.
    func captionEntries(in container: AXUIElement) -> [CaptionEntry] {
        var visible: [(speaker: String, text: String)] = []
        let blocks = axChildren(container)
        var index = 0
        while index + 1 < blocks.count {
            let speaker = axStaticTexts(blocks[index]).first ?? ""
            for text in axStaticTexts(blocks[index + 1]) where !text.isEmpty {
                visible.append((speaker, text))
            }
            index += 2
        }
        guard !visible.isEmpty else { return [] }

        // All but the last are settled. Fold them into the history, which is
        // what absolute positions are counted against.
        let base = history.absorb(visible.dropLast().map { SegmentKey(speaker: $0.speaker, text: $0.text) })
        return visible.enumerated().map { offset, entry in
            CaptionEntry(id: "seg:\(base + offset)", speaker: entry.speaker, text: entry.text)
        }
    }

    func resetCaptureState() { history.reset() }

    func meetingElapsed(_ app: AXUIElement) -> TimeInterval? { nil }
    // Meet's chat is a side panel that has to be open to exist; not wired up.
    func chatContainer(_ app: AXUIElement) -> AXUIElement? { nil }
    func chatMessages(in container: AXUIElement) -> [ChatMessage] { [] }
}

let supportedApps: [MeetingApp] = [TeamsApp(), ZoomApp(), SlackApp(), MeetApp()]


// MARK: - Session

/// One meeting: holds the caption/chat state and creates files lazily, so a
/// meeting that never produces a line leaves nothing behind.
/// Injectable time. Tests drive deadlines, backoff, and the finish drain
/// loop deterministically; production always gets wall-clock.
protocol TimeSource {
    func now() -> Date
}

struct WallClock: TimeSource {
    func now() -> Date { Date() }
}

final class Session {
    let options: Options
    let live: LiveView
    let meetingApp: MeetingApp
    /// Sleep primitive for the finish drain loop's inter-attempt pause —
    /// injectable so tests don't actually sleep while the fake clock advances.
    var sleepFn: (UInt32) -> Void = { usleep($0) }
    let clock: any TimeSource
    let startedAt = Date()
    var title: String
    var recorder: Recorder?
    /// Highest stamp written so far, so the transcript clock never goes back.
    private var lastStamp: Date?
    private var captionsContainer: AXUIElement?
    private var chatContainer: AXUIElement?
    private var lastRelocate = Date.distantPast
    private var activeCaptions: [String: Utterance] = [:]
    private var captionOrder: [String] = []
    // ^ internal so fault tests can count lost items without stderr capture
    private var seenChatIDs = Set<String>()
    private var chatBaselineDone: Bool
    private var captionAttempts = 0
    private var warnedCaptionsUnreachable = false
    /// finish() must be idempotent: it runs both on leave detection and on exit,
    /// and running twice would double-flush and double-report.
    var finished = false
    private var lastPublishWarning = Date.distantPast
    private var lastInitWarning = Date.distantPast
    /// The ordered write backlog: everything that failed to persist, oldest
    /// first. ONE queue holds both whole events (.event) and jsonl-only lines
    /// whose text half is still owed (.text); a single FIFO is what keeps both
    /// transcript files in the same order across write outages. Entries are
    /// drained by drainPendingWrites and count as lost in finish().
    enum PendingWrite {
        case event(kind: String, speaker: String, body: String, at: Date, extra: [String: Any])
        case text(String)
    }
    var pendingWrites: [PendingWrite] = []
    var nextRetry = Date.distantPast
    var retryDelay: TimeInterval = 1
    private var nextCaptionCheck = Date.distantPast
    private var sawCaptions = false
    /// Recently written utterances, to catch an app re-rendering a finished one.
    private var written: [(speaker: String, text: String, at: Date)] = []
    /// Ids already written but still on screen.
    private var finalized = Set<String>()
    var ledger = WakeLedger()
    /// What `[HH:MM:SS]` counts from: the app's clock (connection time) once
    /// it tells us, otherwise the moment we attached.
    private var timelineStart: Date
    private var timelineResolved = false
    private var nextTimelineCheck = Date.distantPast

    init(options: Options, live: LiveView, meetingApp: MeetingApp, title: String,
         clock: any TimeSource = WallClock()) {
        self.options = options
        self.live = live
        self.meetingApp = meetingApp
        self.title = title
        self.clock = clock
        self.timelineStart = clock.now()
        chatBaselineDone = options.includeChatBacklog
        // Apps are singletons; drop any caption bookkeeping a previous meeting left.
        meetingApp.resetCaptureState()
    }

    var wroteAnything: Bool { recorder != nil }
    var files: (jsonl: URL, text: URL)? { recorder.map { ($0.jsonlURL, $0.textURL) } }

    /// Files are created on first write, so a silent meeting leaves no litter.
    /// Returns nil until the METADATA event is written successfully — the one
    /// hard requirement. Header writing and pointer publication are best-effort
    /// follow-ups, not part of the success condition. Callers whose event fails
    /// while this returns nil queue it for replay rather than dropping it.
    private func recorderForWriting() -> Recorder? {
        if let recorder { return recorder }
        // Whatever the timeline looks like now is what the file gets: the header
        // documents it, and changing it later would rewrite history (see resolveTimeline).
        let mode: TimestampMode
        if timelineResolved {
            mode = .elapsed(from: timelineStart)
        } else if meetingApp.reportsMeetingClock {
            mode = .elapsed(from: startedAt)
        } else {
            mode = .timeOfDay
        }
        let created = Recorder(
            options: options, app: meetingApp.id, meeting: title, startedAt: startedAt,
            mode: mode)
        var metadata: [String: Any] = [
            "type": "metadata",
            "source": "\(meetingApp.id)-ax",
            "app": meetingApp.displayName,
            "meeting": title,
            "recorded_at": Recorder.isoFormatter.string(from: startedAt),
            "timestamps": mode.metadataValue
        ]
        if timelineResolved {
            metadata["meeting_started_at"] = Recorder.isoFormatter.string(from: timelineStart)
        }
        // The metadata event must persist before anything else is recorded;
        // writeJSON has already logged the failure. Throttled because this
        // fires once per skipped event while writes are broken.
        guard created.writeJSON(metadata) else {
            if Date().timeIntervalSince(lastInitWarning) > 30 {
                lastInitWarning = Date()
                status("cannot start recording \"\(title)\"; captions will be retried")
            }
            return nil
        }

        var header = ["\(title) (\(meetingApp.displayName))",
                      "recording started \(Recorder.isoFormatter.string(from: startedAt))"]
        if timelineResolved {
            header.append("meeting started   \(Recorder.isoFormatter.string(from: timelineStart))")
            header.append("[hh:mm:ss] counts from the app's connection clock")
        } else if meetingApp.reportsMeetingClock {
            header.append("[hh:mm:ss] counts from when recording started")
        } else {
            header.append("[hh:mm:ss] is the time of day")
        }
        created.writeHeader(header)
        recorder = created
        let pointer = options.stateDirectory + "/current"
        do {
            try created.textURL.path.write(toFile: pointer, atomically: true, encoding: .utf8)
        } catch {
            // Without this pointer --follow has nothing to tail and silently waits forever.
            status("cannot update \(pointer): \(error.localizedDescription)")
        }
        if !options.quiet {
            status("recording \"\(title)\"\n  jsonl: \(created.jsonlURL.path)\n  text:  \(created.textURL.path)")
        }
        return created
    }

    /// Both attributes are set by pokeWebTree; see it for how the wake works.
    private func wakeTreeIfNeeded(app: AXUIElement, pid: pid_t, now: Date) {
        // Native short-circuit: mark populated even though no WebView exists —
        // caption gating below reads the ledger, not rendersWebContent.
        guard meetingApp.rendersWebContent else { ledger.markPopulated(pid: pid); return }
        if webTreeAwake(app) { // DOM ids specifically: Teams reads as "readable" from titles alone
            // Transition announcement only fires if we poked at least once
            // before — detection-side wakes never announce, and this must not
            // become a behavior change inside a refactor.
            if !ledger.isPopulated(pid: pid), ledger.attempts[pid, default: 0] > 0, !options.quiet {
                status("\(meetingApp.displayName) exposed its accessibility tree")
            }
            ledger.markPopulated(pid: pid)
            return
        }
        let (poke, attempt) = ledger.pokeDecision(pid: pid, awake: false, now: now)
        guard poke else { return }
        pokeWebTree(app)
        if !options.quiet, attempt <= 3 {
            status("asked \(meetingApp.displayName) to expose its accessibility tree (attempt \(attempt))")
        } else if !options.quiet, attempt == 4 || attempt % 12 == 0 {
            status("\(meetingApp.displayName)'s accessibility tree has stayed hollow for \(attempt * 5)s; captions cannot be read. Check Accessibility permission for meeting-capture-daemon, or restart \(meetingApp.displayName)")
        }
    }

    /// Ask the app how long its participant has been connected, so lines are
    /// numbered from that clock rather than from when we joined. The clock is
    /// part of the window chrome, which Zoom hides along with its toolbar, so
    /// keep asking until it answers — but only until the first line is written.
    /// Past that the header already declares what the stamps mean, and moving
    /// the reference halfway through would make the file contradict itself; such
    /// a recording simply counts from when recording began.
    private func resolveTimeline(app: AXUIElement, now: Date) {
        guard recorder == nil else { return }
        guard now >= nextTimelineCheck else { return }
        nextTimelineCheck = now.addingTimeInterval(5)
        guard let elapsed = meetingApp.meetingElapsed(app), elapsed > 0 else { return }
        timelineResolved = true
        timelineStart = now.addingTimeInterval(-elapsed)
    }

    /// Records an event and draws it. Returns true when the event persisted
    /// somewhere or was accepted onto the ordered retry queue; false when it
    /// failed outright (callers roll their dedup state back).
    ///
    /// Records an event and draws it, preserving transcript order: while any
    /// earlier output is still queued, new events are queued behind it rather
    /// than written. Queued == committed for dedup purposes — the backlog is
    /// drained by retryPendingWrites and finish(), never dropped silently.
    private func emit(kind: String, speaker: String, body: String, at date: Date, extra: [String: Any]) {
        guard pendingWrites.isEmpty else {
            pendingWrites.append(.event(
                kind: kind, speaker: speaker, body: body, at: date, extra: extra))
            return
        }
        switch attemptEventWrite(kind: kind, speaker: speaker, body: body,
                                 at: date, extra: extra) {
        case .done:
            break
        case .needsText(let line):
            // jsonl persisted; the text half becomes this event's remaining debt.
            pendingWrites.append(.text(line))
        case .failed:
            // Nothing persisted anywhere; queue the whole event for retry.
            pendingWrites.append(.event(
                kind: kind, speaker: speaker, body: body, at: date, extra: extra))
        }
    }
    /// One attempt at writing a whole event through the recorder.
    private func attemptEventWrite(kind: String, speaker: String, body: String,
                                   at date: Date, extra: [String: Any]) -> AttemptResult {
        // Lines are appended as they finish but stamped with when they began,
        // so a long sentence can land after a short one that started later and
        // the clock appears to run backwards. Hold the stamp at the high-water
        // mark; it only moves once the line persisted somewhere.
        let stamp = max(date, lastStamp ?? date)
        var extra = extra
        if stamp != date { extra["started_at"] = Recorder.isoFormatter.string(from: date) }
        guard let writer = recorderForWriting() else {
            return .failed("transcript metadata could not be written; details logged above")
        }
        switch writer.record(kind: kind, speaker: speaker, body: body, at: stamp, extra: extra) {
        case .written(let line):
            lastStamp = stamp
            live.permanent(line)
            return .done
        case .jsonOnly(let line):
            lastStamp = stamp
            live.permanent(line) // display it even though the text file owes it
            return .needsText(line)
        case .failed:
            return .failed("event write failed; details logged above")
        }
    }

    /// Matches how the recorder stamps finished lines, so the live region and
    /// the transcript above it read the same way.
    private func stamp(_ date: Date) -> String {
        meetingApp.reportsMeetingClock
            ? elapsedString(from: timelineStart, to: date)
            : Recorder.clockText(from: date)
    }

    func tick(app: AXUIElement, pid: pid_t, now: Date) {
        guard !finished else { return }
        // Drain the backlog before fresh polls emit anything new, so recovered
        // output always precedes newer lines.
        retryPendingWrites(now: now)
        wakeTreeIfNeeded(app: app, pid: pid, now: now)
        resolveTimeline(app: app, now: now)
        let needsCaptions = options.captureCaptions && captionsContainer == nil
        let needsChat = options.captureChat && chatContainer == nil
        if (needsCaptions || needsChat) && now.timeIntervalSince(lastRelocate) > 3 {
            lastRelocate = now
            if needsCaptions { captionsContainer = meetingApp.captionsContainer(app) }
            if needsChat { chatContainer = meetingApp.chatContainer(app) }
        }

        if options.autoCaptions { ensureCaptionsOn(app: app, pid: pid, now: now) }
        if options.captureCaptions { pollCaptions(now: now) }
        if options.captureChat { pollChat(now: now) }
    }

    /// Retry the ordered backlog on bounded exponential backoff (capped at
    /// 30s) so a persistently broken disk doesn't get hammered every 250ms.
    /// Draining uses attemptEventWrite directly — deliberately NOT emit(),
    /// whose order guard would re-queue everything behind itself.
    /// Drain the backlog, strictly oldest-first, stopping at the first item
    /// whose write fails so nothing overtakes it. A .event that lands as
    /// jsonOnly is REPLACED in place by its text debt rather than dropped, so
    /// later items can never pass it.
    ///
    /// Returns the BLOCKING failure's cause for callers' aggregate warning,
    /// or nil when everything drained — or when the deadline expired first
    /// with items still queued (read pendingWrites.count to tell those apart).
    @discardableResult
    func drainPendingWrites(until deadline: Date?) -> String? {
        while !pendingWrites.isEmpty {
            // Same injected source as finish()'s deadline — a fake clock that
            // advances per now() call is what makes the loop terminate in tests.
            if let deadline, clock.now() >= deadline { break }
            let result: AttemptResult
            switch pendingWrites[0] {
            case .event(let kind, let speaker, let body, let at, let extra):
                result = attemptEventWrite(kind: kind, speaker: speaker,
                                           body: body, at: at, extra: extra)
            case .text(let line):
                guard let writer = recorder else {
                    result = .failed("transcript is not initialized")
                    break
                }
                do {
                    try writer.appendText(line)
                    result = .done
                } catch {
                    result = .failed("\(writer.textURL.path): \(error.localizedDescription)")
                }
            }
            switch result {
            case .done:
                pendingWrites.removeFirst()
            case .needsText(let line):
                pendingWrites[0] = .text(line)
            case .failed(let why):
                return why
            }
        }
        return nil
    }

    /// Retry queued output on a bounded exponential backoff (capped at 30s).
    /// Runs before fresh polls each tick; combined with emit's order guard,
    /// this means recovered output always precedes anything newer.
    func retryPendingWrites(now: Date) {
        guard !finished else { return }
        guard !pendingWrites.isEmpty else { return }
        guard now >= nextRetry else { return }
        if let why = drainPendingWrites(until: nil) {
            retryDelay = min(retryDelay * 2, 30)
            nextRetry = now.addingTimeInterval(retryDelay)
            status("\(pendingWrites.count) item(s) awaiting writable storage; retrying every \(Int(retryDelay))s\n  blocked by: \(why)")
        } else {
            retryDelay = 1
        }
    }

    /// Turn captions on if the panel isn't up. Gives up quickly: toggling a
    /// shortcut we can't verify is worse than missing a transcript.
    private func ensureCaptionsOn(app: AXUIElement, pid: pid_t, now: Date) {
        if meetingApp.captionsPanelOpen(app) {
            sawCaptions = true
            return
        }
        // Panel looks closed. For an app whose captions only appear while
        // someone is speaking, that is just silence - asking again would
        // reopen a panel the user closed, or warn about captions that are
        // running. Otherwise, if we already pressed while the tree was hollow,
        // do not guess again. Once the tree is readable we can see it is
        // really off and it is safe to toggle back on.
        if sawCaptions {
            guard !meetingApp.captionsSurfaceIsTransient else { return }
            guard ledger.isPopulated(pid: pid) else { return }
            sawCaptions = false
            captionAttempts = 0
        }
        guard captionAttempts < 2,
              now.timeIntervalSince(startedAt) > 3,
              now >= nextCaptionCheck else { return }
        nextCaptionCheck = now.addingTimeInterval(8)
        switch meetingApp.requestCaptions(pid: pid) {
        case .alreadyOn:
            sawCaptions = true
            return
        case .unreachable:
            if !warnedCaptionsUnreachable, !options.quiet {
                warnedCaptionsUnreachable = true
                status("\(meetingApp.displayName) is hiding its captions control; will turn captions on when it reappears")
            }
            return
        case .pressed:
            captionAttempts += 1
            if !options.quiet {
                status("asked \(meetingApp.displayName) to show live captions (attempt \(captionAttempts))")
            }
            if meetingApp.captionPressToggles && !ledger.isPopulated(pid: pid) {
                sawCaptions = true
            } else {
                nextCaptionCheck = now.addingTimeInterval(20)
            }
        }
    }

    private func pollCaptions(now: Date) {
        guard let container = captionsContainer else { return }
        let entries = meetingApp.captionEntries(in: container)
        if !entries.isEmpty { sawCaptions = true }
        if entries.isEmpty && axChildren(container).isEmpty {
            captionsContainer = nil // panel closed or re-rendered
        }
        let visible = Set(entries.map(\.id))
        finalized.formIntersection(visible) // let ids be reused once they are gone
        for entry in entries {
            if finalized.contains(entry.id) {
                // Same row kept growing after we idle-finalized it (Zoom).
                let grew = written.contains {
                    $0.speaker == entry.speaker && entry.text.hasPrefix($0.text) && entry.text != $0.text
                }
                if grew { finalized.remove(entry.id) } else { continue }
            }
            if var utterance = activeCaptions[entry.id] {
                if utterance.text != entry.text {
                    utterance.changedAt = now
                    // Same node, new sentence (not a live edit growing the text).
                    if !entry.text.hasPrefix(utterance.text) && !utterance.text.hasPrefix(entry.text) {
                        utterance.startedAt = now
                    }
                }
                utterance.speaker = entry.speaker
                utterance.text = entry.text
                activeCaptions[entry.id] = utterance
            } else {
                activeCaptions[entry.id] = Utterance(
                    speaker: entry.speaker, text: entry.text, startedAt: now, changedAt: now)
                captionOrder.append(entry.id)
            }
        }

        // Finalize what left the screen only after taking in what is on it.
        // An app can retire one element and put the same sentence up under
        // another in a single refresh, and finalizing first meant the
        // replacement was not there yet to be recognised as the same
        // utterance, so it was written twice.
        for id in captionOrder where !visible.contains(id) { finalizeCaption(id, at: now) }

        // Apps that keep finished utterances on screen need another way to tell
        // that one is done.
        if meetingApp.finalizesWhenSuperseded, let newest = entries.last?.id {
            for id in captionOrder where id != newest { finalizeCaption(id, at: now) }
        }
        if let idle = meetingApp.idleFinalizeSeconds {
            let newest = entries.last?.id
            for id in captionOrder {
                // The newest utterance may simply be paused mid-speech, so it
                // waits twice as long before idle finalization calls it done.
                let threshold = id == newest ? idle * 2 : idle
                guard let utterance = activeCaptions[id],
                      now.timeIntervalSince(utterance.changedAt) > threshold else { continue }
                finalizeCaption(id, at: now)
            }
        }
        guard recorder != nil || !captionOrder.isEmpty else { return }
        // Mirror every in-progress utterance; finished lines scroll above.
        let pending = captionOrder.compactMap { id -> String? in
            guard let utterance = activeCaptions[id],
                  !supersededByActive(utterance, id: id) else { return nil }
            return "[\(stamp(utterance.startedAt))] \(utterance.speaker): \(utterance.text)"
        }
        let shown = pending.enumerated().map { $0.offset == pending.count - 1 ? "\($0.element) ▍" : $0.element }
        live.set(shown)
        publishLive(shown)
    }

    /// So `--follow` can show in-progress speech. The daemon is not a tty, so
    /// LiveView's in-place region never appears in launchd.log.
    private func publishLive(_ pending: [String]) {
        let url = URL(fileURLWithPath: options.stateDirectory + "/live")
        do {
            try pending.joined(separator: "\n").write(to: url, atomically: true, encoding: .utf8)
        } catch {
            // This runs every poll while broken; say something occasionally,
            // not once per caption.
            guard Date().timeIntervalSince(lastPublishWarning) > 30 else { return }
            lastPublishWarning = Date()
            status("cannot update \(url.path): \(error.localizedDescription)")
        }
    }

    private func pollChat(now: Date) {
        guard let container = chatContainer else { return }
        let messages = meetingApp.chatMessages(in: container)
        if messages.isEmpty && axChildren(container).isEmpty { chatContainer = nil }
        for message in messages {
            if !chatBaselineDone {
                seenChatIDs.insert(message.id)
                continue
            }
            guard !seenChatIDs.contains(message.id) else { continue }
            let sent = Double(message.id).map { Date(timeIntervalSince1970: $0 / 1000) } ?? now
            // Identity commits immediately: the AX list is virtualized and the
            // message can vanish at any moment. If writes are broken, emit
            // queues it onto the ordered backlog instead of losing it.
            seenChatIDs.insert(message.id)
            emit(
                kind: "chat",
                speaker: message.author,
                body: message.text,
                at: sent > startedAt ? sent : now,
                extra: ["message_id": message.id]
            )
        }
        if !messages.isEmpty { chatBaselineDone = true }
    }

    /// When an utterance finishes, Teams often replaces its node with a fresh
    /// one holding the same (or corrected) text. Without this, the utterance
    /// gets written twice: once when the old node goes, once when the new does.
    private func supersededByActive(_ utterance: Utterance, id: String) -> Bool {
        guard !meetingApp.hasStableIdentity(id) else { return false }
        return activeCaptions.contains { key, other in
            key != id && other.speaker == utterance.speaker && other.text.hasPrefix(utterance.text)
        }
    }

    private func alreadyWritten(_ utterance: Utterance, id: String, now: Date) -> Bool {
        guard !meetingApp.hasStableIdentity(id) else { return false }
        return written.contains {
            $0.speaker == utterance.speaker && $0.text == utterance.text
                && now.timeIntervalSince($0.at) < 30
        }
    }

    private func finalizeCaption(_ id: String, at date: Date) {
        guard let utterance = activeCaptions.removeValue(forKey: id) else { return }
        captionOrder.removeAll { $0 == id }
        finalized.insert(id)
        guard !utterance.text.isEmpty else { return }
        guard !supersededByActive(utterance, id: id), !alreadyWritten(utterance, id: id, now: date) else { return }
        // emit queues failed writes onto the ordered backlog, which finish()
        // drains before declaring loss — so committing dedup state here is
        // always safe.
        emit(
            kind: "caption",
            speaker: utterance.speaker,
            body: utterance.text,
            at: utterance.startedAt,
            extra: ["node_id": id, "ended_at": Recorder.isoFormatter.string(from: date)]
        )
        written.append((utterance.speaker, utterance.text, date))
        if written.count > 40 { written.removeFirst(written.count - 40) }
    }

    /// Flush in-flight captions and close out the transcript. Safe to call more
    /// than once (leave detection and process exit both do).
    func finish(at date: Date) {
        guard !finished else { return }
        finished = true
        live.erase()
        // Finalize every pending utterance. finalizeCaption hands failures to
        // the ordered backlog, and no poll follows a finish — so drain that
        // backlog here on a short bounded deadline before declaring loss.
        // The deadline is wall-clock NOW (or the injected test clock), not the
        // caller's meeting timestamp: endSession captures that date before
        // multi-second AX round-trips, and an already-expired deadline would
        // mean zero retries.
        let deadline = clock.now().addingTimeInterval(5)
        var drainNote: String?
        repeat {
            for id in captionOrder { finalizeCaption(id, at: date) }
            // Keep the last non-nil cause: a nil here means the deadline cut
            // the drain off, not that nothing failed.
            if let note = drainPendingWrites(until: deadline) { drainNote = note }
            if !captionOrder.isEmpty || !pendingWrites.isEmpty {
                sleepFn(250_000)
            }
        } while (!captionOrder.isEmpty || !pendingWrites.isEmpty) && clock.now() < deadline
        removeStateFile(options.stateDirectory + "/live")
        removeStateFile(options.stateDirectory + "/current")
        // Known data loss is always reported — even with no recorder at all
        // (nothing ever initialized), even under --quiet, even if the stopped
        // event itself fails to write.
        let lost = captionOrder.count + pendingWrites.count
        if lost > 0 {
            var message = "\(lost) item(s) of \"\(title)\" could not be written and are lost"
            if let note = drainNote {
                message += "\n  last failure: \(note)"
            } else {
                message += "\n  retry deadline expired before all remaining writes completed; earlier errors are logged above"
            }
            message += "\n  check free space and permissions for \(options.directory)"
            status(message)
        }
        guard let writer = recorder else { return }
        // A duration is time spent recording — not whatever the transcript
        // stamps happen to count from (Slack/Meet stamps are the time of day).
        let duration = elapsedString(from: startedAt, to: date)
        // Only claim "finished" if the stopped event landed; writeJSON has
        // already logged the failure otherwise. Loss (if any) was reported above.
        if writer.writeJSON([
            "type": "metadata",
            "event": "stopped",
            "stopped_at": Recorder.isoFormatter.string(from: date),
            "duration": duration,
            "lost_events": lost
        ]), !options.quiet {
            status("finished \"\(title)\" after \(duration)")
        }
    }
}

// MARK: - Single instance, and following someone else's transcript

/// Hold an exclusive lock for the lifetime of the process. Two capturers on one
/// meeting would write two transcripts of the same words.
func acquireLock(_ path: String) -> Int32? {
    let descriptor = open(path, O_CREAT | O_RDWR, 0o644)
    guard descriptor >= 0 else { return nil }
    guard flock(descriptor, LOCK_EX | LOCK_NB) == 0 else {
        close(descriptor)
        return nil
    }
    return descriptor
}

func newestTranscript(in directory: String) -> URL? {
    let url = URL(fileURLWithPath: directory, isDirectory: true)
    let keys: [URLResourceKey] = [.contentModificationDateKey]
    guard let entries = try? FileManager.default.contentsOfDirectory(
        at: url, includingPropertiesForKeys: keys) else { return nil }
    func modified(_ file: URL) -> Date {
        (try? file.resourceValues(forKeys: Set(keys)))?.contentModificationDate ?? .distantPast
    }
    return entries.filter { $0.pathExtension == "txt" }.max { modified($0) < modified($1) }
}

/// What became of reading a state/transcript file. `.absent` is normal while
/// idle — the pointer only exists during a meeting; swallowing anything else
/// would make --follow sit silent through real I/O trouble.
enum FileRead {
    case data(String)
    case absent
    case failed(Error)
}

/// Only genuine "the file is not there" counts as absent; everything else is
/// a real failure that callers must surface. NSFileReadUnknownError (=256) is a
/// GENERIC read failure — EIO, ESTALE, etc. all surface as 256 — so it only
/// counts as missing when the wrapped POSIX error is specifically ENOENT.
func isMissingFileError(_ error: NSError) -> Bool {
    guard error.domain == NSCocoaErrorDomain else { return posixENOENT(error) }
    switch error.code {
    case NSFileNoSuchFileError, NSFileReadNoSuchFileError:
        return true
    case NSFileReadUnknownError:
        return posixENOENT(error)
    default:
        return false
    }
}

private func posixENOENT(_ error: NSError) -> Bool {
    let underlying = error.userInfo[NSUnderlyingErrorKey] as? NSError ?? error
    return underlying.domain == NSPOSIXErrorDomain && underlying.code == Int(ENOENT)
}

func readFile(_ path: String) -> FileRead {
    do { return .data(try String(contentsOfFile: path, encoding: .utf8)) }
    catch let error as NSError where isMissingFileError(error) {
        return .absent
    }
    catch { return .failed(error) }
}

/// Remove a state file, tolerating only its absence; anything else is worth
/// hearing about, since a stale pointer sends --follow to a dead transcript.
func removeStateFile(_ path: String) {
    do { try FileManager.default.removeItem(atPath: path) }
    catch let error as NSError where isMissingFileError(error) {}
    catch { status("cannot remove \(path): \(error.localizedDescription)") }
}

/// Append whatever appeared past `offset` in a growing file to `sink`, and
/// return the offset to resume from. Existence is checked with a throwing
/// call (only genuine not-found counts as absent); seek and read use the
/// throwing FileHandle APIs so real I/O failures reach `warn`. `beforeWrite`
/// runs after bytes are in hand but before they are printed, so callers can
/// erase their live region first — permanent lines must not land under an
/// unterminated caption. Source failures leave the offset untouched (bytes
/// will be re-read next poll); SINK failures throw, because retrying a broken
/// output would either spin forever or duplicate the already-printed bytes.
func drainFileTail(_ path: String, from offset: UInt64, into sink: FileHandle,
                   beforeWrite: () -> Void, warn: (String) -> Void) throws -> UInt64 {
    do {
        _ = try FileManager.default.attributesOfItem(atPath: path)
    } catch let error as NSError where !isMissingFileError(error) {
        warn("cannot stat \(path): \(error.localizedDescription)")
        return offset
    } catch {
        return offset // absent: normal while idle
    }
    guard let handle = FileHandle(forReadingAtPath: path) else {
        warn("cannot open \(path)")
        return offset
    }
    defer { try? handle.close() } // closing is inconsequential; reading is not
    // Source reads: failures are retryable, so warn and leave the offset put.
    let data: Data
    do {
        try handle.seek(toOffset: offset)
        guard let read = try handle.readToEnd(), !read.isEmpty else { return offset }
        data = read
    } catch {
        warn("cannot tail \(path): \(error.localizedDescription)")
        return offset
    }
    beforeWrite()
    // The sink write happens outside the catch above on purpose: a broken
    // output would either spin forever or duplicate the printed bytes, so its
    // error propagates to the caller instead of being retried here.
    try sink.write(contentsOf: data)
    return offset + UInt64(data.count)
}

/// Tail the meeting the daemon is recording. Prefers the `current` pointer
/// (set when the first line is written) so we never reopen last week's Zoom
/// file. In-progress speech lives in `live` because the daemon is not a tty
/// and Teams does not write a line until it settles.
func followTranscripts(_ options: Options) {
    let stdout = FileHandle.standardOutput
    var current: URL?
    var offset: UInt64 = 0
    var lastLive = ""
    var liveRows = 0
    var lastScan = Date.distantPast
    var logOffset: UInt64 = 0
    let pointer = options.stateDirectory + "/current"
    let livePath = options.stateDirectory + "/live"
    let logURL = URL(fileURLWithPath: options.stateDirectory + "/launchd.log")
    if let attrs = try? FileManager.default.attributesOfItem(atPath: logURL.path),
       let size = attrs[.size] as? UInt64 {
        logOffset = size
    }
    if !options.quiet { status("following \(options.directory)") }
    // Real I/O trouble (permissions, a full disk) deserves a mention, but not
    // one per poll. Keyed by message so alternating failures each get through.
    var warnedAt: [String: Date] = [:]
    func warnThrottled(_ message: String) {
        let now = Date()
        if let at = warnedAt[message], now.timeIntervalSince(at) < 30 { return }
        warnedAt[message] = now
        status(message)
    }

    func eraseLive() {
        guard liveRows > 0, isatty(STDOUT_FILENO) == 1 else { liveRows = 0; return }
        var escape = "\r\u{1B}[2K"
        for _ in 1..<liveRows { escape += "\u{1B}[1A\u{1B}[2K" }
        stdout.write(Data(escape.utf8))
        liveRows = 0
    }

    while !stopRequested {
        let now = Date()
        if now.timeIntervalSince(lastScan) > 0.4 {
            lastScan = now
            switch readFile(pointer) {
            case .data(let path):
                let url = URL(fileURLWithPath: path.trimmingCharacters(in: .whitespacesAndNewlines))
                if url != current {
                    eraseLive()
                    current = url
                    offset = 0
                    if !options.quiet { status(url.lastPathComponent) }
                }
            case .absent:
                if current != nil {
                    eraseLive()
                    current = nil
                    offset = 0
                    lastLive = ""
                    if !options.quiet { status("waiting for the next meeting") }
                }
            case .failed(let error):
                warnThrottled("cannot read active-transcript pointer \(pointer): \(error.localizedDescription)")
            }
            do {
                logOffset = try drainFileTail(logURL.path, from: logOffset, into: stdout,
                    beforeWrite: { eraseLive(); lastLive = "" },
                    warn: warnThrottled)
            } catch {
                // The output stream itself broke (pipe closed, disk full);
                // retrying would spin forever or duplicate printed bytes.
                eraseLive()
                status("output failed; --follow cannot continue: \(error.localizedDescription)")
                exit(1)
            }
        }
        if let current {
            if FileManager.default.fileExists(atPath: current.path) {
                do {
                    offset = try drainFileTail(current.path, from: offset, into: stdout,
                        beforeWrite: {
                            eraseLive()
                            // redraw the live region under the new permanent lines
                            lastLive = ""
                        },
                        warn: warnThrottled)
                } catch {
                    eraseLive()
                    status("output failed; --follow cannot continue: \(error.localizedDescription)")
                    exit(1)
                }
            } else {
                warnThrottled("transcript \(current.path) has vanished")
            }
        }
        let liveText: String
        switch readFile(livePath) {
        case .data(let text): liveText = text
        case .absent: liveText = ""
        case .failed(let error):
            // Keep what is already drawn rather than flapping on every read.
            liveText = lastLive
            warnThrottled("cannot read \(livePath): \(error.localizedDescription)")
        }
        if liveText != lastLive {
            eraseLive()
            lastLive = liveText
            let rendered = LiveView.layout(
                liveText.trimmingCharacters(in: .newlines)
                    .split(separator: "\n", omittingEmptySubsequences: false)
                    .map(String.init)
            )
            if !rendered.isEmpty {
                stdout.write(Data(rendered.joined(separator: "\n").utf8))
                liveRows = rendered.count
            }
        }
        usleep(250_000)
    }
    eraseLive()
    // On the way out, say where the words went. The filename alone was shown
    // when the meeting started, which may be a long way up the scrollback.
    if let transcript = current ?? newestTranscript(in: options.directory) {
        var report = "transcript: \(transcript.path)"
        let json = transcript.deletingPathExtension().appendingPathExtension("jsonl")
        if FileManager.default.fileExists(atPath: json.path) { report += "\n  jsonl: \(json.path)" }
        stdout.write(Data("\n".utf8)) // stand the report off from the last thing said
        status(report)
    }
}

// The flag lives above the entry-point marker so it survives tests/run.sh's
// strip; followTranscripts polls it.
var stopRequested = false

// MARK: - Main

// Everything from here down is the daemon's entry point; tests/run.sh strips
// this section so the rest of the file compiles as a plain module.
signal(SIGINT) { _ in stopRequested = true }
signal(SIGTERM) { _ in stopRequested = true }

let options = parseOptions()
let live = LiveView(options: options)

if options.follow {
    followTranscripts(options)
    exit(0)
}

guard AXIsProcessTrusted() else {
    fail("no Accessibility permission — grant it in System Settings → Privacy & Security → Accessibility")
}

try? FileManager.default.createDirectory(
    atPath: options.stateDirectory, withIntermediateDirectories: true)
let lockDescriptor = acquireLock(options.stateDirectory + "/lock")
if lockDescriptor == nil {
    // Someone else is recording this meeting — show it rather than duplicate it.
    guard isatty(STDOUT_FILENO) == 1, !options.once else {
        fail("another meeting-capture is already recording")
    }
    status("another meeting-capture is already recording; following it instead")
    followTranscripts(options)
    exit(0)
}

let wanted: [MeetingApp] = {
    guard let name = options.app else { return supportedApps }
    guard let match = supportedApps.first(where: { $0.id == name }) else {
        fail("unknown app: \(name) (known: \(supportedApps.map(\.id).joined(separator: ", ")))")
    }
    return [match]
}()

func attach(_ meetingApp: MeetingApp, pid: pid_t) -> Attachment {
    let element = AXUIElementCreateApplication(pid)
    // Generous: a busy app can take seconds to answer, and a timed-out read is
    // indistinguishable from "the meeting ended".
    AXUIElementSetMessagingTimeout(element, 5.0)
    return Attachment(meetingApp: meetingApp, pid: pid, element: element)
}

/// Every wanted app that is currently running.
func runningApps() -> [Attachment] {
    wanted.compactMap { meetingApp in
        let pid: pid_t?
        if let forced = options.pid {
            pid = forced
        } else {
            switch queryProcess(matching: meetingApp.processPattern) {
            case .running(let found):
                pid = found
            case .notRunning:
                // Confirmed gone; nothing to attach to.
                pid = nil
            case .failed(let why):
                noteProcessLookupFailure("cannot look up \(meetingApp.displayName): \(why)")
                pid = nil
            }
        }
        return pid.map { attach(meetingApp, pid: $0) }
    }
}

var attachment: Attachment?
var session: Session?
var waker = TreeWaker(quiet: options.quiet)
var leaveMissingSince: Date?
var treeUnreadableSince: Date?

if options.once {
    // Attach to a meeting, not merely to a running app: an idle Teams must not
    // shadow an active Zoom. Web-view apps get woken here too, since a freshly
    // launched one looks like nothing at all until its tree fills in.
    var found: Attachment?
    for _ in 0..<20 {
        let now = Date()
        found = runningApps().filter { waker.ensureReadable($0, now: now) }
            .first { $0.meetingApp.meetingAnchor($0.element) != nil }
        if found != nil { break }
        usleep(500_000)
    }
    guard let found else {
        fail("no active meeting in \(wanted.map(\.displayName).joined(separator: ", "))")
    }
    attachment = found
    let anchor = found.meetingApp.meetingAnchor(found.element)
    session = Session(
        options: options,
        live: live,
        meetingApp: found.meetingApp,
        title: found.meetingApp.meetingTitle(found.element, anchor: anchor)
    )
} else if !options.quiet {
    status("watching for meetings in \(wanted.map(\.displayName).joined(separator: ", "))…")
}

var lastMeetingCheck = Date.distantPast
var lastUnreadableWarning = Date.distantPast
/// Apps last reported as "running, waiting for a meeting" — idle logs only
/// fire when this set changes, so an app sitting open all day stays silent.
var lastWaitingApps: [String] = []
var lastProcessWarning = Date.distantPast

while !stopRequested {
    let now = Date()

    // Scanning trees is expensive, and pointless several times a second:
    // joining and leaving are not that urgent.
    if !options.once && now.timeIntervalSince(lastMeetingCheck) >= 2 {
        lastMeetingCheck = now

        if session == nil {
            // Look for a call in any supported app, re-resolving pids as apps
            // are quit and reopened.
            let candidates = runningApps()
            // Drop wake bookkeeping for pids that no longer exist so app
            // restarts start fresh. LOAD-BEARING: the attached session's pid
            // rides along unconditionally — pgrep can miss it transiently, and
            // pruning its entry mid-hollow-period would reset the attempt
            // counts the "hollow for Ns" warnings count on.
            let alive = Set(candidates.map(\.pid)).union(attachment.map { [$0.pid] } ?? [])
            waker.prune(alive: alive)
            var unreadable: [String] = []
            var waiting: [String] = []
            for candidate in candidates {
                guard waker.ensureReadable(candidate, now: now) else {
                    unreadable.append(candidate.meetingApp.displayName)
                    continue
                }
                guard let anchor = candidate.meetingApp.meetingAnchor(candidate.element) else {
                    waiting.append(candidate.meetingApp.displayName)
                    continue
                }
                let title = candidate.meetingApp.meetingTitle(candidate.element, anchor: anchor)
                attachment = candidate
                session = Session(options: options, live: live, meetingApp: candidate.meetingApp, title: title)
                leaveMissingSince = nil
                if !options.quiet {
                    status("joined \"\(title)\" in \(candidate.meetingApp.displayName) (pid \(candidate.pid))")
                }
                break
            }
            if session == nil, !unreadable.isEmpty, now.timeIntervalSince(lastUnreadableWarning) > 60 {
                lastUnreadableWarning = now
                if !options.quiet {
                    status("cannot read the accessibility tree of \(unreadable.joined(separator: ", "))")
                }
            }
            if session == nil, !waiting.isEmpty, waiting != lastWaitingApps {
                // Transition log (app opened/quit/reopened), not a heartbeat:
                // a Slack idling all day would otherwise spam every 30s.
                lastWaitingApps = waiting
                if !options.quiet {
                    status("\(waiting.joined(separator: ", ")) is running, waiting for a meeting")
                }
            } else if session != nil || waiting.isEmpty {
                lastWaitingApps = []
            }
        } else if let current = attachment {
            func endSession(_ reason: String) {
                if !options.quiet { status("\(reason), ending session") }
                session?.finish(at: now)
                session = nil
                attachment = nil
                leaveMissingSince = nil
                treeUnreadableSince = nil
            }

            if let forced = options.pid {
                if forced != current.pid {
                    endSession("\(current.meetingApp.displayName) restarted")
                }
            } else {
                switch queryProcess(matching: current.meetingApp.processPattern) {
                case .running(let livePID):
                    // A new pid means a different instance entirely.
                    if livePID != current.pid {
                        endSession("\(current.meetingApp.displayName) restarted")
                    }
                case .notRunning:
                    // Quitting the app ends the meeting as surely as leaving does.
                    endSession("\(current.meetingApp.displayName) quit")
                case .failed(let why):
                    // The lookup itself failed; that says nothing about the app,
                    // and ending the session here would truncate an active meeting.
                    if now.timeIntervalSince(lastProcessWarning) > 60 {
                        lastProcessWarning = now
                        status("cannot tell whether \(current.meetingApp.displayName) is still running (\(why)); assuming it is")
                    }
                }
            }
            if session != nil && axChildren(current.element).isEmpty {
                // A failed read is not evidence that the call ended — but if it
                // never recovers we are stuck watching a tree that will never
                // answer, and would miss every later meeting.
                let since = treeUnreadableSince ?? now
                treeUnreadableSince = since
                if now.timeIntervalSince(since) > 30 {
                    endSession("lost the \(current.meetingApp.displayName) accessibility tree")
                } else if now.timeIntervalSince(lastUnreadableWarning) > 60 {
                    lastUnreadableWarning = now
                    if !options.quiet {
                        status("cannot read the \(current.meetingApp.displayName) accessibility tree")
                    }
                }
            } else if current.meetingApp.meetingAnchor(current.element) != nil {
                leaveMissingSince = nil
                treeUnreadableSince = nil
            } else {
                treeUnreadableSince = nil
                // Debounce: the Leave button vanishes during UI transitions.
                let missingSince = leaveMissingSince ?? now
                leaveMissingSince = missingSince
                if now.timeIntervalSince(missingSince) > 10 {
                    endSession("left \"\(session?.title ?? "")\"")
                }
            }
        }
    }

    if let active = session, let current = attachment {
        active.tick(app: current.element, pid: current.pid, now: now)
        usleep(options.intervalMs * 1000)
    } else {
        usleep(options.idleIntervalMs * 1000)
    }
}

session?.finish(at: Date())


