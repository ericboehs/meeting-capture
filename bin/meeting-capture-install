#!/usr/bin/env bash
# Install meeting-capture as a launchd agent that records every meeting.
#
# The script form runs under `swift`, which is awkward for TCC: Accessibility
# permission would have to be granted to the Swift compiler. So compile a real
# binary and grant permission to that.
#
# Not an .app bundle, tempting as the friendlier name in the Accessibility list
# is: TCC refuses an ad-hoc signed bundle ("failed to match existing code
# requirement") because it wants an Apple-anchored requirement. Bare binaries
# are matched by path, which ad-hoc signing satisfies.

set -euo pipefail

label="com.ericboehs.meeting-capture"
source_script="${BASH_SOURCE[0]%/*}/meeting-capture"
binary="$HOME/.local/bin/meeting-capture-daemon"
plist="$HOME/Library/LaunchAgents/$label.plist"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/meeting-capture"
stamp="$state_dir/source.sha256"
log="$state_dir/launchd.log"
cert_name="meeting-capture-signing"
# macOS ties an Accessibility grant to the binary's code signature. Ad-hoc
# signing re-hashes on every build, so each rebuild drops the permission. A
# stable identity keeps the grant: `signing-cert` below makes a self-signed one,
# and MEETING_CAPTURE_SIGN_ID overrides it (e.g. with a Developer ID).
#
# Prints every valid code-signing identity; returns nonzero when the keychain
# cannot be consulted at all (never treated as "no identities").
list_signing_identities() {
  local out rc=0
  out=$(security find-identity -v -p codesigning 2>&1) || rc=$?
  if [[ $rc -ne 0 ]]; then
    echo "error: cannot list code-signing identities (locked keychain?):" >&2
    echo "$out" >&2
    return "$rc"
  fi
  printf '%s' "$out"
}
# Tri-state contract: 0 = certificate exists, 1 = lookup succeeded and the
# certificate is absent, 2 = the keychain could not be consulted at all (never
# treated as "absent").
signing_cert_exists() {
  local identities rc=0
  identities=$(list_signing_identities) || rc=$?
  [[ $rc -ne 0 ]] && return 2
  grep -q "$cert_name" <<<"$identities"
}
find_sign_id() {
  if [[ -n ${MEETING_CAPTURE_SIGN_ID:-} ]]; then
    printf '%s' "$MEETING_CAPTURE_SIGN_ID"
    return
  fi
  local identities
  # A keychain that cannot be read is not the same as "no certificate".
  # Falling back to ad-hoc here would rebuild an already cert-signed binary
  # unsigned and silently drop the Accessibility grant — worse than stopping.
  if ! identities=$(list_signing_identities); then
    echo "fix keychain access or set MEETING_CAPTURE_SIGN_ID, then retry" >&2
    exit 1
  fi
  if grep -q "$cert_name" <<<"$identities"; then
    printf '%s' "$cert_name"
  else
    printf '%s' '-' # ad-hoc; only reached when lookup genuinely succeeded
  fi
}

settings_pane="x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility"

# Stop the agent and start it again.
#
# `launchctl bootout` returns before launchd has finished tearing the service
# down, so bootstrapping straight after it loses the race and fails with
# "Bootstrap failed: 5: Input/output error" — which leaves the daemon NOT
# RUNNING. That is the worst possible outcome for an installer whose whole job
# is shipping a fixed build to a live meeting, and it is silent unless you read
# the output. So wait for the label to actually leave the domain (bootout's own
# exit status says nothing about that; `launchctl print` does), then bootstrap,
# retrying a few times for whatever race is left.
restart_agent() { # restart_agent <domain> <label> <plist>
  local domain=$1 label=$2 plist=$3 attempt out=""
  launchctl bootout "$domain/$label" 2>/dev/null || true
  for ((attempt = 0; attempt < 50; attempt++)); do
    launchctl print "$domain/$label" >/dev/null 2>&1 || break
    sleep 0.2
  done
  for ((attempt = 1; attempt <= 5; attempt++)); do
    out=$(launchctl bootstrap "$domain" "$plist" 2>&1) && return 0
    sleep 1
  done
  echo "error: could not start $label after 5 attempts:" >&2
  echo "$out" >&2
  return 1
}

# Sourcing mode for the installer's test suite (tests/installer.sh): with this
# set, `source` defines the functions above and stops before any side effects.
# Tests stub `security` as a bash function to drive the tri-state contract.
if [[ -n ${MC_INSTALL_LIB_ONLY:-} ]]; then
  return 0 2>/dev/null || exit 0
fi

case "${1:-install}" in
  uninstall)
    launchctl bootout "gui/$UID/$label" 2>/dev/null || true
    rm -rf "$plist" "$binary" "$stamp"
    echo "removed $label"
    exit 0
    ;;
  reauthorize)
    launchctl bootout "gui/$UID/$label" 2>/dev/null || true
    open "$settings_pane"
    open -R "$binary"
    echo "remove any existing meeting-capture-daemon row, drag the revealed"
    echo "binary in, then:"
    echo "  launchctl bootstrap gui/$UID $plist"
    exit 0
    ;;
  signing-cert)
    # Deliberately tri-state: a broken keychain must not look like "no cert"
    # and trigger creating a duplicate identity.
    local_exists=0
    signing_cert_exists || local_exists=$?
    case $local_exists in
      0)
        echo "$cert_name already exists"
        exit 0
        ;;
      1) ;; # genuinely absent; create it below
      *) exit 1 ;; # lookup failed; diagnostics already printed
    esac
    # A self-signed code signing certificate, trusted for code signing only.
    # The point is a signature that stays the same across rebuilds, so the
    # Accessibility grant survives; it proves nothing to anyone else.
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    # Diagnostics are kept per step: a bare "exit 1" from set -e leaves no
    # hint whether OpenSSL is missing, too old for -addext, or out of entropy.
    openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
      -keyout "$tmp/key.pem" -out "$tmp/cert.pem" \
      -subj "/CN=$cert_name" \
      -addext "basicConstraints=critical,CA:false" \
      -addext "extendedKeyUsage=critical,codeSigning" \
      -addext "keyUsage=critical,digitalSignature" 2>"$tmp/req.err" || {
        echo "openssl could not generate the certificate (is OpenSSL >= 1.1 installed?):" >&2
        cat "$tmp/req.err" >&2
        exit 1
      }
    # Security.framework can't read OpenSSL 3's default PKCS#12 encryption, so
    # ask for the old algorithms. The passphrase only has to survive the import
    # on the next line.
    pass=$(openssl rand -hex 16)
    openssl pkcs12 -export -out "$tmp/id.p12" \
      -inkey "$tmp/key.pem" -in "$tmp/cert.pem" -passout "pass:$pass" \
      -keypbe PBE-SHA1-3DES -certpbe PBE-SHA1-3DES -macalg sha1 2>"$tmp/p12.err" || {
        echo "openssl could not export PKCS#12 (legacy algorithm support missing?):" >&2
        cat "$tmp/p12.err" >&2
        exit 1
      }

    keychain="$HOME/Library/Keychains/login.keychain-db"
    # -A/-T let codesign use the key without a prompt on every build.
    security import "$tmp/id.p12" -k "$keychain" -P "$pass" -A -T /usr/bin/codesign >/dev/null
    echo "macOS will ask for your login password to trust the certificate."
    security add-trusted-cert -r trustRoot -p codeSign -k "$keychain" "$tmp/cert.pem"

    echo "created $cert_name; rebuild to start using it:"
    echo "  ${BASH_SOURCE[0]}"
    exit 0
    ;;
  install) ;;
  *)
    echo "usage: ${0##*/} [install|reauthorize|signing-cert|uninstall]" >&2
    exit 1
    ;;
esac

# Only the install path needs a signing identity — resolving it here (not at
# the top of the script) keeps uninstall/reauthorize working with a broken or
# locked keychain.
sign_id=$(find_sign_id)

mkdir -p "${binary%/*}" "$state_dir"

# Only rebuild when something relevant changed — the source, or the signing
# identifier. The stamp carries both: after creating a certificate, an unchanged
# source still has to be rebuilt, or codesign never runs and the binary stays
# ad-hoc signed while everything above claims otherwise. Note it tracks the
# identity's NAME: rotating a certificate under the same name does not trigger
# a rebuild (remove $stamp by hand after rotating).
source_hash=$(shasum -a 256 "$source_script" | cut -d' ' -f1)
build_hash="$sign_id:$source_hash"
rebuilt=false
if [[ ! -x $binary || ! -f $stamp || $(cat "$stamp") != "$build_hash" ]]; then
  echo "building $binary"
  build_dir=$(mktemp -d)
  trap 'rm -rf "$build_dir"' EXIT
  cp "$source_script" "$build_dir/meeting-capture.swift"
  swiftc -O -o "$binary" "$build_dir/meeting-capture.swift"
  # No --identifier: giving a bare binary a bundle-style id makes TCC try to
  # resolve it as an app, fail to find one, and reject the grant.
  codesign --force --sign "$sign_id" "$binary"
  echo "$build_hash" > "$stamp"
  rebuilt=true
else
  echo "$binary is current, skipping build"
fi

cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$binary</string>
    <string>--auto-captions</string>
    <string>--popout-captions</string>
    <string>--popout-chat</string>
    <string>--people-snapshot</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>$HOME</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <!-- Not Background/LowPriorityIO: throttling starves the Accessibility
       round-trips until they time out, which looks like the meeting ended. -->
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>$log</string>
  <key>StandardErrorPath</key>
  <string>$log</string>
</dict>
</plist>
PLIST

restart_agent "gui/$UID" "$label" "$plist"

cat <<INFO

installed $label
  binary:      $binary
  plist:       $plist
  log:         $log
  transcripts: ${XDG_DATA_HOME:-$HOME/.local/share}/meeting-capture

  tail -f $log
INFO

if [[ $rebuilt == true && $sign_id == "-" ]]; then
  cat <<INFO

Ad-hoc signed, so macOS sees a new binary and drops any previous grant:
  ${BASH_SOURCE[0]} reauthorize

To stop re-granting after every rebuild, make a stable signing identity once:
  ${BASH_SOURCE[0]} signing-cert
INFO
elif [[ $rebuilt == true ]]; then
  echo
  echo "signed with $sign_id, so the Accessibility grant carries over"
fi
